// BGXUN1 v0.1.7 — separate selectable party script for EET / SCS 35.21 / Insane.
// New independent experimental pilot; never patches BDDEFAI, BGXGRP, BGXTANK.
// Capability checks use current spells / weapon / thief stats, not NPC names or portrait slots.
// REAL v0.1.3 pilot was installed and startup + FindTraps observed in EET. v0.1.4 was live-tested and FAILED to displace Imoen; v0.1.5 is unverified diagnostic.
// Existing BDAI local switches are read-only. The Advanced AI UI's availability while
// this custom script is selected has NOT been verified in the user's build.
// Optional opt-in LOCALS: BGXUCTRL=1 enables Blindness; BGXUDMG=1 enables Magic Missile.
// Independent opt-out LOCALS: BGXUNR=1 disables ranged; BGXUNM=1 disables melee.

// First pilot startup evidence; fires once when the new script is actually assigned and actions are idle.
IF
 ActionListEmpty()
 Global("BGXU010","LOCALS",0)
THEN
 RESPONSE #100
  SetGlobal("BGXU010","LOCALS",1)
  DisplayStringHead(Myself,~BGXUN1 V010 READY~)
END

// 0.1.4 marker. On SAVED GAME with BGXU010=1 this still confirms fresh updated BCS ran.
IF
 ActionListEmpty()
 Global("BGXU014","LOCALS",0)
THEN
 RESPONSE #100
  SetGlobal("BGXU014","LOCALS",1)
  DisplayStringHead(Myself,~BGXUN1 V014 SPACING~)
END

// V016 anti-idle correction after TWO real tests: V014 ran two steps without safety,
// V015 ran short steps then stood idle in contact (no retreat AND no attack).
// AttackOneRound terminates after one round; always permit a last-resort close shot.
// Never impose a hard cap on kite steps while the foe keeps pursuing: rate-limit them.
IF
 ActionListEmpty()
 Global("BGXU016","LOCALS",0)
THEN
 RESPONSE #100
  SetGlobal("BGXU016","LOCALS",1)
  DisplayStringHead(Myself,~BGXUN1 V016 NO-IDLE READY~)
END

// 0.1.7: only move from nearby enemies that actually attack THIS sprite.
// Range alone caused excessive retreat from the second hobgoblin while it fought a familiar.
IF
 ActionListEmpty()
 Global("BGXU017","LOCALS",0)
THEN
 RESPONSE #100
  SetGlobal("BGXU017","LOCALS",1)
  DisplayStringHead(Myself,~BGXUN1 V017 TARGET-AWARE~)
END

// CRITICAL: a wounded companion should continue to get away, not exhaust a 3-try
// budget and stand in place. This may override a manual order ONLY in emergency.
// The engine may be unable to path away; no guarantee of survival.
IF
 Global("BDAI_DISABLE_DEFENSIVE","LOCALS",0)
 Global("bd_ai_no_retreat","LOCALS",0)
 Global("bd_no_retreat","LOCALS",0)
 HPPercentLT(Myself,56)
 See(NearestEnemyOf(Myself))
 Range(NearestEnemyOf(Myself),6)
 AttackedBy(NearestEnemyOf(Myself),DEFAULT)
 !GlobalTimerNotExpired("BGXUER16","LOCALS")
THEN
 RESPONSE #100
  SetGlobalTimer("BGXUER16","LOCALS",6)
  DisplayStringHead(Myself,~BGXUN1 V016 CRITICAL ESCAPE~)
  RunAwayFromNoLeaveArea(NearestEnemyOf(Myself),35)
END

// Under fire: real incoming damage, moderately wounded, limited reissue.
IF
 Global("BDAI_DISABLE_DEFENSIVE","LOCALS",0)
 Global("bd_ai_no_retreat","LOCALS",0)
 Global("bd_no_retreat","LOCALS",0)
 HPPercentLT(Myself,76)
 HPPercentGT(Myself,55)
 TookDamage()
 See(NearestEnemyOf(Myself))
 Range(NearestEnemyOf(Myself),8)
 !GlobalTimerNotExpired("BGXUER16","LOCALS")
THEN
 RESPONSE #100
  SetGlobalTimer("BGXUER16","LOCALS",6)
  SetGlobalTimer("BGXUKW16","LOCALS",7)
  DisplayStringHead(Myself,~BGXUN1 V016 HIT EVADE~)
  RunAwayFromNoLeaveArea(NearestEnemyOf(Myself),35)
END

// Archer first chooses distance on an idle action queue. One 24-tick step, at
// most once each eight seconds; re-arm automatically, no 3-step hard lockout.
// No geometry-based retreat behind a designated tank yet; do not flee just because
// a nearby enemy is engaged with a familiar or tank.
IF
 ActionListEmpty()
 IsWeaponRanged(Myself)
 HPPercentGT(Myself,55)
 Global("BDAI_DISABLE_ATTACK","LOCALS",0)
 Global("BGXUNR","LOCALS",0)
 !Global("BDAI_ATTACK_MODE","LOCALS",1)
 Global("BDAI_DISABLE_DEFENSIVE","LOCALS",0)
 Global("bd_ai_no_retreat","LOCALS",0)
 Global("bd_no_retreat","LOCALS",0)
 !StateCheck(Myself,STATE_INVISIBLE)
 See(NearestEnemyOf(Myself))
 Range(NearestEnemyOf(Myself),6)
 AttackedBy(NearestEnemyOf(Myself),DEFAULT)
 !GlobalTimerNotExpired("BGXUKW16","LOCALS")
THEN
 RESPONSE #100
  SetGlobalTimer("BGXUKW16","LOCALS",8)
  DisplayStringHead(Myself,~BGXUN1 V016 KITE REQUEST~)
  RunAwayFromNoLeaveArea(NearestEnemyOf(Myself),24)
END

// No deadlock: if the close enemy still pursues while repositioning is cooling
// down, DO NOT prohibit attacks as v015 did. Fire for a single round, then
// check distance again. This is emergency damage even with close-range penalty.
IF
 ActionListEmpty()
 HPPercentGT(Myself,55)
 Global("BDAI_DISABLE_ATTACK","LOCALS",0)
 !StateCheck(Myself,STATE_INVISIBLE)
 See(NearestEnemyOf(Myself))
 Range(NearestEnemyOf(Myself),8)
 Global("BGXUNR","LOCALS",0)
 !Global("BDAI_ATTACK_MODE","LOCALS",1)
 IsWeaponRanged(Myself)
 Global("BGXUF016","LOCALS",0)
THEN
 RESPONSE #100
  SetGlobal("BGXUF016","LOCALS",1)
  DisplayStringHead(Myself,~BGXUN1 V016 CLOSE FIRE FALLBACK~)
  AttackOneRound(NearestEnemyOf(Myself))
END

// Self-heal: live divine spell is mandatory (works for valid dual/multi/respec).
// Never cast under immediate melee pressure. No consumables or bypassed spell costs.
IF
 ActionListEmpty()
 Global("BDAI_DISABLE_DEFENSIVE","LOCALS",0)
 HPPercentLT(Myself,40)
 !Range(NearestEnemyOf(Myself),8)
 HaveSpell(CLERIC_CURE_MEDIUM_WOUNDS)
 !GlobalTimerNotExpired("BGXUHL01","LOCALS")
THEN
 RESPONSE #100
  SetGlobalTimer("BGXUHL01","LOCALS",12)
  Spell(Myself,CLERIC_CURE_MEDIUM_WOUNDS)
END
IF
 ActionListEmpty()
 Global("BDAI_DISABLE_DEFENSIVE","LOCALS",0)
 HPPercentLT(Myself,40)
 !Range(NearestEnemyOf(Myself),8)
 HaveSpell(CLERIC_CURE_LIGHT_WOUNDS)
 !GlobalTimerNotExpired("BGXUHL01","LOCALS")
THEN
 RESPONSE #100
  SetGlobalTimer("BGXUHL01","LOCALS",12)
  Spell(Myself,CLERIC_CURE_LIGHT_WOUNDS)
END

// Save scarce protection for a wounded, actually threatened mage; no idle prebuff.
IF
 ActionListEmpty()
 Global("BDAI_DISABLE_DEFENSIVE","LOCALS",0)
 HPPercentLT(Myself,70)
 See(NearestEnemyOf(Myself))
 Range(NearestEnemyOf(Myself),12)
 !Range(NearestEnemyOf(Myself),5)
 HaveSpell(WIZARD_MIRROR_IMAGE)
 !GlobalTimerNotExpired("BGXUMI01","LOCALS")
THEN
 RESPONSE #100
  SetGlobalTimer("BGXUMI01","LOCALS",120)
  Spell(Myself,WIZARD_MIRROR_IMAGE)
END

// Two offensive actions are STRICTLY OPT-IN (default LOCALS 0), no crowd/AoE damage.
// No remote enemy counting or hidden-information reads: only a visible target and real wound.
IF
 ActionListEmpty()
 Global("BDAI_DISABLE_OFFENSIVE","LOCALS",0)
 Global("BGXUCTRL","LOCALS",1)
 HPPercentLT(Myself,80)
 See(NearestEnemyOf(Myself))
 Range(NearestEnemyOf(Myself),15)
 HaveSpell(WIZARD_BLINDNESS)
 !GlobalTimerNotExpired("BGXUCB01","LOCALS")
THEN
 RESPONSE #100
  SetGlobalTimer("BGXUCB01","LOCALS",60)
  Spell(NearestEnemyOf(Myself),WIZARD_BLINDNESS)
END
IF
 ActionListEmpty()
 Global("BDAI_DISABLE_OFFENSIVE","LOCALS",0)
 Global("BGXUDMG","LOCALS",1)
 HPPercentLT(Myself,70)
 See(NearestEnemyOf(Myself))
 Range(NearestEnemyOf(Myself),15)
 HaveSpell(WIZARD_MAGIC_MISSILE)
 !GlobalTimerNotExpired("BGXUCD01","LOCALS")
THEN
 RESPONSE #100
  SetGlobalTimer("BGXUCD01","LOCALS",40)
  Spell(NearestEnemyOf(Myself),WIZARD_MAGIC_MISSILE)
END

// Legacy skill-mode preference stays separate from weapon and magic permission.
// Trap sensing is passive while standing still; NO auto lockpick, disarm or movement.
IF
 ActionListEmpty()
 Global("BDAI_DISABLE_SPECIAL","LOCALS",0)
 Global("BDAI_SKILL_MODE","LOCALS",1)
 !ActuallyInCombat()
 !See(NearestEnemyOf(Myself))
 CheckStatGT(Myself,0,TRAPS)
 !ModalState(DETECTTRAPS)
 !StateCheck(Myself,STATE_INVISIBLE)
THEN
 RESPONSE #100
  FindTraps()
END

// Hide when selected by the player: never try while visible enemies or combat active.
IF
 ActionListEmpty()
 Global("BDAI_DISABLE_SPECIAL","LOCALS",0)
 Global("BDAI_SKILL_MODE","LOCALS",2)
 !ActuallyInCombat()
 !See(NearestEnemyOf(Myself))
 CheckStatGT(Myself,0,STEALTH)
 !StateCheck(Myself,STATE_INVISIBLE)
 !GlobalTimerNotExpired("BGXUHI01","LOCALS")
THEN
 RESPONSE #100
  SetGlobalTimer("BGXUHI01","LOCALS",18)
  Hide()
END

// Bard song: explicit existing skill mode only; no script guesses for other classes.
// This action is never issued during a manual action queue.
IF
 ActionListEmpty()
 Global("BDAI_DISABLE_SPECIAL","LOCALS",0)
 Global("BDAI_SKILL_MODE","LOCALS",3)
 Class(Myself,BARD)
 ActuallyInCombat()
 See(NearestEnemyOf(Myself))
 !GlobalTimerNotExpired("BGXUSO01","LOCALS")
THEN
 RESPONSE #100
  SetGlobalTimer("BGXUSO01","LOCALS",45)
  BattleSong()
END

// Low-cost ranged combat only with an ALREADY SELECTED ranged weapon.
// Never equip-swaps or runs across a trap. Sneaking / invisible actor is respected.
IF
 ActionListEmpty()
 HPPercentGT(Myself,55)
 Global("BDAI_DISABLE_ATTACK","LOCALS",0)
 !StateCheck(Myself,STATE_INVISIBLE)
 See(NearestEnemyOf(Myself))
 Range(NearestEnemyOf(Myself),18)
 Global("BGXUNR","LOCALS",0)
 !Global("BDAI_ATTACK_MODE","LOCALS",1)
 IsWeaponRanged(Myself)
THEN
 RESPONSE #100
  AttackOneRound(NearestEnemyOf(Myself))
END

// Melee fallback: only a nearby visible enemy, no automatic long-distance charge.
IF
 ActionListEmpty()
 HPPercentGT(Myself,55)
 Global("BDAI_DISABLE_ATTACK","LOCALS",0)
 !StateCheck(Myself,STATE_INVISIBLE)
 See(NearestEnemyOf(Myself))
 Range(NearestEnemyOf(Myself),4)
 Global("BGXUNM","LOCALS",0)
 !IsWeaponRanged(Myself)
THEN
 RESPONSE #100
  AttackOneRound(NearestEnemyOf(Myself))
END
