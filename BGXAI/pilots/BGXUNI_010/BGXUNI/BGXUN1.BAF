// BGXUN1 v0.1.5 — separate selectable party script for EET / SCS 35.21 / Insane.
// New independent experimental pilot; never patches BDDEFAI, BGXGRP, BGXTANK.
// Capability checks use current spells / weapon / thief stats, not NPC names or portrait slots.
// REAL v0.1.3 pilot was installed and startup + FindTraps observed in EET. v0.1.4 was live-tested and FAILED to displace Imoen; v0.1.5 is unverified diagnostic.
// Existing BDAI local switches are read-only. The Advanced AI UI's availability while
// this custom script is selected has NOT been verified in the user's build.
// Optional opt-in LOCALS: BGXUCTRL=1 enables Blindness; BGXUDMG=1 enables Magic Missile.
// Independent opt-out LOCALS: BGXUNR=1 disables ranged; BGXUNM=1 disables melee.

// First pilot startup evidence; fires once when the new script is actually assigned and actions are idle.
IF
 ActionListEmpty()
 Global("BGXU010","LOCALS",0)
THEN
 RESPONSE #100
  SetGlobal("BGXU010","LOCALS",1)
  DisplayStringHead(Myself,~BGXUN1 V010 READY~)
END

// 0.1.4 marker. On SAVED GAME with BGXU010=1 this still confirms fresh updated BCS ran.
IF
 ActionListEmpty()
 Global("BGXU014","LOCALS",0)
THEN
 RESPONSE #100
  SetGlobal("BGXU014","LOCALS",1)
  DisplayStringHead(Myself,~BGXUN1 V014 SPACING~)
END

// v0.1.5: safe-distance-first diagnostic build after real Imoen death.
// V014 SPACE 1/2 and 2/2 markers were printed BEFORE the run command, not proof of movement.
 // NEW version marker on already saved games.
IF
 ActionListEmpty()
 Global("BGXU015","LOCALS",0)
THEN
 RESPONSE #100
  SetGlobal("BGXU015","LOCALS",1)
  DisplayStringHead(Myself,~BGXUN1 V015 RANGE TEST~)
END

// 1) HARD SURVIVAL: emergency at below 56% with a visible adjacent foe.
// Reuse the limited three-try emergency idea from verified BGXGRP626.
// Critical emergency may override player orders: source attribution not yet available.
IF
 Global("BDAI_DISABLE_DEFENSIVE","LOCALS",0)
 Global("bd_ai_no_retreat","LOCALS",0)
 Global("bd_no_retreat","LOCALS",0)
 HPPercentLT(Myself,56)
 See(NearestEnemyOf(Myself))
 Range(NearestEnemyOf(Myself),8)
 Global("BGXUE15","LOCALS",0)
 !GlobalTimerNotExpired("BGXUER15","LOCALS")
THEN
 RESPONSE #100
  SetGlobal("BGXUE15","LOCALS",1)
  SetGlobalTimer("BGXUER15","LOCALS",9)
  SetGlobalTimer("BGXUKW15","LOCALS",9)
  SetGlobalTimer("BGXUPOST15","LOCALS",7)
  DisplayStringHead(Myself,~BGXUN1 V015 EMERGENCY 1/3 REQUEST~)
  RunAwayFromNoLeaveArea(NearestEnemyOf(Myself),75)
  DisplayStringHead(Myself,~BGXUN1 V015 EMERGENCY ACTION RETURNED~)
END
IF
 Global("BDAI_DISABLE_DEFENSIVE","LOCALS",0)
 Global("bd_ai_no_retreat","LOCALS",0)
 Global("bd_no_retreat","LOCALS",0)
 HPPercentLT(Myself,56)
 See(NearestEnemyOf(Myself))
 Range(NearestEnemyOf(Myself),8)
 Global("BGXUE15","LOCALS",1)
 !GlobalTimerNotExpired("BGXUER15","LOCALS")
THEN
 RESPONSE #100
  SetGlobal("BGXUE15","LOCALS",2)
  SetGlobalTimer("BGXUER15","LOCALS",9)
  SetGlobalTimer("BGXUKW15","LOCALS",9)
  SetGlobalTimer("BGXUPOST15","LOCALS",7)
  DisplayStringHead(Myself,~BGXUN1 V015 EMERGENCY 2/3 REQUEST~)
  RunAwayFromNoLeaveArea(NearestEnemyOf(Myself),75)
  DisplayStringHead(Myself,~BGXUN1 V015 EMERGENCY ACTION RETURNED~)
END
IF
 Global("BDAI_DISABLE_DEFENSIVE","LOCALS",0)
 Global("bd_ai_no_retreat","LOCALS",0)
 Global("bd_no_retreat","LOCALS",0)
 HPPercentLT(Myself,56)
 See(NearestEnemyOf(Myself))
 Range(NearestEnemyOf(Myself),8)
 Global("BGXUE15","LOCALS",2)
 !GlobalTimerNotExpired("BGXUER15","LOCALS")
THEN
 RESPONSE #100
  SetGlobal("BGXUE15","LOCALS",3)
  SetGlobalTimer("BGXUER15","LOCALS",9)
  SetGlobalTimer("BGXUKW15","LOCALS",9)
  SetGlobalTimer("BGXUPOST15","LOCALS",7)
  DisplayStringHead(Myself,~BGXUN1 V015 EMERGENCY 3/3 REQUEST~)
  RunAwayFromNoLeaveArea(NearestEnemyOf(Myself),75)
  DisplayStringHead(Myself,~BGXUN1 V015 EMERGENCY ACTION RETURNED~)
END

// 2) FIRST INCOMING HIT: at <76% HP, bail without waiting for <56%.
// Distinct cooldown prevents repeated override; do not force a path across hazards.
IF
 Global("BDAI_DISABLE_DEFENSIVE","LOCALS",0)
 Global("bd_ai_no_retreat","LOCALS",0)
 Global("bd_no_retreat","LOCALS",0)
 HPPercentLT(Myself,76)
 HPPercentGT(Myself,55)
 TookDamage()
 See(NearestEnemyOf(Myself))
 Range(NearestEnemyOf(Myself),8)
 Global("BGXUE15","LOCALS",0)
 !GlobalTimerNotExpired("BGXUER15","LOCALS")
THEN
 RESPONSE #100
  SetGlobal("BGXUE15","LOCALS",1)
  SetGlobalTimer("BGXUER15","LOCALS",8)
  SetGlobalTimer("BGXUKW15","LOCALS",7)
  SetGlobalTimer("BGXUPOST15","LOCALS",5)
  DisplayStringHead(Myself,~BGXUN1 V015 HIT RETREAT REQUEST~)
  RunAwayFromNoLeaveArea(NearestEnemyOf(Myself),60)
  DisplayStringHead(Myself,~BGXUN1 V015 HIT ACTION RETURNED~)
END

// 3) RANGED KITE BEFORE CONTACT: 8 units rather than late 4-unit collision.
// The prior 12 AI-tick steps were only ~0.8 seconds; increase to 45 (~3 sec).
// This still cannot guarantee separation if attacker is equally fast or path is blocked.
// Every KITE 'REQUEST' is issued before the action; 'ACTION RETURNED' is queued AFTER.
// A returned action is NOT proof of actual displacement. Confirm with BGX71 action=355.
IF
 ActionListEmpty()
 IsWeaponRanged(Myself)
 HPPercentGT(Myself,55)
 Global("BDAI_DISABLE_ATTACK","LOCALS",0)
 Global("BDAI_DISABLE_DEFENSIVE","LOCALS",0)
 Global("bd_ai_no_retreat","LOCALS",0)
 Global("bd_no_retreat","LOCALS",0)
 !StateCheck(Myself,STATE_INVISIBLE)
 See(NearestEnemyOf(Myself))
 Range(NearestEnemyOf(Myself),8)
 Global("BGXUSP15","LOCALS",0)
 !GlobalTimerNotExpired("BGXUKW15","LOCALS")
THEN
 RESPONSE #100
  SetGlobal("BGXUSP15","LOCALS",1)
  SetGlobalTimer("BGXUKW15","LOCALS",5)
  SetGlobalTimer("BGXUPOST15","LOCALS",4)
  DisplayStringHead(Myself,~BGXUN1 V015 KITE 1/3 REQUEST~)
  RunAwayFromNoLeaveArea(NearestEnemyOf(Myself),45)
  DisplayStringHead(Myself,~BGXUN1 V015 KITE 1/3 ACTION RETURNED~)
END
IF
 ActionListEmpty()
 IsWeaponRanged(Myself)
 HPPercentGT(Myself,55)
 Global("BDAI_DISABLE_ATTACK","LOCALS",0)
 Global("BDAI_DISABLE_DEFENSIVE","LOCALS",0)
 Global("bd_ai_no_retreat","LOCALS",0)
 Global("bd_no_retreat","LOCALS",0)
 !StateCheck(Myself,STATE_INVISIBLE)
 See(NearestEnemyOf(Myself))
 Range(NearestEnemyOf(Myself),8)
 Global("BGXUSP15","LOCALS",1)
 !GlobalTimerNotExpired("BGXUKW15","LOCALS")
THEN
 RESPONSE #100
  SetGlobal("BGXUSP15","LOCALS",2)
  SetGlobalTimer("BGXUKW15","LOCALS",5)
  SetGlobalTimer("BGXUPOST15","LOCALS",4)
  DisplayStringHead(Myself,~BGXUN1 V015 KITE 2/3 REQUEST~)
  RunAwayFromNoLeaveArea(NearestEnemyOf(Myself),45)
  DisplayStringHead(Myself,~BGXUN1 V015 KITE 2/3 ACTION RETURNED~)
END
IF
 ActionListEmpty()
 IsWeaponRanged(Myself)
 HPPercentGT(Myself,55)
 Global("BDAI_DISABLE_ATTACK","LOCALS",0)
 Global("BDAI_DISABLE_DEFENSIVE","LOCALS",0)
 Global("bd_ai_no_retreat","LOCALS",0)
 Global("bd_no_retreat","LOCALS",0)
 !StateCheck(Myself,STATE_INVISIBLE)
 See(NearestEnemyOf(Myself))
 Range(NearestEnemyOf(Myself),8)
 Global("BGXUSP15","LOCALS",2)
 !GlobalTimerNotExpired("BGXUKW15","LOCALS")
THEN
 RESPONSE #100
  SetGlobal("BGXUSP15","LOCALS",3)
  SetGlobalTimer("BGXUKW15","LOCALS",5)
  SetGlobalTimer("BGXUPOST15","LOCALS",4)
  DisplayStringHead(Myself,~BGXUN1 V015 KITE 3/3 REQUEST~)
  RunAwayFromNoLeaveArea(NearestEnemyOf(Myself),45)
  DisplayStringHead(Myself,~BGXUN1 V015 KITE 3/3 ACTION RETURNED~)
END

// If 3 kites were attempted while hostiles remain near, stop asking for attacks
// and tell the player that autonomous spacing has exhausted its trial budget.
IF
 ActionListEmpty()
 IsWeaponRanged(Myself)
 See(NearestEnemyOf(Myself))
 Range(NearestEnemyOf(Myself),8)
 Global("BGXUSP15","LOCALS",3)
 Global("BGXUHOLD15","LOCALS",0)
THEN
 RESPONSE #100
  SetGlobal("BGXUHOLD15","LOCALS",1)
  DisplayStringHead(Myself,~BGXUN1 V015 STILL THREATENED MANUAL HELP~)
END

// Re-arm kiting after the hostile is truly outside 12 units and cooldown expires.
IF
 ActionListEmpty()
 GlobalGT("BGXUSP15","LOCALS",0)
 !Range(NearestEnemyOf(Myself),12)
 !GlobalTimerNotExpired("BGXUKW15","LOCALS")
THEN
 RESPONSE #100
  SetGlobal("BGXUSP15","LOCALS",0)
  SetGlobal("BGXUHOLD15","LOCALS",0)
  Continue()
END

// Emergency budget resets only when healed and out of enemy sight.
IF
 ActionListEmpty()
 GlobalGT("BGXUE15","LOCALS",0)
 HPPercentGT(Myself,85)
 !See(NearestEnemyOf(Myself))
THEN
 RESPONSE #100
  SetGlobal("BGXUE15","LOCALS",0)
  Continue()
END

// Self-heal: live divine spell is mandatory (works for valid dual/multi/respec).
// Never cast under immediate melee pressure. No consumables or bypassed spell costs.
IF
 ActionListEmpty()
 Global("BDAI_DISABLE_DEFENSIVE","LOCALS",0)
 HPPercentLT(Myself,40)
 !Range(NearestEnemyOf(Myself),8)
 HaveSpell(CLERIC_CURE_MEDIUM_WOUNDS)
 !GlobalTimerNotExpired("BGXUHL01","LOCALS")
THEN
 RESPONSE #100
  SetGlobalTimer("BGXUHL01","LOCALS",12)
  Spell(Myself,CLERIC_CURE_MEDIUM_WOUNDS)
END
IF
 ActionListEmpty()
 Global("BDAI_DISABLE_DEFENSIVE","LOCALS",0)
 HPPercentLT(Myself,40)
 !Range(NearestEnemyOf(Myself),8)
 HaveSpell(CLERIC_CURE_LIGHT_WOUNDS)
 !GlobalTimerNotExpired("BGXUHL01","LOCALS")
THEN
 RESPONSE #100
  SetGlobalTimer("BGXUHL01","LOCALS",12)
  Spell(Myself,CLERIC_CURE_LIGHT_WOUNDS)
END

// Save scarce protection for a wounded, actually threatened mage; no idle prebuff.
IF
 ActionListEmpty()
 Global("BDAI_DISABLE_DEFENSIVE","LOCALS",0)
 HPPercentLT(Myself,70)
 See(NearestEnemyOf(Myself))
 Range(NearestEnemyOf(Myself),12)
 !Range(NearestEnemyOf(Myself),5)
 HaveSpell(WIZARD_MIRROR_IMAGE)
 !GlobalTimerNotExpired("BGXUMI01","LOCALS")
THEN
 RESPONSE #100
  SetGlobalTimer("BGXUMI01","LOCALS",120)
  Spell(Myself,WIZARD_MIRROR_IMAGE)
END

// Two offensive actions are STRICTLY OPT-IN (default LOCALS 0), no crowd/AoE damage.
// No remote enemy counting or hidden-information reads: only a visible target and real wound.
IF
 ActionListEmpty()
 Global("BDAI_DISABLE_OFFENSIVE","LOCALS",0)
 Global("BGXUCTRL","LOCALS",1)
 HPPercentLT(Myself,80)
 See(NearestEnemyOf(Myself))
 Range(NearestEnemyOf(Myself),15)
 HaveSpell(WIZARD_BLINDNESS)
 !GlobalTimerNotExpired("BGXUCB01","LOCALS")
THEN
 RESPONSE #100
  SetGlobalTimer("BGXUCB01","LOCALS",60)
  Spell(NearestEnemyOf(Myself),WIZARD_BLINDNESS)
END
IF
 ActionListEmpty()
 Global("BDAI_DISABLE_OFFENSIVE","LOCALS",0)
 Global("BGXUDMG","LOCALS",1)
 HPPercentLT(Myself,70)
 See(NearestEnemyOf(Myself))
 Range(NearestEnemyOf(Myself),15)
 HaveSpell(WIZARD_MAGIC_MISSILE)
 !GlobalTimerNotExpired("BGXUCD01","LOCALS")
THEN
 RESPONSE #100
  SetGlobalTimer("BGXUCD01","LOCALS",40)
  Spell(NearestEnemyOf(Myself),WIZARD_MAGIC_MISSILE)
END

// Legacy skill-mode preference stays separate from weapon and magic permission.
// Trap sensing is passive while standing still; NO auto lockpick, disarm or movement.
IF
 ActionListEmpty()
 Global("BDAI_DISABLE_SPECIAL","LOCALS",0)
 Global("BDAI_SKILL_MODE","LOCALS",1)
 !ActuallyInCombat()
 !See(NearestEnemyOf(Myself))
 CheckStatGT(Myself,0,TRAPS)
 !ModalState(DETECTTRAPS)
 !StateCheck(Myself,STATE_INVISIBLE)
THEN
 RESPONSE #100
  FindTraps()
END

// Hide when selected by the player: never try while visible enemies or combat active.
IF
 ActionListEmpty()
 Global("BDAI_DISABLE_SPECIAL","LOCALS",0)
 Global("BDAI_SKILL_MODE","LOCALS",2)
 !ActuallyInCombat()
 !See(NearestEnemyOf(Myself))
 CheckStatGT(Myself,0,STEALTH)
 !StateCheck(Myself,STATE_INVISIBLE)
 !GlobalTimerNotExpired("BGXUHI01","LOCALS")
THEN
 RESPONSE #100
  SetGlobalTimer("BGXUHI01","LOCALS",18)
  Hide()
END

// Bard song: explicit existing skill mode only; no script guesses for other classes.
// This action is never issued during a manual action queue.
IF
 ActionListEmpty()
 Global("BDAI_DISABLE_SPECIAL","LOCALS",0)
 Global("BDAI_SKILL_MODE","LOCALS",3)
 Class(Myself,BARD)
 ActuallyInCombat()
 See(NearestEnemyOf(Myself))
 !GlobalTimerNotExpired("BGXUSO01","LOCALS")
THEN
 RESPONSE #100
  SetGlobalTimer("BGXUSO01","LOCALS",45)
  BattleSong()
END

// Low-cost ranged combat only with an ALREADY SELECTED ranged weapon.
// Never equip-swaps or runs across a trap. Sneaking / invisible actor is respected.
IF
 ActionListEmpty()
 HPPercentGT(Myself,55)
 !GlobalTimerNotExpired("BGXUPOST15","LOCALS")
 Global("BDAI_DISABLE_ATTACK","LOCALS",0)
 !StateCheck(Myself,STATE_INVISIBLE)
 See(NearestEnemyOf(Myself))
 Range(NearestEnemyOf(Myself),18)
 !Range(NearestEnemyOf(Myself),8)
 Global("BGXUNR","LOCALS",0)
 !Global("BDAI_ATTACK_MODE","LOCALS",1)
 IsWeaponRanged(Myself)
THEN
 RESPONSE #100
  AttackOneRound(NearestEnemyOf(Myself))
END

// Melee fallback: only a nearby visible enemy, no automatic long-distance charge.
IF
 ActionListEmpty()
 HPPercentGT(Myself,55)
 !GlobalTimerNotExpired("BGXUPOST15","LOCALS")
 Global("BDAI_DISABLE_ATTACK","LOCALS",0)
 !StateCheck(Myself,STATE_INVISIBLE)
 See(NearestEnemyOf(Myself))
 Range(NearestEnemyOf(Myself),4)
 Global("BGXUNM","LOCALS",0)
 !IsWeaponRanged(Myself)
THEN
 RESPONSE #100
  AttackOneRound(NearestEnemyOf(Myself))
END
