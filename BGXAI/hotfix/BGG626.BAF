// BGXGRP v0.6.26 THREAT STATE / TARGET STABILITY (Player3 tank; Player4 support)
// First matching block wins. Continue() only after immediate state changes.
// Version stamp
IF
 Global("BGXVER26","LOCALS",0)
THEN
 RESPONSE #100
  SetGlobal("BGXVER26","LOCALS",1)
  DisplayStringHead(Myself,~BGXGRP626 ACTIVE~)
END
// CRITICAL: dangerously low HP, regardless of earlier state
IF
 !Global("BGXST26","LOCALS",2)
 HPPercentLT(Myself,42)
THEN
 RESPONSE #100
  SetGlobal("BGXST26","LOCALS",2)
  DisplayStringHead(Myself,~BGXGRP626 CRITICAL~)
  Continue()
END
// CRITICAL: multiple visible hostiles and fresh damage at sub-55% HP
IF
 !Global("BGXST26","LOCALS",2)
 HPPercentLT(Myself,55)
 TookDamage()
 NumCreatureGT([EVILCUTOFF],1)
THEN
 RESPONSE #100
  SetGlobal("BGXST26","LOCALS",2)
  DisplayStringHead(Myself,~BGXGRP626 MULTI-THREAT CRITICAL~)
  Continue()
END
// PRESSURED: actual damage when below 70%, not mere AttackedBy
IF
 OR(2)
 Global("BGXST26","LOCALS",0)
 Global("BGXST26","LOCALS",3)
 HPPercentLT(Myself,70)
 TookDamage()
THEN
 RESPONSE #100
  SetGlobal("BGXST26","LOCALS",1)
  DisplayStringHead(Myself,~BGXGRP626 PRESSURED~)
  Continue()
END
// PRESSURED: multiple visible enemies while already wounded
IF
 OR(2)
 Global("BGXST26","LOCALS",0)
 Global("BGXST26","LOCALS",3)
 HPPercentLT(Myself,75)
 NumCreatureGT([EVILCUTOFF],1)
THEN
 RESPONSE #100
  SetGlobal("BGXST26","LOCALS",1)
  DisplayStringHead(Myself,~BGXGRP626 OUTNUMBERED~)
  Continue()
END
// RECOVERY transition after leaving immediate threat, pressed
IF
 Global("BGXST26","LOCALS",1)
 !Range(NearestEnemyOf(Myself),10)
THEN
 RESPONSE #100
  SetGlobal("BGXST26","LOCALS",3)
  SetGlobalTimer("BGXSAFE26","LOCALS",4)
  Continue()
END
// RECOVERY transition after leaving immediate threat, critical
IF
 Global("BGXST26","LOCALS",2)
 !Range(NearestEnemyOf(Myself),10)
THEN
 RESPONSE #100
  SetGlobal("BGXST26","LOCALS",3)
  SetGlobalTimer("BGXSAFE26","LOCALS",5)
  Continue()
END
// Back to normal after recovering HP, without restarting action every tick
IF
 Global("BGXST26","LOCALS",3)
 HPPercentGT(Myself,79)
 !GlobalTimerNotExpired("BGXSAFE26","LOCALS")
THEN
 RESPONSE #100
  SetGlobal("BGXST26","LOCALS",0)
  Continue()
END
// Reset pressured state when health has recovered
IF
 Global("BGXST26","LOCALS",1)
 HPPercentGT(Myself,79)
 !TookDamage()
THEN
 RESPONSE #100
  SetGlobal("BGXST26","LOCALS",0)
  Continue()
END
// Reset finite evasion only after danger disappears and HP restored
IF
 GlobalGT("BGXESC26","LOCALS",0)
 HPPercentGT(Myself,84)
 !See(NearestEnemyOf(Myself))
THEN
 RESPONSE #100
  SetGlobal("BGXESC26","LOCALS",0)
  Continue()
END
// CRITICAL: ask for help ONLY while genuinely threatened and tank away
IF
 Global("BGXST26","LOCALS",2)
 HPPercentLT(Myself,42)
 See(NearestEnemyOf(Myself))
 Range(NearestEnemyOf(Myself),12)
 InMyArea(Player3)
 !Range(Player3,10)
 !GlobalTimerNotExpired("BGXHELP26","LOCALS")
THEN
 RESPONSE #100
  SetGlobalTimer("BGXHELP26","LOCALS",15)
  Help()
  DisplayStringHead(Myself,~BGXGRP626 EMERGENCY HELP~)
END
// CRITICAL escape 1/3, short recovery window
IF
 Global("BGXST26","LOCALS",2)
 See(NearestEnemyOf(Myself))
 Range(NearestEnemyOf(Myself),9)
 Global("BGXESC26","LOCALS",0)
 !GlobalTimerNotExpired("BGXESCWAIT26","LOCALS")
THEN
 RESPONSE #100
  SetGlobal("BGXESC26","LOCALS",1)
  SetGlobalTimer("BGXESCWAIT26","LOCALS",8)
  SetGlobalTimer("BGXSAFE26","LOCALS",5)
  DisplayStringHead(Myself,~BGXGRP626 CRITICAL EVADE 1/3~)
  RunAwayFromNoLeaveArea(NearestEnemyOf(Myself),60)
END
// CRITICAL escape 2/3
IF
 Global("BGXST26","LOCALS",2)
 See(NearestEnemyOf(Myself))
 Range(NearestEnemyOf(Myself),9)
 Global("BGXESC26","LOCALS",1)
 !GlobalTimerNotExpired("BGXESCWAIT26","LOCALS")
THEN
 RESPONSE #100
  SetGlobal("BGXESC26","LOCALS",2)
  SetGlobalTimer("BGXESCWAIT26","LOCALS",8)
  SetGlobalTimer("BGXSAFE26","LOCALS",5)
  DisplayStringHead(Myself,~BGXGRP626 CRITICAL EVADE 2/3~)
  RunAwayFromNoLeaveArea(NearestEnemyOf(Myself),60)
END
// CRITICAL escape 3/3
IF
 Global("BGXST26","LOCALS",2)
 See(NearestEnemyOf(Myself))
 Range(NearestEnemyOf(Myself),9)
 Global("BGXESC26","LOCALS",2)
 !GlobalTimerNotExpired("BGXESCWAIT26","LOCALS")
THEN
 RESPONSE #100
  SetGlobal("BGXESC26","LOCALS",3)
  SetGlobalTimer("BGXESCWAIT26","LOCALS",8)
  SetGlobalTimer("BGXSAFE26","LOCALS",5)
  DisplayStringHead(Myself,~BGXGRP626 CRITICAL EVADE 3/3~)
  RunAwayFromNoLeaveArea(NearestEnemyOf(Myself),60)
END
// PRESSURED: first actual new hit while close -> single finite retreat
IF
 Global("BGXST26","LOCALS",1)
 TookDamage()
 See(NearestEnemyOf(Myself))
 Range(NearestEnemyOf(Myself),9)
 Global("BGXESC26","LOCALS",0)
 !GlobalTimerNotExpired("BGXESCWAIT26","LOCALS")
THEN
 RESPONSE #100
  SetGlobal("BGXESC26","LOCALS",1)
  SetGlobalTimer("BGXESCWAIT26","LOCALS",8)
  SetGlobalTimer("BGXSAFE26","LOCALS",4)
  DisplayStringHead(Myself,~BGXGRP626 PRESSURED EVADE~)
  RunAwayFromNoLeaveArea(NearestEnemyOf(Myself),45)
END
// CRITICAL regroup to tank if far, not during the escape window
IF
 Global("BGXST26","LOCALS",2)
 InMyArea(Player3)
 !Range(Player3,11)
 See(NearestEnemyOf(Myself))
 Range(NearestEnemyOf(Myself),15)
 !GlobalTimerNotExpired("BGXSAFE26","LOCALS")
 !GlobalTimerNotExpired("BGXRET26","LOCALS")
THEN
 RESPONSE #100
  SetGlobalTimer("BGXRET26","LOCALS",8)
  DisplayStringHead(Myself,~BGXGRP626 CRITICAL TO TANK~)
  MoveToObject(Player3)
END
// Contact weapon switch ONLY if current weapon is ranged; resume ATTACK in same block
IF
 See(NearestEnemyOf(Myself))
 Range(NearestEnemyOf(Myself),8)
 IsWeaponRanged(Myself)
 !GlobalTimerNotExpired("BGXWPN26","LOCALS")
 !GlobalTimerNotExpired("BGXSAFE26","LOCALS")
THEN
 RESPONSE #100
  SetGlobalTimer("BGXWPN26","LOCALS",8)
  EquipMostDamagingMelee()
  DisplayStringHead(Myself,~BGXGRP626 CONTACT MELEE~)
  Attack(NearestEnemyOf(Myself))
END
// Healing moderate when far from threat and HP low
IF
 HPPercentLT(Myself,70)
 !Range(NearestEnemyOf(Myself),10)
 HaveSpell(CLERIC_CURE_MODERATE_WOUNDS)
 !GlobalTimerNotExpired("BGXHEAL26","LOCALS")
THEN
 RESPONSE #100
  SetGlobalTimer("BGXHEAL26","LOCALS",11)
  SetGlobalTimer("BGXSAFE26","LOCALS",5)
  DisplayStringHead(Myself,~BGXGRP626 RECOVER HEAL MODERATE~)
  Spell(Myself,CLERIC_CURE_MODERATE_WOUNDS)
END
// Healing light when farther than melee and no moderate heal available
IF
 HPPercentLT(Myself,65)
 !Range(NearestEnemyOf(Myself),10)
 HaveSpell(CLERIC_CURE_LIGHT_WOUNDS)
 !GlobalTimerNotExpired("BGXHEAL26","LOCALS")
THEN
 RESPONSE #100
  SetGlobalTimer("BGXHEAL26","LOCALS",11)
  SetGlobalTimer("BGXSAFE26","LOCALS",5)
  DisplayStringHead(Myself,~BGXGRP626 RECOVER HEAL LIGHT~)
  Spell(Myself,CLERIC_CURE_LIGHT_WOUNDS)
END
// Choose ready ranged option only when idle and at safe distance; resume combat
IF
 ActionListEmpty()
 See(NearestEnemyOf(Myself))
 !Range(NearestEnemyOf(Myself),11)
 Range(NearestEnemyOf(Myself),19)
 !IsWeaponRanged(Myself)
 CanEquipRanged()
 !GlobalTimerNotExpired("BGXWPN26","LOCALS")
 !GlobalTimerNotExpired("BGXSAFE26","LOCALS")
THEN
 RESPONSE #100
  SetGlobalTimer("BGXWPN26","LOCALS",8)
  EquipRanged()
  DisplayStringHead(Myself,~BGXGRP626 RANGED READY~)
  Attack(NearestEnemyOf(Myself))
END
// Sustained target lock: Attack only when idle, never periodically restart
IF
 ActionListEmpty()
 See(NearestEnemyOf(Myself))
 Range(NearestEnemyOf(Myself),18)
 !GlobalTimerNotExpired("BGXSAFE26","LOCALS")
THEN
 RESPONSE #100
  DisplayStringHead(Myself,~BGXGRP626 ENGAGE STABLE~)
  Attack(NearestEnemyOf(Myself))
END
