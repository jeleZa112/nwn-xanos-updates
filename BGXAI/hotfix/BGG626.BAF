// BGXGRP 0.6.26 six-character team support; no hard-coded Khalid/Jaheira, independent survival states
// Priority order: first matching block wins. No unconditional per-round attack restarts.
// Version stamp
IF
 Global("BGXVER26","LOCALS",0)
THEN
 RESPONSE #100
  SetGlobal("BGXVER26","LOCALS",1)
  DisplayStringHead(Myself,~BGXGRP626 SQUAD ACTIVE~)
END
// CRITICAL when very low HP and enemy in contact
IF
 !Global("BGXST26","LOCALS",2)
 HPPercentLT(Myself,40)
 See(NearestEnemyOf(Myself))
 Range(NearestEnemyOf(Myself),12)
THEN
 RESPONSE #100
  SetGlobal("BGXST26","LOCALS",2)
  DisplayStringHead(Myself,~BGXGRP626 CRITICAL~)
  Continue()
END
// CRITICAL if surrounded and wounded from recent actual damage
IF
 !Global("BGXST26","LOCALS",2)
 HPPercentLT(Myself,50)
 TookDamage()
 NumCreatureGT([EVILCUTOFF],1)
THEN
 RESPONSE #100
  SetGlobal("BGXST26","LOCALS",2)
  DisplayStringHead(Myself,~BGXGRP626 MULTI CRITICAL~)
  Continue()
END
// PRESSURED after taking actual damage while below 65 percent
IF
 OR(2)
 Global("BGXST26","LOCALS",0)
 Global("BGXST26","LOCALS",3)
 HPPercentLT(Myself,65)
 TookDamage()
THEN
 RESPONSE #100
  SetGlobal("BGXST26","LOCALS",1)
  DisplayStringHead(Myself,~BGXGRP626 PRESSURED~)
  Continue()
END
// Pressure off when no enemy in striking reach
IF
 Global("BGXST26","LOCALS",1)
 !Range(NearestEnemyOf(Myself),11)
THEN
 RESPONSE #100
  SetGlobal("BGXST26","LOCALS",3)
  SetGlobalTimer("BGXSAFE26","LOCALS",4)
  Continue()
END
// Critical passed into recovery when out of reach
IF
 Global("BGXST26","LOCALS",2)
 !Range(NearestEnemyOf(Myself),11)
THEN
 RESPONSE #100
  SetGlobal("BGXST26","LOCALS",3)
  SetGlobalTimer("BGXSAFE26","LOCALS",5)
  Continue()
END
// Recovery reverts to normal after healing
IF
 Global("BGXST26","LOCALS",3)
 HPPercentGT(Myself,79)
 !GlobalTimerNotExpired("BGXSAFE26","LOCALS")
THEN
 RESPONSE #100
  SetGlobal("BGXST26","LOCALS",0)
  Continue()
END
// Pressured and recovered HP resumes normal
IF
 Global("BGXST26","LOCALS",1)
 HPPercentGT(Myself,79)
THEN
 RESPONSE #100
  SetGlobal("BGXST26","LOCALS",0)
  Continue()
END
// Finite escape budget restored only outside enemy sight
IF
 GlobalGT("BGXESC26","LOCALS",0)
 HPPercentGT(Myself,84)
 !See(NearestEnemyOf(Myself))
THEN
 RESPONSE #100
  SetGlobal("BGXESC26","LOCALS",0)
  Continue()
END
// Emergency call to any tanks; nothing for one or two light hits
IF
 Global("BGXST26","LOCALS",2)
 HPPercentLT(Myself,35)
 See(NearestEnemyOf(Myself))
 Range(NearestEnemyOf(Myself),10)
 !GlobalTimerNotExpired("BGXHELP26","LOCALS")
THEN
 RESPONSE #100
  SetGlobalTimer("BGXHELP26","LOCALS",14)
  Help()
  DisplayStringHead(Myself,~BGXGRP626 SQUAD SOS~)
END
// Critical flee attempt 1/3; interrupts combat only in an emergency
IF
 Global("BGXST26","LOCALS",2)
 See(NearestEnemyOf(Myself))
 Range(NearestEnemyOf(Myself),9)
 Global("BGXESC26","LOCALS",0)
 !GlobalTimerNotExpired("BGXESCWAIT26","LOCALS")
THEN
 RESPONSE #100
  SetGlobal("BGXESC26","LOCALS",1)
  SetGlobalTimer("BGXESCWAIT26","LOCALS",8)
  SetGlobalTimer("BGXSAFE26","LOCALS",5)
  DisplayStringHead(Myself,~BGXGRP626 EVADE 1/3~)
  RunAwayFromNoLeaveArea(NearestEnemyOf(Myself),60)
END
// Critical flee attempt 2/3; interrupts combat only in an emergency
IF
 Global("BGXST26","LOCALS",2)
 See(NearestEnemyOf(Myself))
 Range(NearestEnemyOf(Myself),9)
 Global("BGXESC26","LOCALS",1)
 !GlobalTimerNotExpired("BGXESCWAIT26","LOCALS")
THEN
 RESPONSE #100
  SetGlobal("BGXESC26","LOCALS",2)
  SetGlobalTimer("BGXESCWAIT26","LOCALS",8)
  SetGlobalTimer("BGXSAFE26","LOCALS",5)
  DisplayStringHead(Myself,~BGXGRP626 EVADE 2/3~)
  RunAwayFromNoLeaveArea(NearestEnemyOf(Myself),60)
END
// Critical flee attempt 3/3; interrupts combat only in an emergency
IF
 Global("BGXST26","LOCALS",2)
 See(NearestEnemyOf(Myself))
 Range(NearestEnemyOf(Myself),9)
 Global("BGXESC26","LOCALS",2)
 !GlobalTimerNotExpired("BGXESCWAIT26","LOCALS")
THEN
 RESPONSE #100
  SetGlobal("BGXESC26","LOCALS",3)
  SetGlobalTimer("BGXESCWAIT26","LOCALS",8)
  SetGlobalTimer("BGXSAFE26","LOCALS",5)
  DisplayStringHead(Myself,~BGXGRP626 EVADE 3/3~)
  RunAwayFromNoLeaveArea(NearestEnemyOf(Myself),60)
END
// PRESSURED retreat only if a fresh hit lands at sub-55%; no flee on missed attack
IF
 Global("BGXST26","LOCALS",1)
 HPPercentLT(Myself,55)
 TookDamage()
 See(NearestEnemyOf(Myself))
 Range(NearestEnemyOf(Myself),9)
 Global("BGXESC26","LOCALS",0)
 !GlobalTimerNotExpired("BGXESCWAIT26","LOCALS")
THEN
 RESPONSE #100
  SetGlobal("BGXESC26","LOCALS",1)
  SetGlobalTimer("BGXESCWAIT26","LOCALS",8)
  SetGlobalTimer("BGXSAFE26","LOCALS",4)
  DisplayStringHead(Myself,~BGXGRP626 PRESSURE EVADE~)
  RunAwayFromNoLeaveArea(NearestEnemyOf(Myself),45)
END
// Melee weapon only if currently ranged; then attack, no idle gap
IF
 See(NearestEnemyOf(Myself))
 Range(NearestEnemyOf(Myself),8)
 IsWeaponRanged(Myself)
 !GlobalTimerNotExpired("BGXWPN26","LOCALS")
 !GlobalTimerNotExpired("BGXSAFE26","LOCALS")
THEN
 RESPONSE #100
  SetGlobalTimer("BGXWPN26","LOCALS",8)
  EquipMostDamagingMelee()
  DisplayStringHead(Myself,~BGXGRP626 CONTACT MELEE~)
  Attack(NearestEnemyOf(Myself))
END
// Recover with moderate heal if enemy not close
IF
 HPPercentLT(Myself,69)
 !Range(NearestEnemyOf(Myself),10)
 HaveSpell(CLERIC_CURE_MODERATE_WOUNDS)
 !GlobalTimerNotExpired("BGXHEAL26","LOCALS")
THEN
 RESPONSE #100
  SetGlobalTimer("BGXHEAL26","LOCALS",11)
  SetGlobalTimer("BGXSAFE26","LOCALS",5)
  DisplayStringHead(Myself,~BGXGRP626 HEAL MODERATE~)
  Spell(Myself,CLERIC_CURE_MODERATE_WOUNDS)
END
// Recover with light heal if enemy not close
IF
 HPPercentLT(Myself,61)
 !Range(NearestEnemyOf(Myself),10)
 HaveSpell(CLERIC_CURE_LIGHT_WOUNDS)
 !GlobalTimerNotExpired("BGXHEAL26","LOCALS")
THEN
 RESPONSE #100
  SetGlobalTimer("BGXHEAL26","LOCALS",11)
  SetGlobalTimer("BGXSAFE26","LOCALS",5)
  DisplayStringHead(Myself,~BGXGRP626 HEAL LIGHT~)
  Spell(Myself,CLERIC_CURE_LIGHT_WOUNDS)
END
// Switch to ranged only while idle and enemy outside melee
IF
 ActionListEmpty()
 See(NearestEnemyOf(Myself))
 !Range(NearestEnemyOf(Myself),11)
 Range(NearestEnemyOf(Myself),19)
 !IsWeaponRanged(Myself)
 CanEquipRanged()
 !GlobalTimerNotExpired("BGXWPN26","LOCALS")
 !GlobalTimerNotExpired("BGXSAFE26","LOCALS")
THEN
 RESPONSE #100
  SetGlobalTimer("BGXWPN26","LOCALS",8)
  EquipRanged()
  DisplayStringHead(Myself,~BGXGRP626 RANGED READY~)
  Attack(NearestEnemyOf(Myself))
END
// Normal stable attack issued only when idle; no automatic retarget on damage
IF
 ActionListEmpty()
 See(NearestEnemyOf(Myself))
 Range(NearestEnemyOf(Myself),18)
 !GlobalTimerNotExpired("BGXSAFE26","LOCALS")
THEN
 RESPONSE #100
  DisplayStringHead(Myself,~BGXGRP626 ATTACK STABLE~)
  Attack(NearestEnemyOf(Myself))
END
