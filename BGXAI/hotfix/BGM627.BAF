// DESIGN DRAFT — NOT RELEASED / NOT SAFE FOR MANIFEST. Fixed low-HP finisher thresholds are not difficulty-adaptive.
// Superseded by BGXAI/DESIGN_DIFFICULTY_ADAPTIVE_THREAT_RU_20261102.md. Replace with predicted burst+TTK before enabling.
// BGXMGF v0.6.27 — Mage Magic Missile finisher when idle; no interruption of casts
// New optional roles, not assigned to saved characters automatically.
// Finisher mage role ready
IF
 Global("BGXVER27","LOCALS",0)
THEN
 RESPONSE #100
  SetGlobal("BGXVER27","LOCALS",1)
  DisplayStringHead(Myself,~BGXMGF627 MAGE FINISHER ACTIVE~)
END
// Self preservation takes precedence over minor low HP enemy
IF
 HPPercentLT(Myself,32)
 See(NearestEnemyOf(Myself))
 Range(NearestEnemyOf(Myself),7)
 !GlobalTimerNotExpired("BGXFLM27","LOCALS")
THEN
 RESPONSE #100
  SetGlobalTimer("BGXFLM27","LOCALS",10)
  RunAwayFromNoLeaveArea(NearestEnemyOf(Myself),45)
END
// MAGIC MISSILE FINISH: only when idle; don't interrupt manually cast spells. Ally 1
IF
 ActionListEmpty()
 InParty(PartySlot1)
 InMyArea(PartySlot1)
 See(LastAttackerOf(PartySlot1))
 Range(LastAttackerOf(PartySlot1),22)
 HPLT(LastAttackerOf(PartySlot1),11)
 HPPercentLT(LastAttackerOf(PartySlot1),26)
 HaveSpell(WIZARD_MAGIC_MISSILE)
 !GlobalTimerNotExpired("BGXKILL27","LOCALS")
THEN
 RESPONSE #100
  SetGlobalTimer("BGXKILL27","LOCALS",11)
  DisplayStringHead(Myself,~BGXMGF627 FINISH P1~)
  Spell(LastAttackerOf(PartySlot1),WIZARD_MAGIC_MISSILE)
END
