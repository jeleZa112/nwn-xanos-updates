// Mage finisher idle ranged weapon setup
IF
 ActionListEmpty()
 See(NearestEnemyOf(Myself))
 !IsWeaponRanged(Myself)
 CanEquipRanged()
THEN
 RESPONSE #100
  EquipRanged()
END
// Mage finisher conserve spell slots for near-death physical target; ordinary attack once when idle
IF
 ActionListEmpty()
 See(NearestEnemyOf(Myself))
 Range(NearestEnemyOf(Myself),23)
THEN
 RESPONSE #100
  Attack(NearestEnemyOf(Myself))
END
