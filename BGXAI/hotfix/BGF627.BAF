// NEAR ALLY FALLBACK: wounded enemy in melee range of ally 1; no evidence of actual aggro, prioritise by proximity and low HP
IF
 InParty(PartySlot1)
 InMyArea(PartySlot1)
 Range(PartySlot1,22)
 See(NearestEnemyOf(PartySlot1))
 Range(NearestEnemyOf(PartySlot1),20)
 Range(PartySlot1,15)
 HPLT(NearestEnemyOf(PartySlot1),13)
 HPPercentLT(NearestEnemyOf(PartySlot1),26)
 IsWeaponRanged(Myself)
 !GlobalTimerNotExpired("BGXKILL27","LOCALS")
THEN
 RESPONSE #100
  SetGlobalTimer("BGXKILL27","LOCALS",9)
  DisplayStringHead(Myself,~BGXFIN627 LOW ENEMY P1~)
  Attack(NearestEnemyOf(PartySlot1))
END
