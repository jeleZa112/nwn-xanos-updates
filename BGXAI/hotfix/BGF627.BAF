// DESIGN DRAFT — NOT RELEASED / NOT SAFE FOR MANIFEST. Fixed low-HP finisher thresholds are not difficulty-adaptive.
// Superseded by BGXAI/DESIGN_DIFFICULTY_ADAPTIVE_THREAT_RU_20261102.md. Replace with predicted burst+TTK before enabling.
// BGXFIN v0.6.27 — dedicated ranged opportunistic finisher, 6 allies
// New optional roles, not assigned to saved characters automatically.
// Finisher bow ready; first-time activation
IF
 Global("BGXVER27","LOCALS",0)
THEN
 RESPONSE #100
  SetGlobal("BGXVER27","LOCALS",1)
  DisplayStringHead(Myself,~BGXFIN627 RANGED FINISHER ACTIVE~)
END
// Retreat only when truly endangered
IF
 HPPercentLT(Myself,38)
 See(NearestEnemyOf(Myself))
 Range(NearestEnemyOf(Myself),6)
 !GlobalTimerNotExpired("BGXFLEE27","LOCALS")
THEN
 RESPONSE #100
  SetGlobalTimer("BGXFLEE27","LOCALS",10)
  RunAwayFromNoLeaveArea(NearestEnemyOf(Myself),45)
END
// Prepare ranged option when idle, do not change during a shot
IF
 ActionListEmpty()
 See(NearestEnemyOf(Myself))
 !IsWeaponRanged(Myself)
 CanEquipRanged()
THEN
 RESPONSE #100
  EquipRanged()
  DisplayStringHead(Myself,~BGXFIN627 READY~)
END
// RANGED FINISH: close to dead enemy that actually damaged party slot 1; 9 second switch limit
IF
 InParty(PartySlot1)
 InMyArea(PartySlot1)
 See(LastAttackerOf(PartySlot1))
 Range(LastAttackerOf(PartySlot1),24)
 HPLT(LastAttackerOf(PartySlot1),17)
 HPPercentLT(LastAttackerOf(PartySlot1),31)
 IsWeaponRanged(Myself)
 !GlobalTimerNotExpired("BGXKILL27","LOCALS")
THEN
 RESPONSE #100
  SetGlobalTimer("BGXKILL27","LOCALS",9)
  DisplayStringHead(Myself,~BGXFIN627 FINISH P1~)
  Attack(LastAttackerOf(PartySlot1))
END
