// Ranged finisher normal behaviour — maintain current enemy until defeated
IF
 ActionListEmpty()
 See(NearestEnemyOf(Myself))
 Range(NearestEnemyOf(Myself),24)
THEN
 RESPONSE #100
  Attack(NearestEnemyOf(Myself))
END
