// 2026-11-03 EET/SCS 35.21 / Insane | STAGING ONLY: requires WeiDU compilation + local game tests
// Do NOT activate or select: this is not a compiled game script.
// No fixed companion names, kit IDs or portrait slots.

// BGS002: BGXSCOUT v0.2 - cautious sneak melee/ranged fighter-thief role
IF
 Global("BGXSV02","LOCALS",0)
THEN
 RESPONSE #100
  SetGlobal("BGXSV02","LOCALS",1)
  DisplayStringHead(Myself,~BGXSCOUT V02~)
END

// Cautious retreat while badly wounded and an enemy is within striking reach
IF
 ActionListEmpty()
 See(NearestEnemyOf(Myself))
 Range(NearestEnemyOf(Myself),6)
 HPPercentLT(Myself,45)
 Global("BGXSE02","LOCALS",0)
THEN
 RESPONSE #100
  SetGlobal("BGXSE02","LOCALS",1)
  RunAwayFromNoLeaveArea(NearestEnemyOf(Myself),55)
END
IF
 Global("BGXSE02","LOCALS",1)
 HPPercentGT(Myself,84)
 !ActuallyInCombat()
 !See(NearestEnemyOf(Myself))
THEN
 RESPONSE #100
  SetGlobal("BGXSE02","LOCALS",0)
  Continue()
END

// If already hidden, never issue autonomous attacks that would expose scouting.
IF
 ActionListEmpty()
 !ActuallyInCombat()
 !See(NearestEnemyOf(Myself))
 CheckStatGT(Myself,0,STEALTH)
 !StateCheck(Myself,STATE_INVISIBLE)
 !GlobalTimerNotExpired("BGXSH02","LOCALS")
THEN
 RESPONSE #100
  SetGlobalTimer("BGXSH02","LOCALS",12)
  Hide()
END

// In combat, attack distant enemies only if ranged gear already selected.
// This avoids unsafe weapon-swapping loops and does not waste sneak approach.
IF
 ActionListEmpty()
 See(NearestEnemyOf(Myself))
 Range(NearestEnemyOf(Myself),18)
 IsWeaponRanged(Myself)
THEN
 RESPONSE #100
  Attack(NearestEnemyOf(Myself))
END

// Defend against an adjacent attacker with selected melee weapon,
// but do not initiate a long pathfinding charge or break stealth.
IF
 ActionListEmpty()
 See(NearestEnemyOf(Myself))
 Range(NearestEnemyOf(Myself),4)
 HPPercentGT(Myself,54)
 !IsWeaponRanged(Myself)
 !StateCheck(Myself,STATE_INVISIBLE)
THEN
 RESPONSE #100
  Attack(NearestEnemyOf(Myself))
END
