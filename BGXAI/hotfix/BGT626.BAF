// BGXTANK 0.6.26 six portrait slots, multiple protectees, per-slot GLOBAL rescue claim for two tanks
// Priority order: first matching block wins. No unconditional per-round attack restarts.
// Version stamp; same BGXTANK script may be assigned to two or more party tanks
IF
 Global("BGXVER26","LOCALS",0)
THEN
 RESPONSE #100
  SetGlobal("BGXVER26","LOCALS",1)
  DisplayStringHead(Myself,~BGXTANK626 SQUAD ACTIVE~)
END
// Emergency override: PartySlot1 <20% HP, one tank claims this victim and may drop its target
IF
 HPPercentLT(PartySlot1,20)
 InParty(PartySlot1)
 InMyArea(PartySlot1)
 !Range(PartySlot1,2)
 See(LastAttackerOf(PartySlot1))
 Range(LastAttackerOf(PartySlot1),22)
 !GlobalTimerNotExpired("BGXCL126","GLOBAL")
 !GlobalTimerNotExpired("BGXURG26","LOCALS")
THEN
 RESPONSE #100
  SetGlobalTimer("BGXCL126","GLOBAL",12)
  SetGlobalTimer("BGXURG26","LOCALS",8)
  DisplayStringHead(Myself,~BGXTANK626 URGENT P1~)
  Attack(LastAttackerOf(PartySlot1))
END
