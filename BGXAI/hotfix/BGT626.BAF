// Switch from ranged to melee once on contact, resume own target
IF
 See(NearestEnemyOf(Myself))
 Range(NearestEnemyOf(Myself),14)
 IsWeaponRanged(Myself)
 !GlobalTimerNotExpired("BGXWPN26","LOCALS")
THEN
 RESPONSE #100
  SetGlobalTimer("BGXWPN26","LOCALS",9)
  EquipMostDamagingMelee()
  DisplayStringHead(Myself,~BGXTANK626 MELEE AND ENGAGE~)
  Attack(NearestEnemyOf(Myself))
END
// Keep chosen current target unless critical party emergency; start a new attack only when idle
IF
 ActionListEmpty()
 See(NearestEnemyOf(Myself))
THEN
 RESPONSE #100
  DisplayStringHead(Myself,~BGXTANK626 ACQUIRE ONCE~)
  Attack(NearestEnemyOf(Myself))
END
