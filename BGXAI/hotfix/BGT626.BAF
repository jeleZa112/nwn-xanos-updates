// Idle tank regroups with PartySlot1 near death when the attacker is out of sight
IF
 ActionListEmpty()
 HPPercentLT(PartySlot1,20)
 InParty(PartySlot1)
 InMyArea(PartySlot1)
 !Range(PartySlot1,10)
 !See(NearestEnemyOf(Myself))
 !GlobalTimerNotExpired("BGXCL126","GLOBAL")
THEN
 RESPONSE #100
  SetGlobalTimer("BGXCL126","GLOBAL",12)
  DisplayStringHead(Myself,~BGXTANK626 RALLY P1~)
  MoveToObject(PartySlot1)
END
