// Idle tank helps PartySlot1 in danger; a busy tank retains its current target
IF
 ActionListEmpty()
 HPPercentLT(PartySlot1,38)
 OR(2)
 Help(PartySlot1)
 HPPercentLT(PartySlot1,26)
 InParty(PartySlot1)
 InMyArea(PartySlot1)
 !Range(PartySlot1,2)
 See(LastAttackerOf(PartySlot1))
 Range(LastAttackerOf(PartySlot1),22)
 !GlobalTimerNotExpired("BGXCL126","GLOBAL")
THEN
 RESPONSE #100
  SetGlobalTimer("BGXCL126","GLOBAL",14)
  DisplayStringHead(Myself,~BGXTANK626 FREE RESCUE P1~)
  Attack(LastAttackerOf(PartySlot1))
END
