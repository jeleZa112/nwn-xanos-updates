// BGXGRP 0.6.17 recover hotfix: keep retreat priority, prevent dead-end after heal.
IF
 Global("BGXMODE","LOCALS",0)
 OR(2)
  HPPercentLT(Myself,65)
  Range(NearestEnemyOf(Myself),6)
 See(NearestEnemyOf(Myself))
THEN
 RESPONSE #100
  SetGlobal("BGXMODE","LOCALS",1)
  ClearActions(Myself)
  DisplayStringHead(Myself,~BGXGRP617 RETREAT PRIORITY~)
END
IF
 Global("BGXMODE","LOCALS",1)
 IsWeaponRanged(Myself)
 See(NearestEnemyOf(Myself))
 Range(NearestEnemyOf(Myself),5)
THEN
 RESPONSE #100
  EquipMostDamagingMelee()
END
IF
 Global("BGXMODE","LOCALS",1)
 ActionListEmpty()
 See(NearestEnemyOf(Myself))
 Range(NearestEnemyOf(Myself),15)
THEN
 RESPONSE #100
  RunAwayFromNoLeaveArea(NearestEnemyOf(Myself),75)
  DisplayStringHead(Myself,~BGXGRP617 FLEE PURSUER~)
END
IF
 Global("BGXMODE","LOCALS",1)
 ActionListEmpty()
 !Range(NearestEnemyOf(Myself),15)
THEN
 RESPONSE #100
  SetGlobal("BGXMODE","LOCALS",2)
  DisplayStringHead(Myself,~BGXGRP617 RECOVER~)
END
IF
 Global("BGXMODE","LOCALS",2)
 See(NearestEnemyOf(Myself))
 Range(NearestEnemyOf(Myself),10)
THEN
 RESPONSE #100
  SetGlobal("BGXMODE","LOCALS",1)
  ClearActions(Myself)
END
IF
 Global("BGXMODE","LOCALS",2)
 ActionListEmpty()
 !Range(NearestEnemyOf(Myself),10)
 HPPercentLT(Myself,78)
 HaveSpell(CLERIC_CURE_MODERATE_WOUNDS)
 !GlobalTimerNotExpired("BGXHEAL","LOCALS")
THEN
 RESPONSE #100
  SetGlobalTimer("BGXHEAL","LOCALS",4)
  Spell(Myself,CLERIC_CURE_MODERATE_WOUNDS)
  DisplayStringHead(Myself,~BGXGRP617 HEAL MODERATE~)
END
IF
 Global("BGXMODE","LOCALS",2)
 ActionListEmpty()
 !Range(NearestEnemyOf(Myself),10)
 HPPercentLT(Myself,78)
 HaveSpell(CLERIC_CURE_LIGHT_WOUNDS)
 !GlobalTimerNotExpired("BGXHEAL","LOCALS")
THEN
 RESPONSE #100
  SetGlobalTimer("BGXHEAL","LOCALS",4)
  Spell(Myself,CLERIC_CURE_LIGHT_WOUNDS)
  DisplayStringHead(Myself,~BGXGRP617 HEAL LIGHT~)
END
// Recovery must not get trapped waiting for healing spells or an out-of-range enemy.
IF
 Global("BGXMODE","LOCALS",2)
 ActionListEmpty()
 !Range(NearestEnemyOf(Myself),12)
 OR(3)
  HPPercentGT(Myself,77)
  !HaveSpell(CLERIC_CURE_LIGHT_WOUNDS)
  !HaveSpell(CLERIC_CURE_MODERATE_WOUNDS)
THEN
 RESPONSE #100
  SetGlobal("BGXMODE","LOCALS",0)
  DisplayStringHead(Myself,~BGXGRP617 RECOVERY COMPLETE~)
END
// In combat mode, acquire ranged if enemy is not in immediate contact.
IF
 Global("BGXMODE","LOCALS",0)
 ActionListEmpty()
 See(NearestEnemyOf(Myself))
 !Range(NearestEnemyOf(Myself),10)
 !IsWeaponRanged(Myself)
THEN
 RESPONSE #100
  EquipRanged()
  DisplayStringHead(Myself,~BGXGRP617 RANGED REQUEST~)
END
IF
 Global("BGXMODE","LOCALS",0)
 ActionListEmpty()
 See(NearestEnemyOf(Myself))
 !Range(NearestEnemyOf(Myself),10)
 !StateCheck(Myself,STATE_INVISIBLE)
THEN
 RESPONSE #100
  AttackOneRound(NearestEnemyOf(Myself))
END
