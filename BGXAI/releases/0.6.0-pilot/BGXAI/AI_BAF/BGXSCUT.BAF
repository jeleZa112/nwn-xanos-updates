// BGXSCUT - scout when idle, attack if enemy becomes visible.
// Use only on a character with a real traps skill (including some hybrids).
IF
  ActionListEmpty()
  CombatCounter(0)
  CheckStatGT(Myself,0,TRAPS)
  !ModalState(DETECTTRAPS)
  !See(NearestEnemyOf(Myself))
THEN
  RESPONSE #100
    FindTraps()
END
IF
  ActionListEmpty()
  !StateCheck(Myself,STATE_INVISIBLE)
  See(NearestEnemyOf(Myself))
THEN
  RESPONSE #100
    AttackOneRound(NearestEnemyOf(Myself))
END