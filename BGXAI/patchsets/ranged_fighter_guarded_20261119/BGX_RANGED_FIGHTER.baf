// BGXAI ranged fighter pilot; opt-in by existing F guard; only already selected ranged weapon.
// Only fighter class: does not compete with priest and druid healing.
// No auto weapon switches, no movement command, no AoE casting.
IF
  InParty(Myself)
  !InPartySlot(Myself,0)
  Class(Myself,FIGHTER)
  Global("BGX38_GUARD","LOCALS",1)
  Global("BGX66_S_HEAL_SLOT","LOCALS",0)
  ActionListEmpty()
  ModalState(NONE)
  !StateCheck(Myself,STATE_PANIC)
  !StateCheck(Myself,STATE_HELPLESS)
  HPPercentGT(Myself,75)
  IsWeaponRanged(Myself)
  !InParty(NearestEnemyOf(Myself))
  See(NearestEnemyOf(Myself))
  InWeaponRange(NearestEnemyOf(Myself))
  !Range(NearestEnemyOf(Myself),4)
THEN
  RESPONSE #100
    AttackOneRound(NearestEnemyOf(Myself))
END
