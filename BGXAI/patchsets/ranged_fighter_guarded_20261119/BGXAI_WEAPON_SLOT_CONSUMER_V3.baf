  GlobalTimerNotExpired("BGXW3_LEASE","LOCALS")
  ActionListEmpty()
  ModalState(NONE)
  !StateCheck(Myself,STATE_PANIC)
  !StateCheck(Myself,STATE_HELPLESS)
