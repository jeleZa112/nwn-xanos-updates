// BGXAI priest modes; additive lowest-priority EPS fallback; explicit opt-in only.
// Real-world compilation must use target game IDS. NEVER install without SHA + backup.

// BGXPR HEALER: last-priority Cure Light Wounds; no hit event needed.
IF
  InParty(Myself)
  !InPartySlot(Myself,0)
  !InPartySlot(Myself,0)
  Global("BGX38_GUARD","LOCALS",1)
  Global("BGXR_ROLE","LOCALS",1)
  Global("BGX66_S_HEAL_SLOT","LOCALS",0)
  !GlobalTimerNotExpired("BGX66_S_HEAL_COOLDOWN","LOCALS")
  !GlobalTimerNotExpired("BGXR_HEAL_CD","LOCALS")
  ActionListEmpty()
  ModalState(NONE)
  HaveSpell(CLERIC_CURE_LIGHT_WOUNDS)
  InParty(Player1)
  InPartySlot(Player1,0)
  InMyArea(Player1)
  See(Player1)
  Range(Player1,10)
  HPPercentLT(Player1,70)
THEN
  RESPONSE #100
    SetGlobalTimer("BGXR_HEAL_CD","LOCALS",12)
    Spell(Player1,CLERIC_CURE_LIGHT_WOUNDS)
END

// BGXPR HEALER: bounded approach while idle; never toward off-map or unseen ally.
IF
  InParty(Myself)
  !InPartySlot(Myself,0)
  !InPartySlot(Myself,0)
  Global("BGX38_GUARD","LOCALS",1)
  Global("BGXR_ROLE","LOCALS",1)
  Global("BGX66_S_HEAL_SLOT","LOCALS",0)
  !GlobalTimerNotExpired("BGXR_MOVE_CD","LOCALS")
  ActionListEmpty()
  ModalState(NONE)
  HaveSpell(CLERIC_CURE_LIGHT_WOUNDS)
  HPPercentGT(Myself,60)
  InParty(Player1)
  InPartySlot(Player1,0)
  InMyArea(Player1)
  See(Player1)
  HPPercentLT(Player1,55)
  !Range(Player1,10)
  Range(Player1,30)
  !Range(NearestEnemyOf(Myself),8)
THEN
  RESPONSE #100
    SetGlobalTimer("BGXR_MOVE_CD","LOCALS",4)
    MoveToObject(Player1)
END

