// BGXP2: 28 new post-EPS battle-priest fallback blocks, installed only with guarded WeiDU.
// BGXP2 SUPPORT FEAR slot 1; EPS-first idle fallback
IF
  InParty(Myself)
  !InPartySlot(Myself,0)
  Global("BGX38_GUARD","LOCALS",1)
  Global("BGX66_S_HEAL_SLOT","LOCALS",0)
  ActionListEmpty()
  ModalState(NONE)
  !StateCheck(Myself,STATE_PANIC)
  !StateCheck(Myself,STATE_SILENCED)
  Global("BGXR_ROLE","LOCALS",2)
  !GlobalTimerNotExpired("BGXP2_CURE_CD","LOCALS")
  HaveSpell(CLERIC_REMOVE_FEAR)
  InParty(Player1)
  InPartySlot(Player1,0)
  InMyArea(Player1)
  See(Player1)
  Range(Player1,10)
  StateCheck(Player1,STATE_PANIC)
THEN
  RESPONSE #100
    SetGlobalTimer("BGXP2_CURE_CD","LOCALS",60)
    Spell(Player1,CLERIC_REMOVE_FEAR)
END

