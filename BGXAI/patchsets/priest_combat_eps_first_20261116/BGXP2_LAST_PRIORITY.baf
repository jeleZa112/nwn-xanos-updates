// BGXP2 BATTLE first-level COMMAND vs confirmed nearby enemy
IF
  InParty(Myself)
  !InPartySlot(Myself,0)
  Global("BGX38_GUARD","LOCALS",1)
  Global("BGX66_S_HEAL_SLOT","LOCALS",0)
  ActionListEmpty()
  ModalState(NONE)
  !StateCheck(Myself,STATE_PANIC)
  !StateCheck(Myself,STATE_SILENCED)
  Global("BGXR_ROLE","LOCALS",3)
  !GlobalTimerNotExpired("BGXP2_COMMAND_CD","LOCALS")
  HaveSpell(CLERIC_COMMAND)
  HPPercentGT(Myself,50)
  See(NearestEnemyOf(Myself))
  Range(NearestEnemyOf(Myself),12)
  !StateCheck(NearestEnemyOf(Myself),STATE_SLEEPING)
  !StateCheck(NearestEnemyOf(Myself),STATE_HELPLESS)
THEN
  RESPONSE #100
    SetGlobalTimer("BGXP2_COMMAND_CD","LOCALS",90)
    Spell(NearestEnemyOf(Myself),CLERIC_COMMAND)
END

// BGXP2 BATTLE guarded one-round fallback ATTACK when EPS idle
IF
  InParty(Myself)
  !InPartySlot(Myself,0)
  Global("BGX38_GUARD","LOCALS",1)
  Global("BGX66_S_HEAL_SLOT","LOCALS",0)
  ActionListEmpty()
  ModalState(NONE)
  !StateCheck(Myself,STATE_PANIC)
  !StateCheck(Myself,STATE_SILENCED)
  Global("BGXR_ROLE","LOCALS",3)
  !GlobalTimerNotExpired("BGXP2_ATTACK_CD","LOCALS")
  HPPercentGT(Myself,60)
  See(NearestEnemyOf(Myself))
  Range(NearestEnemyOf(Myself),12)
  !StateCheck(NearestEnemyOf(Myself),STATE_SLEEPING)
THEN
  RESPONSE #100
    SetGlobalTimer("BGXP2_ATTACK_CD","LOCALS",15)
    AttackOneRound(NearestEnemyOf(Myself))
END

