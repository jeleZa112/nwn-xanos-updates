// BGXRANG (BGR001) 0.1 - experimental ranged Fighter/Thief profile
// SAFE PROTOTYPE: NOT included in BGXAI/latest.json, NOT compiled or installed.
// No names or portrait slots: works for any eligible ranged-support actor.
// AI script should be enabled only for that actor. Manual commands take priority when queue nonempty.
// Version marker - no combat action
IF
 Global("BGXRVER1","LOCALS",0)
THEN
 RESPONSE #100
  SetGlobal("BGXRVER1","LOCALS",1)
  DisplayStringHead(Myself,~BGXRANG V01 ACTIVE~)
END

// Restore two emergency evasions ONLY after fully leaving visible combat and healing.
IF
 GlobalGT("BGXRE1","LOCALS",0)
 HPPercentGT(Myself,79)
 !See(NearestEnemyOf(Myself))
THEN
 RESPONSE #100
  SetGlobal("BGXRE1","LOCALS",0)
  Continue()
END

// Short emergency evasions instead of swapping to melee. Do not override queued manual actions.
IF
 ActionListEmpty()
 See(NearestEnemyOf(Myself))
 Range(NearestEnemyOf(Myself),7)
 Global("BGXRE1","LOCALS",0)
 !GlobalTimerNotExpired("BGXRFL1","LOCALS")
THEN
 RESPONSE #100
  SetGlobal("BGXRE1","LOCALS",1)
  SetGlobalTimer("BGXRFL1","LOCALS",9)
  DisplayStringHead(Myself,~BGXRANG EVADE 1/2~)
  RunAwayFromNoLeaveArea(NearestEnemyOf(Myself),45)
END

// Second evasive attempt only if contact persists after first cooldown.
IF
 ActionListEmpty()
 See(NearestEnemyOf(Myself))
 Range(NearestEnemyOf(Myself),7)
 Global("BGXRE1","LOCALS",1)
 !GlobalTimerNotExpired("BGXRFL1","LOCALS")
THEN
 RESPONSE #100
  SetGlobal("BGXRE1","LOCALS",2)
  SetGlobalTimer("BGXRFL1","LOCALS",12)
  DisplayStringHead(Myself,~BGXRANG EVADE 2/2~)
  RunAwayFromNoLeaveArea(NearestEnemyOf(Myself),45)
END

// Choose an available ranged weapon once after a threat appears; avoid constant gear swapping.
IF
 ActionListEmpty()
 See(NearestEnemyOf(Myself))
 Range(NearestEnemyOf(Myself),18)
 !IsWeaponRanged(Myself)
 CanEquipRanged()
 !GlobalTimerNotExpired("BGXRWP1","LOCALS")
THEN
 RESPONSE #100
  SetGlobalTimer("BGXRWP1","LOCALS",12)
  EquipRanged()
  DisplayStringHead(Myself,~BGXRANG RANGED READY~)
END

// Stable attack only within range. Never chase enemies outside visible shooting range.
IF
 ActionListEmpty()
 See(NearestEnemyOf(Myself))
 Range(NearestEnemyOf(Myself),18)
 IsWeaponRanged(Myself)
THEN
 RESPONSE #100
  Attack(NearestEnemyOf(Myself))
END
