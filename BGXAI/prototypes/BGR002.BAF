// 2026-11-03 EET/SCS 35.21 / Insane | STAGING ONLY: requires WeiDU compilation + local game tests
// Do NOT activate or select: this is not a compiled game script.
// No fixed companion names, kit IDs or portrait slots.

// BGR002: BGXRANG v0.2 - ranged/thief support for low-STR Fighter/Thief
IF
 Global("BGXRV02","LOCALS",0)
THEN
 RESPONSE #100
  SetGlobal("BGXRV02","LOCALS",1)
  DisplayStringHead(Myself,~BGXRANG V02~)
END

// Emergency survival: never interrupt the player or current action queue
IF
 ActionListEmpty()
 See(NearestEnemyOf(Myself))
 Range(NearestEnemyOf(Myself),7)
 HPPercentLT(Myself,70)
 Global("BGXRE02","LOCALS",0)
 !GlobalTimerNotExpired("BGXRC02","LOCALS")
THEN
 RESPONSE #100
  SetGlobal("BGXRE02","LOCALS",1)
  SetGlobalTimer("BGXRC02","LOCALS",10)
  RunAwayFromNoLeaveArea(NearestEnemyOf(Myself),45)
END
IF
 ActionListEmpty()
 See(NearestEnemyOf(Myself))
 Range(NearestEnemyOf(Myself),7)
 HPPercentLT(Myself,55)
 Global("BGXRE02","LOCALS",1)
 !GlobalTimerNotExpired("BGXRC02","LOCALS")
THEN
 RESPONSE #100
  SetGlobal("BGXRE02","LOCALS",2)
  SetGlobalTimer("BGXRC02","LOCALS",12)
  RunAwayFromNoLeaveArea(NearestEnemyOf(Myself),45)
END

// Refill escape budget only when recovered completely and the area is safe
IF
 GlobalGT("BGXRE02","LOCALS",0)
 HPPercentGT(Myself,89)
 !ActuallyInCombat()
 !See(NearestEnemyOf(Myself))
THEN
 RESPONSE #100
  SetGlobal("BGXRE02","LOCALS",0)
  Continue()
END

// If the selected weapon is melee, equip a ranged option, but never auto-equip melee
IF
 ActionListEmpty()
 See(NearestEnemyOf(Myself))
 Range(NearestEnemyOf(Myself),18)
 !IsWeaponRanged(Myself)
 CanEquipRanged()
 !GlobalTimerNotExpired("BGXRW02","LOCALS")
THEN
 RESPONSE #100
  SetGlobalTimer("BGXRW02","LOCALS",12)
  EquipRanged()
END

// Attack only within visible ranged-reach and with equipped ranged weapon
IF
 ActionListEmpty()
 See(NearestEnemyOf(Myself))
 Range(NearestEnemyOf(Myself),18)
 IsWeaponRanged(Myself)
THEN
 RESPONSE #100
  Attack(NearestEnemyOf(Myself))
END

// Passive scouting during safe idle periods, and only if actor really has trap skill;
// scanning does not auto-disarm, open a chest or enter unexplored areas.
IF
 ActionListEmpty()
 !ActuallyInCombat()
 !See(NearestEnemyOf(Myself))
 CheckStatGT(Myself,0,TRAPS)
 !ModalState(DETECTTRAPS)
 !StateCheck(Myself,STATE_INVISIBLE)
THEN
 RESPONSE #100
  FindTraps()
END
