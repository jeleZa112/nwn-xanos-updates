// P1 fallback: protect hit victim without a speculative enemy selector.
IF
  InParty(Myself)
  !InPartySlot(Myself,0)
  Global("BGX38_GUARD","LOCALS",1)
  Global("BGX52_REQ_SLOT","LOCALS",1)
  GlobalTimerNotExpired("BGX52_EXPIRE","LOCALS")
  !GlobalTimerNotExpired("BGX52_COOLDOWN","LOCALS")
  ActionListEmpty()
  ModalState(NONE)
  InParty(Player1)
  InPartySlot(Player1,0)
  !InPartySlot(Myself,0)
  See(Player1)
  Range(Player1,10)
THEN
  RESPONSE #100
    SetGlobal("BGX52_REQ_SLOT","LOCALS",0)
    SetGlobalTimer("BGX52_COOLDOWN","LOCALS",4)
    SetGlobal("BGX60_LAST_BRANCH","LOCALS",2)
    SetGlobal("BGX60_LAST_VICTIM","LOCALS",1)
    ProtectObject(Player1,6)
END

