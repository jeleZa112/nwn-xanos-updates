// BGXAI 060 TEST CANDIDATE - READ AND COMPILE BEFORE ANY GAME INSTALL
// 056 Lua remains unchanged; no global player order, ClearActions or spells.

// 060: expire a stale confirmed-hit advisory and honor F=OFF.
IF
  InParty(Myself)
  GlobalGT("BGX52_REQ_SLOT","LOCALS",0)
  !GlobalTimerNotExpired("BGX52_EXPIRE","LOCALS")
THEN
  RESPONSE #100
    SetGlobal("BGX52_REQ_SLOT","LOCALS",0)
    Continue()
END

IF
  InParty(Myself)
  GlobalGT("BGX52_REQ_SLOT","LOCALS",0)
  Global("BGX38_GUARD","LOCALS",0)
THEN
  RESPONSE #100
    SetGlobal("BGX52_REQ_SLOT","LOCALS",0)
    Continue()
END

// P1 direct retaliation, only after EEex-confirmed hit and if guardian idle.
IF
  InParty(Myself)
  !InPartySlot(Myself,0)
  Global("BGX38_GUARD","LOCALS",1)
  Global("BGX52_REQ_SLOT","LOCALS",1)
  GlobalTimerNotExpired("BGX52_EXPIRE","LOCALS")
  !GlobalTimerNotExpired("BGX52_COOLDOWN","LOCALS")
  ActionListEmpty()
  ModalState(NONE)
  InParty(Player1)
  InPartySlot(Player1,0)
  !InPartySlot(Myself,0)
  See(Player1)
  Range(Player1,10)
  See(LastAttackerOf(Player1))
  Range(LastAttackerOf(Player1),10)
  !InParty(LastAttackerOf(Player1))
  !Allegiance(LastAttackerOf(Player1),GOODCUTOFF)
THEN
  RESPONSE #100
    SetGlobal("BGX52_REQ_SLOT","LOCALS",0)
    SetGlobalTimer("BGX52_COOLDOWN","LOCALS",4)
    SetGlobal("BGX60_LAST_BRANCH","LOCALS",1)
    SetGlobal("BGX60_LAST_VICTIM","LOCALS",1)
    AttackReevaluate(LastAttackerOf(Player1),30)
END

