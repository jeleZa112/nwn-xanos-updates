// BGXAI 067: source only, short bounded defense on verified enemy action start.
// No autonomous precombat enemy search; F enabled, idle and visible threat.
IF
  InParty(Myself)
  GlobalGT("BGX67_EARLY_SLOT","LOCALS",0)
  !GlobalTimerNotExpired("BGX67_EARLY_EXPIRE","LOCALS")
THEN
  RESPONSE #100
    SetGlobal("BGX67_EARLY_SLOT","LOCALS",0)
    Continue()
END

IF
  InParty(Myself)
  GlobalGT("BGX67_EARLY_SLOT","LOCALS",0)
  Global("BGX38_GUARD","LOCALS",0)
THEN
  RESPONSE #100
    SetGlobal("BGX67_EARLY_SLOT","LOCALS",0)
    Continue()
END

// P1: attack enemy nearest to threatened ally, then re-evaluate after 30 ticks.
IF
  InParty(Myself)
  !InPartySlot(Myself,0)
  Global("BGX38_GUARD","LOCALS",1)
  Global("BGX67_EARLY_SLOT","LOCALS",1)
  GlobalTimerNotExpired("BGX67_EARLY_EXPIRE","LOCALS")
  !GlobalTimerNotExpired("BGX67_EARLY_COOLDOWN","LOCALS")
  ActionListEmpty()
  ModalState(NONE)
  InParty(Player1)
  InPartySlot(Player1,0)
  InMyArea(Player1)
  See(Player1)
  Range(Player1,30)
  See(NearestEnemyOf(Player1))
  Range(NearestEnemyOf(Player1),15)
THEN
  RESPONSE #100
    SetGlobal("BGX67_EARLY_SLOT","LOCALS",0)
    SetGlobalTimer("BGX67_EARLY_COOLDOWN","LOCALS",4)
    AttackReevaluate(NearestEnemyOf(Player1),30)
END

