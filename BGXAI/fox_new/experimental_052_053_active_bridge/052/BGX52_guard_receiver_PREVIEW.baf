// BGXAI 052 - FUTURE BCS RECEIVER SOURCE ONLY, NOT COMPILED/INSTALLED.
// Must be EXTEND_TOP on exact SHA-pinned BGXAI 042B EPS script only.
// BCS reevaluates LIVE F mode, modal state, queue, sight, range and TTL.
// The bridge uses GameTime tick values to match GlobalTimerNotExpired.
IF
  InParty(Myself)
  GlobalGT("BGX52_REQ_SLOT","LOCALS",0)
  !GlobalTimerNotExpired("BGX52_EXPIRE","LOCALS")
THEN
  RESPONSE #100
    SetGlobal("BGX52_REQ_SLOT","LOCALS",0)
    Continue()
END

IF
  InParty(Myself)
  GlobalGT("BGX52_REQ_SLOT","LOCALS",0)
  Global("BGX38_GUARD","LOCALS",0)
THEN
  RESPONSE #100
    SetGlobal("BGX52_REQ_SLOT","LOCALS",0)
    Continue()
END

IF
  InParty(Myself)
  !InPartySlot(Myself,0)
  Global("BGX38_GUARD","LOCALS",1)
  Global("BGX52_REQ_SLOT","LOCALS",1)
  GlobalTimerNotExpired("BGX52_EXPIRE","LOCALS")
  !GlobalTimerNotExpired("BGX52_COOLDOWN","LOCALS")
  ActionListEmpty()
  ModalState(NONE)
  InParty(Player1)
  InPartySlot(Player1,0)
  !InPartySlot(Myself,0)
  See(Player1)
  Range(Player1,10)
  See(NearestEnemyOf(Player1))
  Range(NearestEnemyOf(Player1),7)
THEN
  RESPONSE #100
    SetGlobal("BGX52_REQ_SLOT","LOCALS",0)
    SetGlobalTimer("BGX52_COOLDOWN","LOCALS",8)
    ProtectObject(Player1,6)
END

