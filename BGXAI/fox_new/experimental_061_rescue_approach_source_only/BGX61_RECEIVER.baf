// P1: approach endangered ally after confirmed hit; same area, max 40 feet.
IF
  InParty(Myself)
  !InPartySlot(Myself,0)
  Global("BGX38_GUARD","LOCALS",1)
  Global("BGX52_REQ_SLOT","LOCALS",1)
  GlobalTimerNotExpired("BGX52_EXPIRE","LOCALS")
  !GlobalTimerNotExpired("BGX52_COOLDOWN","LOCALS")
  ActionListEmpty()
  ModalState(NONE)
  InParty(Player1)
  InPartySlot(Player1,0)
  !InPartySlot(Myself,0)
  InMyArea(Player1)
  !Range(Player1,10)
  Range(Player1,40)
THEN
  RESPONSE #100
    SetGlobalTimer("BGX52_EXPIRE","LOCALS",20)
    SetGlobalTimer("BGX52_COOLDOWN","LOCALS",2)
    SetGlobal("BGX61_LAST_BRANCH","LOCALS",3)
    SetGlobal("BGX61_LAST_VICTIM","LOCALS",1)
    MoveToObject(Player1)
END

