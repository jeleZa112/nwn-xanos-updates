// BGXAI 061: candidate BCS executor, after successful 060 close-range partial behavior.
// F=ON and verified on-hit Q required. Preserve 060 cleanup, EPS and manual actions.
// InMyArea + 40 ft bounds approach. No autonomous precombat wandering.

// Clear expired request and F=OFF, retaining 060's original safety.
IF
  InParty(Myself)
  GlobalGT("BGX52_REQ_SLOT","LOCALS",0)
  !GlobalTimerNotExpired("BGX52_EXPIRE","LOCALS")
THEN
  RESPONSE #100
    SetGlobal("BGX52_REQ_SLOT","LOCALS",0)
    Continue()
END

IF
  InParty(Myself)
  GlobalGT("BGX52_REQ_SLOT","LOCALS",0)
  Global("BGX38_GUARD","LOCALS",0)
THEN
  RESPONSE #100
    SetGlobal("BGX52_REQ_SLOT","LOCALS",0)
    Continue()
END

// P1: immediate retaliation after confirmed hit (0..10 feet to victim).
IF
  InParty(Myself)
  !InPartySlot(Myself,0)
  Global("BGX38_GUARD","LOCALS",1)
  Global("BGX52_REQ_SLOT","LOCALS",1)
  GlobalTimerNotExpired("BGX52_EXPIRE","LOCALS")
  !GlobalTimerNotExpired("BGX52_COOLDOWN","LOCALS")
  ActionListEmpty()
  ModalState(NONE)
  InParty(Player1)
  InPartySlot(Player1,0)
  !InPartySlot(Myself,0)
  InMyArea(Player1)
  See(Player1)
  Range(Player1,10)
  See(LastAttackerOf(Player1))
  Range(LastAttackerOf(Player1),10)
  !InParty(LastAttackerOf(Player1))
  !Allegiance(LastAttackerOf(Player1),GOODCUTOFF)
THEN
  RESPONSE #100
    SetGlobal("BGX52_REQ_SLOT","LOCALS",0)
    SetGlobalTimer("BGX52_COOLDOWN","LOCALS",4)
    SetGlobal("BGX61_LAST_BRANCH","LOCALS",1)
    SetGlobal("BGX61_LAST_VICTIM","LOCALS",1)
    AttackReevaluate(LastAttackerOf(Player1),30)
END

