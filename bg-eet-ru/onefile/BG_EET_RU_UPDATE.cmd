def digest(raw: bytes) -> str:
 return hashlib.sha256(raw).hexdigest()
def sha_path(p: Path) -> str:
 h = hashlib.sha256()
 with p.open('rb') as f:
    for block in iter(lambda: f.read(1 << 20), b''):
      h.update(block)
 return h.hexdigest()
