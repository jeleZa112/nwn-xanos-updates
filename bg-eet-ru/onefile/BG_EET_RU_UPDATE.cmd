def published_update(path, offline=False):
 if offline:return 'OFFLINE: обновление пропущено',False
 import subprocess
 pending=WORKDIR/'_BG_EET_RU_UPDATE_PENDING.cmd'
 try:
    request=urllib.request.Request(RELEASE_URL,headers={'User-Agent':'BG-EET-RU-onefile/46'})
    with urllib.request.urlopen(request,timeout=6) as response:
      if response.status!=200 or response.url!=RELEASE_URL:
        return 'STOP: некорректный адрес манифеста',False
      raw_manifest=response.read(8193)
    if len(raw_manifest)>8192:return 'STOP: большой манифест',False
    manifest=json.loads(raw_manifest.decode('utf-8'))
    if (manifest.get('schema')!='bg-eet-ru-onefile-release-v1' or
      manifest.get('project')!=UPDATER_ID or
      manifest.get('game_writes_allowed') is not False):
      return 'STOP: канал не гарантирует read-only режим',False
    version=manifest.get('version')
    if type(version) is not int or version<1 or version>9999:
      return 'STOP: неверная версия',False
    if version<=SELF_VERSION:
      return 'АКТУАЛЬНАЯ ВЕРСИЯ v'+str(SELF_VERSION),False
    wanted_sha=manifest.get('sha256')
    if not isinstance(wanted_sha,str) or not re.fullmatch('[0-9a-f]{64}',wanted_sha):
      return 'STOP: неверный SHA256 в манифесте',False
    request=urllib.request.Request(SRC_URL,headers={'User-Agent':'BG-EET-RU-onefile/46'})
    with urllib.request.urlopen(request,timeout=25) as response:
      if response.status!=200 or response.url!=SRC_URL:
        return 'STOP: некорректный адрес исходника',False
      new_source=response.read(750001)
    if not 10000<len(new_source)<=750000 or digest(new_source)!=wanted_sha:
      return 'STOP: скачанный источник не прошёл SHA256',False
    first,sep,body=new_source.partition(b'\n')
    if (not sep or not first.startswith(b'@echo off & py -3 -x ') or
      UPDATER_ID.encode('ascii') not in body or
      (b'SELF_VERSION = '+str(version).encode()) not in body):
      return 'STOP: неверный тип обновлятора',False
    compile(body.decode('utf-8-sig'),'<downloaded-BG-EET-RU>','exec')
    safe_external(Path(DEFAULT_GAME),Path(path))
    if Path(path).resolve()!= (WORKDIR/'BG_EET_RU_UPDATE.cmd').resolve():
      return 'STOP: непостоянный путь обновлятора',False
    pending.write_bytes(new_source)
    if sha_path(pending)!=wanted_sha:
      return 'STOP: промежуточный SHA256 не совпадает',False
    import subprocess
    check=subprocess.run([sys.executable,'-x',str(pending),'--selftest'],
               cwd=WORKDIR,stdin=subprocess.DEVNULL,
               capture_output=True,text=True,errors='replace',timeout=75)
    if check.returncode!=0 or 'SELFTEST: PASS' not in check.stdout:
      detail=(check.stderr or check.stdout or 'NO_OUTPUT').strip().replace('\\r',' ').replace('\\n',' | ')
      return 'STOP: самопроверка v'+str(version)+' не пройдена (код '+str(check.returncode)+'): '+detail[-900:],False
    backup_dir=WORKDIR/'SAFE_BACKUPS'
    backup_dir.mkdir(parents=True,exist_ok=True)
    previous=Path(path)
    if not previous.is_file():return 'STOP: текущий обновлятор отсутствует',False
    previous_sha=sha_path(previous)
    backup=backup_dir/('BG_EET_RU_UPDATE_V'+str(SELF_VERSION)+'_'+previous_sha[:12]+'.cmd')
    if not backup.exists():
      shutil.copy2(previous,backup)
    if sha_path(backup)!=previous_sha:
      return 'STOP: резервная копия не прошла SHA256',False
    if sha_path(pending)!=wanted_sha:
      return 'STOP: источник изменился до замены',False
    os.replace(pending,previous)
