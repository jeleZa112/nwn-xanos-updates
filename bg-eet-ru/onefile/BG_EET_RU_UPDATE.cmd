        line = line .. "\t" .. BG_EET_RU_V105_Sanitize(key) .. ":" ..
                      BG_EET_RU_V105_Sanitize(field.value_type) .. ":" .. value
        if #line > 3000 then break end
    end
    BG_EET_RU_V105_SaveLine(BG_EET_RU_V105_EXPORT_FILE, line)
end

