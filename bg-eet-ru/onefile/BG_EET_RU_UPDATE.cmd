B_HASH\n        summary['v2_pilot_marker_absent']=V2_MARKER not in db\n        if V2_MARKER in db:raise RuntimeError('FAILED_V2_STILL_PRESENT_STOP')\n        secs,directory=sections_of(raw)\n        summary['sections']=secs\n        summary['exception_directory']=directory\n        src=json.loads(zlib.decompress(base64.b64decode(_EMBED)).decode('utf8'))\n        rows=validate(raw,secs,src)\n        exceptions=get_unwind(raw,secs,directory)\n        summary['unwind_function_entries']=len(exceptions)\n        summary['strings_exact_verified']=len(rows)\n        summary['references_exact_verified']=sum(len(x['refs']) for x in rows)\n        with zipfile.ZipFile(out,'w',zipfile.ZIP_DEFLATED,compresslevel=9) as z:\n            unique,missing=capture(raw,secs,exceptions,rows,z)\n            summary['unique_unwind_functions_captured']=unique\n            summary['references_without_full_function_evidence']=len(missing)\n            summary['status']='CODE_EVIDENCE_CAPTURED_NEEDS_INDEPENDENT_DISASSEMBLY'\n            z.writestr('00_STATUS.json',json.dumps(summary,ensure_ascii=False,indent=2))\n            z.writestr('01_REFERENCES_47_AND_FUNCTION_RANGES.json',json.dumps(rows,ensure_ascii=False,indent=2))\n            z.writestr('README_RU.txt',\n                'BG EET RU V4. READ ONLY. V2 cleanup verified, game untouched in this pass. '\n                'This ZIP carries only code fragments for independent offline disassembly; '\n                '35 of 36 full Russian translations exceed the original string slots. '\n                'THAC0Right/Left are HOLD until proven player-visible. '\n                'Do NOT install any full-36 hook based solely on this archive.\\n')\n    except Exception as e:\n        summary['status']='STOP_NO_GAME_CHANGES';summary['error']=repr(e)\n        with zipfile.ZipFile(out,'w',zipfile.ZIP_DEFLATED) as z:\n            z.writestr('00_STATUS.json',json.dumps(summary,ensure_ascii=False,indent=2))\n            z.writestr('README_RU.txt','Read-only preflight stopped. No game files modified.\\n')\n    print(json.dumps({k:v for k,v in summary.items() if k!='sections'},ensure_ascii=False,indent=2))\n    print('REPORT_ZIP:',out)\n    return 0 if summary['status'].startswith('CODE_EVIDENCE_CAPTURED') else 2\n\nif __name__=='__main__':sys.exit(main())"

