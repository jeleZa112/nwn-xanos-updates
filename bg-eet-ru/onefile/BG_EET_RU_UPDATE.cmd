def v66_cached_original_matches(report_path):
    """Compare original English lines with current TLK evidence and cached live DLG."""
    import collections
    with zipfile.ZipFile(report_path) as z:
        pre=json.loads(z.read('10_BANTER_COMPILER_PREFLIGHT.json'))
        original=pre['live_english_original_audit']
        matches=[]
        for row in original.get('rows',[]):
            refs=sorted({int(ref) for side in row['exact_installed_tlk_strrefs'].values()
                         for ref in side})
            if refs:
                matches.append({'tra_id':row['id'],'tlk_refs':refs,'dlgs':[]})
        lookup=collections.defaultdict(list)
        for item in matches:
            for ref in item['tlk_refs']:lookup[ref].append(item)
        for path in z.namelist():
            if not path.startswith('09_IWD_BANTER_DLG/') or not path.endswith('.DLG'):
                continue
            data=z.read(path)
            if len(data)<52 or data[:8]!=b'DLG V1.0':continue
            states,so,trans,to=struct.unpack_from('<4I',data,8)
            if (states>300000 or trans>3000000 or
                so+states*16>len(data) or to+trans*32>len(data)):continue
            dlg=path.split('/')[-1][:-4]
            for kind,count,offset,strref_delta,stride in (
                ('STATE',states,so,0,16),('REPLY',trans,to,4,32)):
                for index in range(count):
                    ref=struct.unpack_from('<I',data,offset+index*stride+strref_delta)[0]
                    if ref in lookup:
                        for item in lookup[ref]:
                            item['dlgs'].append({'dlg':dlg,'kind':kind,'index':index,
                                                 'strref':ref})
    result={'schema':'bg-eet-ru-v66-cached-original-matches-v1',
            'english_source_total':len(original.get('rows',[])),
            'originals_with_exact_live_tlk_text':len(matches),
            'originals_with_refs_in_captured_dlgs':sum(bool(m['dlgs']) for m in matches),
            'matches':matches,
            'scope':'63 captured DLG and the exact-English source matches from v52 preflight',
            'translation_ready':False,'runtime_visibility_proven':False,
            'game_files_written':False,'installation_allowed':False,
            'note':'Exact textual match does not prove same line ownership or a playable path.'}
    with zipfile.ZipFile(report_path,'a',compression=zipfile.ZIP_DEFLATED) as z:
        name='17_V66_TARGETED_LIVE_ORIGINAL_MATCHES.json'
        if name in z.namelist():raise RuntimeError('duplicate v66 report')
        z.writestr(name,json.dumps(result,ensure_ascii=False,indent=2).encode('utf-8'))
    return result



def v67_cached_dlg_graph(report_path):
    """No game reads; analyze only five already matched strrefs in 63 cached DLGs."""
    from collections import defaultdict
    with zipfile.ZipFile(report_path) as z:
        prev=json.loads(z.read('17_V66_TARGETED_LIVE_ORIGINAL_MATCHES.json'))
        candidates={(r['dlg'],r['kind'],int(r['index']))
                    for item in prev.get('matches',[]) for r in item.get('dlgs',[])}
        expected={('NEERAJ','REPLY',2533),('NEERAJ','REPLY',2658),
                  ('SAFANJ','STATE',204),('SAFANJ','STATE',205),('SAFANJ','STATE',206)}
        if candidates!=expected:raise RuntimeError('STOP: v67 five cached references changed')
        models={}
        for name in z.namelist():
            if not name.startswith('09_IWD_BANTER_DLG/') or not name.endswith('.DLG'):continue
            data=z.read(name)
            if len(data)<52 or data[:8]!=b'DLG V1.0':continue
            sc,so,tc,to=struct.unpack_from('<4I',data,8)
            if sc>200000 or tc>2000000 or so+sc*16>len(data) or to+tc*32>len(data):continue
            states=[struct.unpack_from('<4I',data,so+j*16) for j in range(sc)]
            transitions=[struct.unpack_from('<5I8sI',data,to+j*32) for j in range(tc)]
            models[name.split('/')[-1][:-4]]={'states':states,'transitions':transitions}
    if len(models)!=63:raise RuntimeError('STOP: v67 expected 63 captured DLGs')
    incoming=defaultdict(list)
    for name,model in models.items():
        for i,t in enumerate(model['transitions']):
            dest=t[5].split(b'\0',1)[0].decode('ascii','replace').upper()
            if dest:incoming[(dest,t[6])].append({'dlg':name,'transition_index':i})
    targets=[]
    for name,kind,index in sorted(candidates):
        model=models[name]
        if kind=='REPLY':
            states=[i for i,row in enumerate(model['states']) if row[1]<=index<row[1]+row[2]]
            trans=model['transitions'][index]
            targets.append({
                'dlg':name,'type':'REPLY','index':index,'strref':trans[1],
                'owner_states':[{'index':i,'strref':model['states'][i][0],
                    'state_trigger_index':model['states'][i][3],
                    'inbound_count':len(incoming[(name,i)])} for i in states],
                'transition_flags':trans[0],'transition_trigger_index':trans[3],
                'transition_action_index':trans[4], 'owner_found':bool(states)})
        else:
            state=model['states'][index];first=state[1];count=state[2]
            next_states=[]
            for j in range(first,first+count):
                t=model['transitions'][j]
                dest=t[5].split(b'\0',1)[0].decode('ascii','replace').upper()
                next_states.append({'dlg':dest,'state_index':t[6]})
            targets.append({
                'dlg':name,'type':'STATE','index':index,'strref':state[0],
                'state_trigger_index':state[3], 'outgoing_count':count,
                'next_states':next_states,'inbound_count':len(incoming[(name,index)]),
                'inbound_sample':incoming[(name,index)][:12]})
    if any(x.get('owner_found') is False for x in targets):
        raise RuntimeError('STOP: v67 reply without owning state')
    report={'schema':'bg-eet-ru-v67-cached-dlg-structural-graph-v1',
            'status':'PASS_STRUCTURAL_ONLY','captured_dlgs_parsed':len(models),
            'target_references':targets,
            'verified_scope':'transition ownership, incoming/outgoing static links from cached DLGs',
            'branch_proven':False,'runtime_visibility_proven':False,
            'installation_allowed':False,'game_files_written':False,
            'translations_installed':0,
            'next_goal':'Compare original Party Banter TP2 branch and exact trigger/action payloads.'}
    with zipfile.ZipFile(report_path,'a',compression=zipfile.ZIP_DEFLATED) as z:
        name='18_V67_CACHED_DLG_GRAPH.json'
        if name in z.namelist():raise RuntimeError('STOP: duplicate v67 report')
        z.writestr(name,json.dumps(report,ensure_ascii=False,indent=2).encode('utf-8'))
    return report


V68_COMBAT_SOURCE = "# -*- coding: utf-8 -*-\n\"\"\"BG EET RU Extra Combat Info V4 — SINGLE FILE READ-ONLY CODE EVIDENCE.\n\nDoes not install or alter Baldur.exe, InfinityLoader.db, Lua, TLK, game saves,\nBGXAI, or BG Voice RU. Checks all 36 exact original strings and 47 LEA candidates,\nextracts only relevant x64 function/code slices for independent disassembly.\nRuns once without other files/dependencies, writes one ZIP into Downloads.\n\"\"\"\nimport base64, datetime, hashlib, json, os, re, struct, sys, zipfile, zlib\nfrom pathlib import Path\n\nGAME=Path(r'C:\\Games\\BG_EET_FOXX_NEW')\nEXE_HASH='fc821a4806a0305b84fd85f1aad2bd472c8db642ed34b4494ae62351cae1c580'\nLATEST_DB_HASH='5e4fb47ed1575255f79a03e7b4edfcc3bd9ee5dcb700059e0833aa8d4fae3ca0'\nV2_MARKER=b'[BG_EET_RU_RU_LUCK_V2_RIP_LEA]'\n_EMBED=''\n\n\ndef sha(data):return hashlib.sha256(data).hexdigest()\n\n\ndef sections_of(data):\n    if len(data)<0x100 or data[:2]!=b'MZ':raise RuntimeError('EXE_NOT_MZ')\n    nt=struct.unpack_from('<I',data,0x3C)[0]\n    if nt+264>=len(data) or data[nt:nt+4]!=b'PE\\0\\0':raise RuntimeError('EXE_NOT_PE')\n    machine,num=struct.unpack_from('<HH',data,nt+4)\n    if machine!=0x8664:raise RuntimeError('NOT_X64_EXE')\n    optsize=struct.unpack_from('<H',data,nt+20)[0]\n    opt=nt+24\n    if struct.unpack_from('<H',data,opt)[0]!=0x20B:raise RuntimeError('NOT_PE32_PLUS')\n    secstart=opt+optsize\n    sections=[]\n    for i in range(num):\n        a=secstart+i*40\n        if a+40>len(data):raise RuntimeError('SECTION_HEADER_OUT_OF_RANGE')\n        vsize,rva,rawsize,rawptr=struct.unpack_from('<IIII',data,a+8)\n        flag=struct.unpack_from('<I',data,a+36)[0]\n        sections.append({'name':data[a:a+8].split(b'\\0')[0].decode('ascii','replace'),\n                         'rva':rva,'virtual_size':vsize,'rawsize':rawsize,'rawptr':rawptr,\n                         'executable':bool(flag&0x20000000),'readable':bool(flag&0x40000000)})\n    # Exception directory is data-directory index 3 in PE32+\n    ep_rva,ep_len=struct.unpack_from('<II',data,opt+112+3*8)\n    return sections, {'rva':ep_rva,'size':ep_len}\n\n\ndef raw_to_rva(offset,secs):\n    for s in secs:\n        if s['rawptr']<=offset<s['rawptr']+s['rawsize']:\n            return s['rva']+(offset-s['rawptr'])\n    raise ValueError('RAW_OFFSET_OUTSIDE_SECTIONS')\n\n\ndef rva_to_raw(rva,secs):\n    for s in secs:\n        if s['rva']<=rva<s['rva']+s['rawsize']:\n            return s['rawptr']+(rva-s['rva'])\n    raise ValueError('RVA_OUTSIDE_FILE')\n\n\ndef get_unwind(data,secs,dir):\n    if dir['rva']==0 or dir['size']==0:raise RuntimeError('NO_EXCEPTION_DIRECTORY')\n    off=rva_to_raw(dir['rva'],secs)\n    if off+dir['size']>len(data):raise RuntimeError('EXCEPTION_DIRECTORY_TRUNCATED')\n    table=[]\n    for pos in range(off,off+dir['size']//12*12,12):\n        beg,end,unw=struct.unpack_from('<III',data,pos)\n        if beg and end>beg:table.append((beg,end,unw))\n    return table\n\n\ndef validate(data,secs,src):\n    result=[]\n    count=0\n    for row in src:\n        soff=row['offset'];en=row['en'].encode('ascii');ru=row['ru']\n        if data[soff:soff+len(en)+1]!=en+b'\\0':\n            raise RuntimeError('SOURCE_STRING_MISMATCH_OFFSET_'+str(soff))\n        srva=raw_to_rva(soff,secs)\n        new={'string_offset':soff,'source_en':row['en'],'translation_ru':ru,\n             'source_rva':srva,'source_bytes':len(en),'ru_utf8_bytes':len(ru.encode('utf-8')),\n             'refs':[],'visibility':'UNPROVEN'}\n        # These may be internal string keys, not visible journal messages:\n        if row['en'] in ('THAC0Right','THAC0Left'):new['visibility']='HOLD_INTERNAL_IDENTIFIER_POSSIBLE'\n        for ref in row['refs']:\n            off=ref['ins_file_offset'];expected=bytes.fromhex(ref['opcode'])\n            if len(expected)!=7 or expected[:3]!=b'\\x48\\x8d\\x15':\n                raise RuntimeError('UNSUPPORTED_LEA_OPCODE_AT_'+str(off))\n            if data[off:off+7]!=expected:raise RuntimeError('LEA_OPCODE_MISMATCH_AT_'+str(off))\n            irva=raw_to_rva(off,secs)\n            if not any(s['executable'] and s['rawptr']<=off< s['rawptr']+s['rawsize'] for s in secs):\n                raise RuntimeError('LEA_OUTSIDE_EXECUTABLE_SECTION_AT_'+str(off))\n            disp=struct.unpack_from('<i',expected,3)[0]\n            if irva+7+disp!=srva:raise RuntimeError('LEA_TARGET_MISMATCH_AT_'+str(off))\n            if data.count(expected)!=1:raise RuntimeError('LEA_NOT_UNIQUE_AT_'+str(off))\n            new['refs'].append({'file_offset':off,'ins_rva':irva,'original_bytes':ref['opcode'],\n                'target_rva':srva,'instruction_boundary_confirmed':False,\n                'function':None})\n            count+=1\n        result.append(new)\n    if len(result)!=36 or count!=47:raise RuntimeError('UNEXPECTED_SOURCE_COUNT_'+str(len(result))+'_'+str(count))\n    return result\n\n\ndef capture(data,secs,unwind,rows,zipf):\n    funcs={}\n    missing=[]\n    for row in rows:\n        for ref in row['refs']:\n            rva=ref['ins_rva']\n            choices=[f for f in unwind if f[0]<=rva<f[1]]\n            if choices:\n                beg,end,unw=min(choices,key=lambda t:t[1]-t[0])\n                length=end-beg\n                if length<7 or length>262144:\n                    ref['function']={'status':'TOO_LARGE_FOR_EVIDENCE','begin_rva':beg,'end_rva':end,'length':length}\n                    missing.append(ref['file_offset']);continue\n                k=(beg,end)\n                ref['function']={'status':'UNWIND_FUNCTION_FOUND','begin_rva':beg,'end_rva':end,\n                                 'unwind_rva':unw,'length':length,'evidence_filename':'functions/%08X_%08X.bin'%k}\n                if k not in funcs:\n                    start=rva_to_raw(beg,secs)\n                    section=next((x for x in secs if x['rawptr']<=start<x['rawptr']+x['rawsize']),None)\n                    if section is None or not section['executable'] or start+length>section['raw