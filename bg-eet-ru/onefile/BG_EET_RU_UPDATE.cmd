 if len(raw)<24 or raw[:8]!=b'KEY V1  ':
    raise ValueError('V82_INVALID_KEY_HEADER')
 nb,nr,bo,ro=struct.unpack_from('<IIII',raw,8)
 if nb>50_000 or nr>3_000_000:
    raise ValueError('V82_KEY_TOO_MANY_RECORDS')
