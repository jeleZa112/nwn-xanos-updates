    src = '''-- BG EET RU v71: ONE reversible Luck hook; short engine ResRef M_BGERU.
-- This file is the only game file installed by this pilot; all output external.
(function()
 local marker = [[MARKER_PATH]]
 local function report(message)
   local ok = pcall(function()
      if type(io) ~= 'table' or type(io.open) ~= 'function' then return end
      local f = io.open(marker, 'wb')
      if f then f:write('BG_EET_RU_V71=' .. tostring(message) .. '\\n'); f:close() end
   end)
 end
 report('LUA_LOADED')
 local ok, err = pcall(function()
   for _, name in ipairs({'EEex_Label','EEex_ReadByte','EEex_WriteStringAuto',
       'EEex_HookNOPs','EEex_DisableCodeProtection','EEex_EnableCodeProtection'}) do
      if type(_G[name]) ~= 'function' then error('API_MISSING:' .. name) end
   end
   local address = EEex_Label('BG_EET_RU_V2_LuckStringRef')
   if type(address) ~= 'number' or address == 0 then error('LUCK_LABEL_UNRESOLVED') end
   local expected = {0x48,0x8D,0x15,0xC6,0xF7,0x20,0x00}
   for i=1,#expected do
      if EEex_ReadByte(address+i-1) ~= expected[i] then
         error('UNEXPECTED_LEA_BYTE:' .. tostring(i))
      end
   end
   report('ADDRESS_AND_BYTES_VERIFIED')
   local translation = string.char(TRANSLATION_BYTES)
   local ptr = EEex_WriteStringAuto(translation)
   if type(ptr) ~= 'number' or ptr == 0 then error('ALLOC_FAILED') end
   EEex_DisableCodeProtection()
   local hookOK, hookError = pcall(function()
      EEex_HookNOPs(address, 2, {[[
         lea #$(1), qword ptr ds:[#$(2)] ]], {'rdx', ptr}, [[ #ENDL
         jmp #L(return)
      ]]})
   end)
   EEex_EnableCodeProtection()
   if not hookOK then error('HOOK_FAILED:' .. tostring(hookError)) end
 end)
 if ok then report('HOOK_INSTALLED') else report('ERROR:' .. tostring(err)) end
end)()
'''
    return src.replace('MARKER_PATH', location).replace('TRANSLATION_BYTES', codes).encode('ascii')


def v71_preflight(game):
    game = Path(game)
    exe = game / 'Baldur.exe'
    db = game / 'InfinityLoader.db'
    lua = game / 'override' / V71_SHORT_SCRIPT
    result = {'schema':'BG_EET_RU_V71_SHORT_LUA_GUARDED_PILOT',
              'game_root':str(game), 'engine_resref':'M_BGERU',
              'game_files_written':False, 'requires_explicit_consent':True,
              'full_translation_installed':False,
              'older_long_named_lua_file_left_untouched':True}
    if not exe.is_file() or not db.is_file():
        raise RuntimeError('V71_MISSING_EXE_OR_LOADER_DB')
    exe_data=exe.read_bytes()
    db_data=db.read_bytes()
    result['exe_sha256']=digest(exe_data)
    result['loader_db_sha256']=digest(db_data)
    if result['exe_sha256'] != V71_EXE_SHA:
        raise RuntimeError('V71_EXE_HASH_NOT_PINNED')
    if result['loader_db_sha256'] != V71_DB_SHA:
        raise RuntimeError('V71_DB_HASH_CHANGED_SINCE_V70')
    if exe_data[V71_LUCK_INS_OFFSET:V71_LUCK_INS_OFFSET+7] != V71_LUCK_BYTES:
        raise RuntimeError('V71_LUCK_INSTRUCTION_MISMATCH')
    if exe_data[V71_LUCK_FORMAT_OFFSET:V71_LUCK_FORMAT_OFFSET+10] != b' +Luck:%d\0':
        raise RuntimeError('V71_LUCK_LITERAL_MISMATCH')
    label=b'['+V71_LUCK_LABEL.encode('ascii')+b']'
    if db_data.count(label)!=1:
        raise RuntimeError('V71_PRIOR_VERIFIED_LUCK_LABEL_MISSING_OR_DUPLICATE')
    if not re.search(rb'\[BG_EET_RU_V2_LuckStringRef\]\s*Pattern=660F4CC8\s*Operations=ADD\s*-10', db_data):
        raise RuntimeError('V71_PATTERN_OR_ADD_UNEXPECTED')
    if b'CachedAddress=5372500803' not in db_data:
        raise RuntimeError('V71_LUCK_CACHED_ADDRESS_NOT_FOUND')
    if lua.exists():
        result['short_script_exists']=True
    else: result['short_script_exists']=False
    result['pilot_source_sha256']=digest(v71_script())
    result['confirmed_code_virtual_address']='0x14039DB43'
    result['status']='GUARDED_PILOT_READY' if not lua.exists() else 'EXISTING_SHORT_SCRIPT_HOLD'
    return result


def v71_processes_closed():
    if os.name != 'nt': return False, 'NOT_WINDOWS'
    import subprocess, csv
    try:
        p=subprocess.run(['tasklist.exe','/FO','CSV','/NH'],capture_output=True,
                         timeout=15,check=False)
        if p.returncode != 0: return False,'TASKLIST_FAILED'
        blob=p.stdout.decode('utf-8-sig','replace')
        # Windows Russian tasklist may produce CP866/CP1251. Executable names are ASCII.
        names=set()
        for row in csv.reader(io.StringIO(blob)):
            if row:
                names.add(row[0].strip(' \t"').casefold())
        busy=sorted(n for n in names if n in ('baldur.exe','infinityloader.exe'))
        return (not busy),('RUNNING:'+','.join(busy)) if busy else 'CLOSED'
    except (OSError,ValueError,subprocess.TimeoutExpired):
        return False,'PROCESS_CHECK_FAILED'


def v71_read_state():
    if not V71_STATE_PATH.is_file(): return None
    try:
        obj=json.loads(V71_STATE_PATH.read_text(encoding='utf-8'))
        if obj.get('schema') != 'BG_EET_RU_V71_SINGLE_LUCK_PILOT_STATE':
            raise ValueError('UNKNOWN_V71_STATE_FORMAT')
        return obj
    except (OSError,UnicodeError,ValueError) as ex:
        raise RuntimeError('V71_CORRUPT_INSTALL_STATE:'+str(ex)[:120])


def v71_write_state(state):
    V71_STATE_PATH.parent.mkdir(parents=True,exist_ok=True)
    staged=V71_STATE_PATH.with_suffix('.tmp')
    if staged.exists(): raise RuntimeError('V71_STALE_PENDING_STATE')
    try:
        staged.write_text(json.dumps(state,ensure_ascii=False,indent=2),encoding='utf-8')
        os.replace(staged,V71_STATE_PATH)
    finally:
        if staged.exists(): staged.unlink()


def v71_zip_report(game,report_path,status):
    safe_external(game,report_path)
    report_path=Path(report_path)
    if not report_path.is_file(): raise RuntimeError('V71_MAIN_ZIP_MISSING')
    tmp=report_path.with_suffix('.v71tmp')
    try:
        with zipfile.ZipFile(report_path,'r') as src,zipfile.ZipFile(tmp,'w',compression=zipfile.ZIP_DEFLATED) as dst:
            if src.testzip() is not None: raise RuntimeError('V71_PREVIOUS_ZIP_INVALID')
            seen=set()
            for entry in src.infolist():
                if entry.filename==V71_STATUS_ENTRY: continue
                if entry.filename in seen: raise RuntimeError('V71_EXISTING_ZIP_HAS_DUPLICATES')
                seen.add(entry.filename)
                dst.writestr(entry,src.read(entry))
            dst.writestr(V71_STATUS_ENTRY,json.dumps(status,ensure_ascii=False,indent=2).encode('utf-8'))
        with zipfile.ZipFile(tmp,'r') as verify:
            if verify.testzip() is not None: raise RuntimeError('V71_NEW_ZIP_CORRUPT')
        os.replace(tmp,report_path)
    finally:
        if tmp.exists(): tmp.unlink()


def v71_pilot(game,report_path,mode='auto'):
    game=Path(game)
    safe_external(game,WORKDIR)
    result={'schema':'BG_EET_RU_V71_SHORT_NAMED_RUNTIME_PILOT',
            'mode':mode,'game_root':str(game),'updater_version':SELF_VERSION,
            'game_exe_changed':False,'game_tlk_changed':False,
            'bgxai_voice_changed':False,'db_changed':False,
            'runtime_translation_verified':False,
            'only_game_file_allowed':'override/'+V71_SHORT_SCRIPT}
    try:
        lua=game/'override'/V71_SHORT_SCRIPT
        state=v71_read_state()
        if mode=='rollback':
            if state is None:
                result['status']='NO_V71_PILOT_STATE_NOTHING_DONE'
            else:
                closed,why=v71_processes_closed()
                if not closed: raise RuntimeError('V71_CLOSE_GAME_BEFORE_ROLLBACK:'+why)
                expected=state['source_sha256']
                if not lua.is_file() or digest(lua.read_bytes())!=expected:
                    raise RuntimeError('V71_LUA_CHANGED_OR_MISSING_NO_ROLLBACK')
                if digest((game/'InfinityLoader.db').read_bytes())!=state['loader_db_sha256']:
                    raise RuntimeError('V71_LOADER_CHANGED_NO_ROLLBACK')
                if digest((game/'Baldur.exe').read_bytes())!=state['exe_sha256']:
                    raise RuntimeError('V71_EXE_CHANGED_NO_ROLLBACK')
                lua.unlink()
                if lua.exists():raise RuntimeError('V71_UNLINK_FAILED')
                state['installed']=False
                state['rollback_utc']=now()
                v71_write_state(state)
                result['status']='V71_ROLLBACK_VERIFIED'
                result['game_files_written']=1
        elif state and state.get('installed'):
            result['status']='V71_INSTALLED_AWAITING_RUNTIME_EVIDENCE'
            result['lua_valid']=lua.is_file() and digest(lua.read_bytes())==state.get('source_sha256')
            result['installed_utc']=state.get('installed_utc')
            if V71_RUNTIME_MARK.is_file():
                raw=V71_RUNTIME_MARK.read_bytes()
                if len(raw)>500: raise RuntimeError('V71_RUNTIME_MARKER_TOO_LARGE')
                txt=raw.decode('utf-8','replace').strip()
                result['runtime_marker_text']=txt
                result['runtime_marker_mtime_ns']=V71_RUNTIME_MARK.stat().st_mtime_ns
                if V71_RUNTIME_MARK.stat().st_mtime_ns>=state.get('installed_time_ns',0):
                    if txt=='BG_EET_RU_V71=HOOK_INSTALLED':
                        result['status']='V71_HOOK_CALLED_GAME_SCREENSHOT_REQUIRED'
                    elif txt.startswith('BG_EET_RU_V71=ERROR:'):
                        result['status']='V71_LUA_RAN_BUT_HOOK_ERROR'
                    elif txt.startswith('BG_EET_RU_V71='):
                        result['status']='V71_LUA_RAN_PARTIAL_MARKER'
                else:result['runtime_marker_stale']=True
        elif state and state.get('installed') is False:
            result['status']='V71_ALREADY_ROLLED_BACK'
        else:
            proof=v71_preflight(game)
            result['preflight']=proof
            result['status']='V71_SOURCE_ONLY_AWAITING_EXPLICIT_APPROVAL'
            if mode=='install' or mode=='auto':
                closed,why=v71_processes_closed()
                result['process_check']=why
                if not closed:
                    result['status']='V71_PROCESS_SAFETY_HOLD'
                else:
                    print('v71: новый короткий M_BGERU.lua; только этот один файл будет создан в override.')
                    print('Пробный перевод: +Luck:%d -> +Удача:%d. При любой неопределённости безопасный STOP.')
                    try:consent=input('Чтобы установить пробный перевод, введи '+V71_CONSENT+' (Enter = пропуск): ').strip()
                    except EOFError:consent=''
                    if consent!=V71_CONSENT:
                        result['status']='V71_INSTALL_NOT_AUTHORIZED_NO_GAME_CHANGES'
                    else:
                        proof2=v71_preflight(game)
                        if proof2['status']!='GUARDED_PILOT_READY' or proof2['pilot_source_sha256']!=proof['pilot_source_sha256']:
                            raise RuntimeError('V71_PREFLIGHT_CHANGED_DURING_AUTHORIZATION')
                        data=v71_script()
                        if lua.exists():raise RuntimeError('V71_LUA_ALREADY_EXISTS')
                        if V71_STATE_PATH.exists():raise RuntimeError('V71_STATE_ALREADY_EXISTS')
                        if V71_RUNTIME_MARK.exists():raise RuntimeError('V71_MARKER_ALREADY_EXISTS_NOT_OVERWRITING')
                        import time
                        # Exclusive file create; on exceptions, remove only the exact file created here.
                        with lua.open('xb') as stream:stream.write(data)
                        try:
                            if digest(lua.read_bytes())!=digest(data):raise RuntimeError('V71_NEW_LUA_HASH_MISMATCH')
                            record={'schema':'BG_EET_RU_V71_SINGLE_LUCK_PILOT_STATE',
                                'installed':True,'installed_utc':now(),
                                'installed_time_ns':time.time_ns(),
                                'source_sha256':digest(data),
                                'exe_sha256':proof2['exe_sha256'],
                                'loader_db_sha256':proof2['loader_db_sha256'],
                                'script_path':str(lua),
                                'runtime_marker_path':str(V71_RUNTIME_MARK)}
                            v71_write_state(record)
                        except Exception:
                            if lua.exists() and digest(lua.read_bytes())==digest(data): lua.unlink()
                            raise
                        result['status']='V71_PILOT_INSTALLED_LAUNCH_GAME_AND_TEST'
                        result['game_files_written']=1
                        result['state_file']=str(V71_STATE_PATH)
        result.setdefault('game_files_written',0)
    except (OSError,ValueError,RuntimeError,KeyError) as ex:
        result['status']='V71_SAFE_STOP'
        result['error_type']=type(ex).__name__
        result['error']=str(ex)[:350]
    v71_zip_report(game,report_path,result)
    print('v71:',result['status'])
    print('Единый ZIP:',report_path)
    return 0 if result['status'] not in ('V71_SAFE_STOP','V71_PROCESS_SAFETY_HOLD') else 2


def v71_selftest():
    src=v71_script()
    assert len(Path(V71_SHORT_SCRIPT).stem)<=8
    assert b'M_BGERU' in src and b'EEex_ReadByte' in src
    assert b'EEex_HookNOPs' in src and b'+Luck' not in src
    assert b'208,163,208,180,208,176,209,135,208,176' in src  # UTF-8 Удача
    assert len(V71_LUCK_BYTES)==7 and V71_LUCK_BYTES.hex()=='488d15c6f72000'
    assert V71_SHORT_SCRIPT=='M_BGERU.lua'
    return True

# V72: one existing BG_EET_RU_UPDATE.cmd, one ZIP, diagnostic Lua (no code hook).
# Dependency: existing imports and v71_* functions/constants.

V72_REPORT_ENTRY = '23_V72_RUNTIME_PROBE.json'
V72_STATE = WORKDIR / 'BG_EET_RU_V72_PROBE_STATE.json'
V72_APPROVAL = 'INSTALL_BG_EET_RU_V72_DIAGNOSTIC_ONLY'


def v72_probe_source():
    # The engine Lua environment can lack io/os; never depend on file I/O from game Lua.
    # All messages are ASCII, and no EEex code hook or memory write is performed.
    return b'''-- BG EET RU V72: NO HOOK / NO MEMORY WRITES.  M_BGERU (7 chars).
(function()
  BG_EET_RU_V72_LOADED = true
  BG_EET_RU_V72_STATUS = "SCRIPT_STARTED"
  local function notify(msg)
    BG_EET_RU_V72_STATUS = tostring(msg)
    local value = "BG_EET_RU_V72: " .. BG_EET_RU_V72_STATUS
    if type(Infinity_Log) == "function" then pcall(Infinity_Log, value) end
    if type(Infinity_DisplayString) == "function" then
      pcall(Infinity_DisplayString, value)
    end
  end
  local function probe()
    local required = {"EEex_Label", "EEex_ReadByte", "EEex_WriteStringAuto",
                      "EEex_HookNOPs", "EEex_DisableCodeProtection",
                      "EEex_EnableCodeProtection"}
    local missing = {}
    for _, name in ipairs(required) do
      if type(_G[name]) ~= "function" then
        table.insert(missing, name)
      end
    end
    if #missing > 0 then
      notify("LOADED API_MISSING=" .. table.concat(missing, ","))
      return
    end
    local ok, ptr = pcall(EEex_Label, "BG_EET_RU_V2_LuckStringRef")
    if not ok then
      notify("LOADED LABEL_ERROR=" .. tostring(ptr))
    elseif type(ptr) ~= "number" or ptr == 0 then
      notify("LOADED LABEL_UNRESOLVED")
    else
      local addrText = string.format("%X", ptr)
      local bytes = {0x48,0x8D,0x15,0xC6,0xF7,0x20,0x00}
      local valid = true
      for i = 1, #bytes do
        local readOK, actual = pcall(EEex_ReadByte, ptr + i - 1)
        if not readOK or actual ~= bytes[i] then valid = false; break end
      end
      notify("LOADED LABEL=0x" .. addrText ..
             (valid and " BYTES_OK" or " BYTES_MISMATCH"))
    end
  end
  local ok, err = pcall(function()
    if type(EEex_GameState_AddInitializedListener) == "function" then
      EEex_GameState_AddInitializedListener(probe)
    else
      probe()
    end
  end)
  if not ok then notify("LOADED LISTENER_ERROR=" .. tostring(err)) end
end)()
'''


def v72_state_read():
    if not V72_STATE.is_file():return None
    try:
        s=json.loads(V72_STATE.read_text(encoding='utf-8'))
        if s.get('schema')!='BG_EET_RU_V72_PROBE_STATE':
            raise ValueError('BAD_SCHEMA')
        return s
    except (OSError,UnicodeError,ValueError) as ex:
        raise RuntimeError('V72_BAD_STATE:'+str(ex)[:160])


def v72_write_state(s):
    V72_STATE.parent.mkdir(parents=True,exist_ok=True)
    t=V72_STATE.with_suffix('.tmp')
    if t.exists():raise RuntimeError('V72_STALE_PENDING_STATE')
    try:
        t.write_text(json.dumps(s,ensure_ascii=False,indent=2),encoding='utf-8')
        os.replace(t,V72_STATE)
    finally:
        if t.exists():t.unlink()


def v72_zip_report(game,zipfile_path,status):
    safe_external(game,zipfile_path)
    src_path=Path(zipfile_path)
    if not src_path.is_file():raise RuntimeError('V72_SINGLE_ZIP_MISSING')
    staged=src_path.with_suffix('.v72tmp')
    try:
        with zipfile.ZipFile(src_path,'r') as zin,zipfile.ZipFile(staged,'w',zipfile.ZIP_DEFLATED) as zout:
            if zin.testzip() is not None:raise RuntimeError('V72_PRIOR_ZIP_BAD_CRC')
            seen=set()
            for item in zin.infolist():
                if item.filename == V72_REPORT_ENTRY:continue
                if item.filename in seen:raise RuntimeError('V72_DUPLICATE_ZIP_MEMBER')
                seen.add(item.filename)
                zout.writestr(item,zin.read(item))
            zout.writestr(V72_REPORT_ENTRY,json.dumps(status,ensure_ascii=False,indent=2).encode('utf-8'))
        with zipfile.ZipFile(staged) as check:
            if check.testzip() is not None:raise RuntimeError('V72_NEW_ZIP_BAD_CRC')
        os.replace(staged,src_path)
    finally:
        if staged.exists():staged.unlink()


def v72_pilot(game,report_path,mode='auto'):
    game=Path(game)
    lua=game/'override'/V71_SHORT_SCRIPT
    result={'schema':'BG_EET_RU_V72_RUNTIME_LUA_API_PROBE',
            'mode':mode,'updater_version':SELF_VERSION,'game_root':str(game),
            'read_only_during_game':True,'game_files_written':0,
            'no_code_hook':True,'modified_only':'override/'+V71_SHORT_SCRIPT,
            'exe_changed':False,'loader_db_changed':False,'tlk_changed':False,
            'voice_or_bgxai_changed':False,'runtime_execution_verified':False}
    try:
        existing=v72_state_read()
        v71=v71_read_state()
        if existing and existing.get('installed'):
            if mode=='rollback':
                closed,why=v71_processes_closed()
                if not closed:raise RuntimeError('V72_CLOSE_GAME_BEFORE_ROLLBACK:'+why)
                if not lua.is_file() or digest(lua.read_bytes())!=existing['new_lua_sha256']:
                    raise RuntimeError('V72_PILOT_CHANGED_NO_DELETE')
                if digest((game/'Baldur.exe').read_bytes())!=existing['exe_sha256'] or digest((game/'InfinityLoader.db').read_bytes())!=existing['db_sha256']:
                    raise RuntimeError('V72_BASE_CHANGED_NO_DELETE')
                lua.unlink()
                if lua.exists():raise RuntimeError('V72_DELETE_FAILED')
                existing['installed']=False
                existing['rolled_back_utc']=now()
                v72_write_state(existing)
                if v71 and v71.get('installed'):
                    v71['installed']=False
                    v71['rolled_back_by_v72_utc']=now()
                    v71_write_state(v71)
                result['status']='V72_ROLLBACK_VERIFIED_NO_LUA_LEFT'
                result['game_files_written']=1
            else:
                result['status']='V72_DIAGNOSTIC_INSTALLED_WAIT_FOR_GAME_SCREENSHOT'
                result['lua_valid']=lua.is_file() and digest(lua.read_bytes())==existing.get('new_lua_sha256')
                result['note']='Runtime cannot be inferred from absence of io.open; look for BG_EET_RU_V72 in game output.'
        elif mode=='rollback':
            # If V72 was not installed, fall back to original guarded V71 rollback.
            return v71_pilot(game,report_path,mode='rollback')
        elif mode=='status':
            result['status']='V72_NOT_INSTALLED_V71_PROBE_AVAILABLE'
            result['v71_installed']=bool(v71 and v71.get('installed'))
        elif existing and not existing.get('installed'):
            result['status']='V72_ALREADY_ROLLED_BACK'
        else:
            if not v71 or not v71.get('installed'):
                result['status']='V72_REQUIRES_INSTALLED_V71_NO_CHANGES'
            else:
                if not lua.is_file() or digest(lua.read_bytes())!=v71.get('source_sha256'):
                    raise RuntimeError('V72_V71_LUA_NOT_EXACT')
                exe_sha=digest((game/'Baldur.exe').read_bytes())
                db_sha=digest((game/'InfinityLoader.db').read_bytes())
                if exe_sha!=v71.get('exe_sha256') or db_sha!=v71.get('loader_db_sha256'):
                    raise RuntimeError('V72_PINNED_EXE_OR_DB_CHANGED')
                if exe_sha!=V71_EXE_SHA or db_sha!=V71_DB_SHA:
                    raise RuntimeError('V72_BASELINE_UNEXPECTED')
                closed,why=v71_processes_closed()
                result['process_check']=why
                if not closed:
                    result['status']='V72_CLOSE_GAME_BEFORE_UPGRADE'
                else:
                    print('v72: заменяет только существующий M_BGERU.lua на диагностику БЕЗ перехвата.')
                    print('Сначала проверим загрузку Lua и API через надпись BG_EET_RU_V72 в игре.')
                    try:approval=input('Разрешение: '+V72_APPROVAL+' (Enter=отмена): ').strip()
                    except EOFError:approval=''
                    if approval!=V72_APPROVAL:
                        result['status']='V72_NOT_AUTHORIZED_NO_CHANGES'
                    else:
                        source_before=lua.read_bytes()
                        if digest(source_before)!=v71['source_sha256']:
                            raise RuntimeError('V72_SOURCE_CHANGED_DURING_APPROVAL')
                        script=v72_probe_source()
                        backups=WORKDIR/'SAFE_BACKUPS'
                        safe_external(game,backups)
                        backups.mkdir(parents=True,exist_ok=True)
                        backup=backups/('M_BGERU_V71_'+digest(source_before)[:16]+'.lua.bak')
                        if backup.exists() and digest(backup.read_bytes())!=digest(source_before):
                            raise RuntimeError('V72_BACKUP_COLLISION')
                        if not backup.exists():
                            with backup.open('xb') as f:f.write(source_before)
                        if digest(backup.read_bytes())!=digest(source_before):
                            raise RuntimeError('V72_BACKUP_NOT_VERIFIED')
                        if V72_STATE.exists():raise RuntimeError('V72_STATE_ALREADY_EXISTS')
                        stage=lua.with_name('M_BGERU.v72tmp')
                        if stage.exists():raise RuntimeError('V72_STALE_GAME_STAGE')
                        try:
                            with stage.open('xb') as f:f.write(script)
                            if digest(stage.read_bytes())!=digest(script):
                                raise RuntimeError('V72_STAGED_PROBE_BAD_SHA')
                            os.replace(stage,lua)
                            if digest(lua.read_bytes())!=digest(script):
                                raise RuntimeError('V72_POST_REPLACE_HASH_FAILED')
                            state={'schema':'BG_EET_RU_V72_PROBE_STATE','installed':True,
                                   'installed_utc':now(),'new_lua_sha256':digest(script),
                                   'v71_lua_sha256':digest(source_before),
                                   'backup':str(backup),'exe_sha256':exe_sha,'db_sha256':db_sha}
                            v72_write_state(state)
                        except Exception:
                            if lua.is_file() and digest(lua.read_bytes())==digest(script):
                                staged_restore=lua.with_name('M_BGERU.restoretmp')
                                if not staged_restore.exists():
                                    with staged_restore.open('xb') as f:f.write(source_before)
                                    os.replace(staged_restore,lua)
                            raise
                        finally:
                            if stage.exists():stage.unlink()
                        result['status']='V72_DIAGNOSTIC_INSTALLED_LAUNCH_GAME'
                        result['game_files_written']=1
                        result['backed_up_prior_v71']=str(backup)
        result.setdefault('status','V72_NO_ACTION')
    except (OSError,ValueError,RuntimeError,KeyError) as ex:
        result['status']='V72_SAFE_STOP'
        result['error_type']=type(ex).__name__
        result['error']=str(ex)[:360]
    v72_zip_report(game,report_path,result)
    print('v72:',result['status'])
    print('Единый ZIP:',report_path)
    return 2 if result['status'] in ('V72_SAFE_STOP','V72_CLOSE_GAME_BEFORE_UPGRADE') else 0


def v72_selftest():
    s=v72_probe_source()
    assert b'BG_EET_RU_V72' in s
    assert b'Infinity_DisplayString' in s and b'Infinity_Log' in s
    assert b'EEex_HookNOPs(' not in s and b'EEex_DisableCodeProtection(' not in s
    assert b'io.open' not in s and b'os.execute' not in s
    assert len(V71_SHORT_SCRIPT.partition('.')[0])<=8
    assert callable(v72_pilot) and callable(v72_zip_report)
    return True

# BG EET RU v73 integration section; relies on v71 and v72 globals. One existing CMD / one ZIP.
V73_REPORT_ENTRY = '24_V73_LUCK_HOOK.json'
V73_STATE = WORKDIR / 'BG_EET_RU_V73_LUCK_STATE.json'
V73_APPROVAL = 'INSTALL_BG_EET_RU_V73_LUCK_PILOT'


def v73_lua_source():
    # Emit ASCII Lua source, with exact UTF-8 bytes for the in-game format string.
    code_bytes = ','.join(str(v) for v in ' +Удача:%d'.encode('utf-8'))
    source = '''-- BG EET RU V73: one guarded +Luck:%d patch, source-only until explicit authorization.
-- M_BGERU is seven characters; this is the only file changed by installation.
(function()
  BG_EET_RU_V73_LOADED = true
  BG_EET_RU_V73_STATUS = "SCRIPT_STARTED"
  local function say(message)
    BG_EET_RU_V73_STATUS = tostring(message)
    local text = "BG_EET_RU_V73: " .. BG_EET_RU_V73_STATUS
    if type(Infinity_Log) == "function" then pcall(Infinity_Log, text) end
    if type(Infinity_DisplayString) == "function" then pcall(Infinity_DisplayString, text) end
  end
  local function start()
    if BG_EET_RU_V73_HOOKED then say("ALREADY_HOOKED") return end
    local required = {"EEex_Label", "EEex_ReadU8", "EEex_WriteStringAuto",
                      "EEex_HookNOPs", "EEex_DisableCodeProtection", "EEex_EnableCodeProtection"}
    for _, name in ipairs(required) do
      if type(_G[name]) ~= "function" then say("API_MISSING=" .. name) return end
    end
    local ok, address = pcall(EEex_Label, "BG_EET_RU_V2_LuckStringRef")
    if not ok then say("LABEL_ERROR=" .. tostring(address)) return end
    if type(address) ~= "number" or address == 0 then say("LABEL_MISSING") return end
    local expected = {0x48, 0x8D, 0x15, 0xC6, 0xF7, 0x20, 0x00}
    for i = 1, #expected do
      local good, value = pcall(EEex_ReadU8, address + i - 1)
      if not good or value ~= expected[i] then
        say("ORIGINAL_BYTES_MISMATCH_AT=" .. tostring(i))
        return
      end
    end
    say("BYTES_VERIFIED")
    local ru = string.char(RU_FORMAT_BYTES)
    local allocOk, strPtr = pcall(EEex_WriteStringAuto, ru)
    if not allocOk or type(strPtr) ~= "number" or strPtr == 0 then
      say("ALLOC_FAILED=" .. tostring(strPtr))
      return
    end
    -- The original instruction is 7 bytes: lea rdx,[rip+disp32].
    -- EEex_HookNOPs(address,2,assemblyT) replaces exactly 5+2 bytes;
    -- its implementation appends the return jump, so NO manual jump here.
    -- mov rdx,imm64 loads the new format-string address without a RIP range limit.
    local unlockOK, unlockError = pcall(EEex_DisableCodeProtection)
    if not unlockOK then say("UNLOCK_FAILED=" .. tostring(unlockError)) return end
    local hookOK, hookError = pcall(function()
      EEex_HookNOPs(address, 2, {[[
         mov rdx, #$(1) ]], {strPtr}, [[ #ENDL
      ]]})
    end)
    local lockOK, lockError = pcall(EEex_EnableCodeProtection)
    if not lockOK then say("RELOCK_FAILED=" .. tostring(lockError)) return end
    if not hookOK then say("HOOK_FAILED=" .. tostring(hookError)) return end
    BG_EET_RU_V73_HOOKED = true
    say("HOOK_INSTALLED_ADDR=0x" .. string.format("%X", address))
  end
  local listenerOk, listenerError = pcall(function()
    if type(EEex_GameState_AddInitializedListener) == "function" then
      EEex_GameState_AddInitializedListener(start)
    else
      start()
    end
  end)
  if not listenerOk then say("LISTENER_ERROR=" .. tostring(listenerError)) end
end)()
'''
    return source.replace('RU_FORMAT_BYTES', code_bytes).encode('ascii')


def v73_read_state():
    if not V73_STATE.is_file(): return None
    try:
        state = json.loads(V73_STATE.read_text(encoding='utf-8'))
        if state.get('schema') != 'BG_EET_RU_V73_SINGLE_LUCK_STATE':
            raise ValueError('SCHEMA_MISMATCH')
        return state
    except (OSError, ValueError, UnicodeError) as exc:
        raise RuntimeError('V73_STATE_UNREADABLE:'+str(exc)[:200])


def v73_write_state(state):
    V73_STATE.parent.mkdir(parents=True, exist_ok=True)
    pending=V73_STATE.with_suffix('.v73tmp')
    if pending.exists():raise RuntimeError('V73_STALE_PENDING_STATE')
    try:
        pending.write_text(json.dumps(state, ensure_ascii=False, indent=2), encoding='utf-8')
        os.replace(pending,V73_STATE)
    finally:
        if pending.exists():pending.unlink()


def v73_zip_report(game, report_path, status):
    safe_external(game,report_path)
    path=Path(report_path)
    if not path.is_file():raise RuntimeError('V73_MISSING_CANONICAL_ZIP')
    staged=path.with_suffix('.v73ziptmp')
    if staged.exists():raise RuntimeError('V73_STALE_ZIP_TEMP')
    try:
        with zipfile.ZipFile(path,'r') as zin, zipfile.ZipFile(staged,'w',compression=zipfile.ZIP_DEFLATED) as zout:
            if zin.testzip() is not None:raise RuntimeError('V73_PRIOR_ZIP_CRC_FAIL')
            seen=set()
            for member in zin.infolist():
                if member.filename == V73_REPORT_ENTRY:continue
                if member.filename in seen:raise RuntimeError('V73_DUPLICATE_ARCHIVE_MEMBER')
                seen.add(member.filename)
                zout.writestr(member,zin.read(member))
            zout.writestr(V73_REPORT_ENTRY,json.dumps(status,ensure_ascii=False,indent=2).encode('utf-8'))
        with zipfile.ZipFile(staged) as z:
            if z.testzip() is not None:raise RuntimeError('V73_NEW_ZIP_CRC_FAIL')
        os.replace(staged,path)
    finally:
        if staged.exists():staged.unlink()


def v73_pilot(game,report_path,mode='auto'):
    game=Path(game)
    lua=game/'override'/V71_SHORT_SCRIPT
    result={'schema':'BG_EET_RU_V73_SINGLE_RUNTIME_LUCK_PILOT',
            'mode':mode,'updater_version':SELF_VERSION,'game_root':str(game),
            'game_files_written':0,'exe_changed':False,'loader_db_changed':False,
            'tlk_changed':False,'bgxai_voice_changed':False,
            'full_translation_installed':False,
            'only_modified_game_path':'override/'+V71_SHORT_SCRIPT,
            'engine_runtime_success_confirmed':False}
    try:
        installed=v73_read_state()
        old=v72_state_read()
        if installed and installed.get('installed'):
            if mode=='rollback':
                closed, reason=v71_processes_closed()
                if not closed: raise RuntimeError('V73_CLOSE_GAME_BEFORE_ROLLBACK:'+reason)
                if not lua.is_file() or digest(lua.read_bytes())!=installed['new_sha256']:
                    raise RuntimeError('V73_LUA_TAMPERED_NO_ROLLBACK')
                if digest((game/'Baldur.exe').read_bytes())!=installed['exe_sha256']:
                    raise RuntimeError('V73_EXE_CHANGED_NO_ROLLBACK')
                if digest((game/'InfinityLoader.db').read_bytes())!=installed['db_sha256']:
                    raise RuntimeError('V73_DB_CHANGED_NO_ROLLBACK')
                lua.unlink()
                if lua.exists():raise RuntimeError('V73_DELETE_FAILED')
                installed['installed']=False
                installed['rollback_utc']=now()
                v73_write_state(installed)
                if old and old.get('installed'):
                    old['installed']=False
                    old['rolled_back_by_v73_utc']=now()
                    v72_write_state(old)
                old_v71=v71_read_state()
                if old_v71 and old_v71.get('installed'):
                    old_v71['installed']=False
                    old_v71['rolled_back_by_v73_utc']=now()
                    v71_write_state(old_v71)
                result['game_files_written']=1
                result['status']='V73_ROLLBACK_VERIFIED_NO_PILOT_LUA'
            else:
                result['status']='V73_INSTALLED_RUNTIME_SCREENSHOT_REQUIRED'
                result['lua_valid']=lua.is_file() and digest(lua.read_bytes())==installed['new_sha256']
                result['note']='Check visible combat +Удача:0 and/or game console BG_EET_RU_V73_STATUS'
        elif mode=='rollback':
            return v72_pilot(game,report_path,mode='rollback')
        elif mode=='status':
            result['status']='V73_NOT_INSTALLED'
            result['v72_installed']=bool(old and old.get('installed'))
        elif installed and not installed.get('installed'):
            result['status']='V73_ALREADY_ROLLED_BACK'
        elif not old or not old.get('installed'):
            result['status']='V73_NEEDS_VALID_V72_DIAGNOSTIC'
        else:
            if not lua.is_file() or digest(lua.read_bytes())!=old['new_lua_sha256']:
                raise RuntimeError('V73_V72_SCRIPT_MISMATCH')
            exe_sha=digest((game/'Baldur.exe').read_bytes())
            db_sha=digest((game/'InfinityLoader.db').read_bytes())
            if exe_sha!=V71_EXE_SHA or db_sha!=V71_DB_SHA:
                raise RuntimeError('V73_BASELINE_SHA_CHANGED')
            if exe_sha!=old['exe_sha256'] or db_sha!=old['db_sha256']:
                raise RuntimeError('V73_PREVIOUS_STATE_SHA_CHANGED')
            check_exe=(game/'Baldur.exe').read_bytes()
            if check_exe[V71_LUCK_INS_OFFSET:V71_LUCK_INS_OFFSET+7]!=V71_LUCK_BYTES:
                raise RuntimeError('V73_ORIGINAL_7_BYTES_CHANGED')
            if check_exe[V71_LUCK_FORMAT_OFFSET:V71_LUCK_FORMAT_OFFSET+10]!=b' +Luck:%d\0':
                raise RuntimeError('V73_ORIGINAL_LITERAL_CHANGED')
            result['status']='V73_SOURCE_READY_EXPLICIT_CONSENT_REQUIRED'
            result['new_lua_sha256']=digest(v73_lua_source())
            closed,why=v71_processes_closed()
            result['process_check']=why
            if not closed:
                result['status']='V73_CLOSE_GAME_BEFORE_INSTALL'
            elif mode == 'auto':
                print('v73: EEex_ReadByte is absent; uses documented EEex_ReadU8.')
                print('One guarded runtime replacement: +Luck:0 -> +Удача:0.')
                print('Single M_BGERU.lua only. No Baldur.exe / DB / TLK writes.')
                try: approval=input('Разрешение: '+V73_APPROVAL+' (Enter=отмена): ').strip()
                except EOFError:approval=''
                if approval != V73_APPROVAL:
                    result['status']='V73_NOT_AUTHORIZED_NO_CHANGES'
                else:
                    if digest(lua.read_bytes())!=old['new_lua_sha256']:
                        raise RuntimeError('V73_SOURCE_CHANGED_DURING_CONSENT')
                    script=v73_lua_source()
                    backup_dir=WORKDIR/'SAFE_BACKUPS'
                    safe_external(game,backup_dir)
                    backup_dir.mkdir(parents=True, exist_ok=True)
                    backup=backup_dir/('M_BGERU_V72_'+digest(lua.read_bytes())[:16]+'.lua.bak')
                    if backup.exists() and digest(backup.read_bytes())!=old['new_lua_sha256']:
                        raise RuntimeError('V73_BACKUP_COLLISION')
                    if not backup.exists():
                        with backup.open('xb') as out:out.write(lua.read_bytes())
                    if digest(backup.read_bytes())!=old['new_lua_sha256']:
                        raise RuntimeError('V73_BACKUP_HASH_MISMATCH')
                    if V73_STATE.exists():raise RuntimeError('V73_STATE_ALREADY_EXISTS')
                    stage=lua.with_name('M_BGERU.v73tmp')
                    if stage.exists():raise RuntimeError('V73_STALE_GAME_STAGE')
                    try:
                        with stage.open('xb') as stream:stream.write(script)
                        if digest(stage.read_bytes())!=digest(script):
                            raise RuntimeError('V73_STAGED_LUA_BAD_HASH')
                        os.replace(stage,lua)
                        if digest(lua.read_bytes())!=digest(script):
                            raise RuntimeError('V73_POST_INSTALL_HASH_MISMATCH')
                        v73_write_state({'schema':'BG_EET_RU_V73_SINGLE_LUCK_STATE',
                            'installed':True,'installed_utc':now(),'new_sha256':digest(script),
                            'previous_sha256':old['new_lua_sha256'],
                            'backup':str(backup),'exe_sha256':exe_sha,'db_sha256':db_sha})
                    except Exception:
                        if lua.is_file() and digest(lua.read_bytes())==digest(script):
                            restore=lua.with_name('M_BGERU.v73restore')
                            if not restore.exists():
                                with restore.open('xb') as stream:stream.write(backup.read_bytes())
                                if digest(restore.read_bytes())==old['new_lua_sha256']:
                                    os.replace(restore,lua)
                        raise
                    finally:
                        if stage.exists():stage.unlink()
                    result['status']='V73_LUCK_PILOT_INSTALLED_GAME_TEST_REQUIRED'
                    result['game_files_written']=1
                    result['backed_up_v72_script']=str(backup)
        result.setdefault('status','V73_NO_ACTION')
    except (OSError,ValueError,RuntimeError,KeyError) as exc:
        result['status']='V73_SAFE_STOP'
        result['error_type']=type(exc).__name__
        result['error']=str(exc)[:360]
    v73_zip_report(game,report_path,result)
    print('v73:',result['status'])
    print('Единый ZIP:',report_path)
    return 2 if result['status'] in ('V73_SAFE_STOP','V73_CLOSE_GAME_BEFORE_INSTALL') else 0


