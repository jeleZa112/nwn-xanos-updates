        results[str(ref)]={'status':'NON_DEFAULT_TLK_FILE_ID_HOLD'}
        continue
      if ref>=count:
        results[str(ref)]={'status':'TLK_STRREF_OUT_OF_RANGE'}
        continue
      f.seek(18+26*ref)
      entry=f.read(26)
      if len(entry)!=26:raise ValueError('V111_TLK_TRUNCATED_ENTRY')
      flags=struct.unpack_from('<H',entry,0)[0]
