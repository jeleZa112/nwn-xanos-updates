def v56_static_audit(game, previous_zip, output_zip):
    """CRE/ARE/KEY directory only; read-only game resources, no BIF payloads."""
    import csv as _csv
    game=Path(game)
    override=game/'override'
    anchors=[]
    keep={}
    if previous_zip:
        keep=dict(previous_zip)
        try:
            v55=json.loads(keep['11_V55_LIVE_OVERRIDE_AUDIT.json'].decode('utf-8'))
            anchors=v55.get('anchors') or []
        except (KeyError,ValueError,UnicodeError,TypeError):
            anchors=[]
    targets={str(a.get('target_dlg','')).upper() for a in anchors if isinstance(a,dict)}
    targets.discard('')
    source='V55_ANCHORS'
    if not targets:
        try:
            with zipfile.ZipFile(output_zip) as z:
                status35=json.loads(z.read('09_IWD_BANTER_DLG_STATUS.json'))
            raw_targets=status35.get('target_dialogues',[])
            if isinstance(raw_targets,list):
                targets={str(v).upper() for v in raw_targets if isinstance(v,str) and v}
                source='V35_TARGETS_FALLBACK_NO_ANCHORS'
        except (OSError,KeyError,ValueError,zipfile.BadZipFile):
            pass
    errors=[]
    counts={'cre_scanned':0,'are_scanned':0,'are_actors':0}
    def u32(b,o):
        if o<0 or o+4>len(b):raise ValueError('offset outside file')
        return struct.unpack_from('<I',b,o)[0]
    def rr(b,o):
        if o<0 or o+8>len(b):return ''
        s=b[o:o+8].split(b'\0',1)[0]
        if not s or any(c<32 or c>126 for c in s):return ''
        return s.decode('ascii').upper().strip()
    def cd(b):
        if len(b)<8 or b[:4]!=b'CRE ':return ''
        version=b[4:8].decode('ascii','replace').strip()
        off={'V1.0':0x2cc,'V1.2':0x2cc,'V9.0':0x334}.get(version)
        if off is None:return ''
        return rr(b,off)
    def records(suffix):
        if not override.is_dir():return []
        return sorted((p for p in override.iterdir() if p.is_file() and p.suffix.upper()==suffix),key=lambda p:p.name.upper())
    crec={}
    direct=[]
    for p in records('.CRE'):
        try:
            d=cd(p.read_bytes());counts['cre_scanned']+=1
            if d:
                crec[p.stem.upper()]=d
                if d in targets:direct.append((p.stem.upper(),d))
        except (OSError,ValueError,struct.error) as exc:
            errors.append({'file':p.name,'problem':str(exc)[:150]})
    areas=[]
    for p in records('.ARE'):
        try:
            b=p.read_bytes()
            if len(b)<0x5c or b[:8]!=b'AREAV1.0':raise ValueError('unsupported ARE format')
            off=u32(b,0x54);count=struct.unpack_from('<H',b,0x58)[0]
            if count>50000 or off+count*0x110>len(b):raise ValueError('invalid actor bounds')
            counts['are_scanned']+=1;counts['are_actors']+=count
            for i in range(count):
                x=off+i*0x110
                cr=rr(b,x+0x80)
                dl=rr(b,x+0x48)
                embedded=u32(b,x+0x88);size=u32(b,x+0x8c)
                ed=''
                if size:
                    if embedded+size>len(b):raise ValueError('invalid embedded CRE bounds')
                    ed=cd(b[embedded:embedded+size])
                match=sorted({v for v in (dl,ed,crec.get(cr,'')) if v in targets})
                if match:areas.append({'area':p.stem.upper(),'actor':i,'cre':cr,'dlg':match})
        except (OSError,ValueError,struct.error) as exc:
            errors.append({'file':p.name,'problem':str(exc)[:150]})
    present=set()
    key_stats={}
    try:
        b=(game/'chitin.key').read_bytes()
        if len(b)<24 or b[:4]!=b'KEY ':raise ValueError('not KEY')
        nb=u32(b,8);nr=u32(b,12);bo=u32(b,16);ro=u32(b,20)
        if nb>500000 or nr>2000000 or bo+nb*12>len(b) or ro+nr*14>len(b):
            raise ValueError('invalid KEY directory')
        for i in range(nr):
            x=ro+14*i
            if struct.unpack_from('<H',b,x+8)[0]==0x3f3:
                present.add(rr(b,x))
        key_stats={'bif_directory_entries':nb,'resource_directory_entries':nr}
    except (OSError,ValueError,struct.error) as exc:
        errors.append({'file':'chitin.key','problem':str(exc)[:150]})
    rows=[]
    overridden={p.stem.upper() for p in records('.DLG')}
    for target in sorted(targets):
        rows.append({'dialogue':target,'override_dlg':target in overridden,
                     'key_directory_dlg':target in present,
                     'override_cre_links':sorted(c for c,d in direct if d==target),
                     'override_are_links':sorted(set(a['area'] for a in areas if target in a['dlg']))})
    summary={**counts,'target_dialogues':len(targets),'anchors_from_v55':len(anchors),
             'targets_with_override_cre_link':sum(bool(x['override_cre_links']) for x in rows),
             'targets_with_override_are_link':sum(bool(x['override_are_links']) for x in rows),
             'targets_in_key_directory':sum(x['key_directory_dlg'] for x in rows),
             'errors':len(errors),**key_stats}
    status=('LIVE_STATIC_AUDIT' if len(anchors)==82 and len(targets)==26
            else 'PARTIAL_V35_TARGET_FALLBACK' if len(targets)==26
            else 'BLOCKED_MISSING_TARGETS')
    output={'schema':'bg-eet-ru-v56-static-cre-are-key-v1','status':status,
            'game_root':str(game),'summary':summary,'target_presence':rows,
            'errors':errors[:200],'game_files_written':False,'installation_allowed':False,
            'runtime_visibility_proven':False,
            'coverage':'CRE/ARE override and KEY directory only; no BIF content or BCS evaluation',
            'v55_previous_report_preserved':'11_V55_LIVE_OVERRIDE_AUDIT.json' in keep,
            'target_source':source}
    data={'12_V56_CRE_ARE_KEY_AUDIT.json':json.dumps(output,ensure_ascii=False,indent=2).encode('utf-8')}
    csv_out=io.StringIO()
    writer=_csv.DictWriter(csv_out,fieldnames=['dialogue','override_dlg','key_directory_dlg','override_cre_links','override_are_links'])
    writer.writeheader()
    for r in rows:
        writer.writerow({**r,'override_cre_links':';'.join(r['override_cre_links']),
                           'override_are_links':';'.join(r['override_are_links'])})
    data['12_V56_TARGET_LINKS.csv']=csv_out.getvalue().encode('utf-8-sig')
    with zipfile.ZipFile(output_zip,'a',compression=zipfile.ZIP_DEFLATED) as z:
        for name in ('11_V55_LIVE_OVERRIDE_AUDIT.json','11_V55_82_ANCHORS.csv'):
            if name in keep and name not in z.namelist():z.writestr(name,keep[name])
        for name,payload in data.items():
            if name in z.namelist():raise RuntimeError('duplicate v56 ZIP entry')
            z.writestr(name,payload)
    with zipfile.ZipFile(output_zip) as z:
        if z.testzip() is not None:raise RuntimeError('v56 archive CRC failure')
    return output


def v56_preserve_prior(path):
    """Retain safe prior audit reports before the base ZIP is rewritten."""
    result={}
    if not Path(path).is_file():return result
    with zipfile.ZipFile(path) as z:
        for name in ('11_V55_LIVE_OVERRIDE_AUDIT.json','11_V55_82_ANCHORS.csv',
                     '12_V56_CRE_ARE_KEY_AUDIT.json','12_V56_TARGET_LINKS.csv',
                     '13_V58_LOCAL_TP2_BCS_GATE.json'):
            try:
                i=z.getinfo(name)
                if i.file_size<2000000:result[name]=z.read(name)
            except KeyError:pass
    return result



def v58_local_tp2_bcs_gate(game, report_path):
    """Only inspect locally installed TP2/WeiDU.log/override BCS; no game changes."""
    g=Path(game)
    candidates=(
        g/'iwd_eet-party-banter'/'Setup-iwd_eet-party-banter.tp2',
        g/'Setup-iwd_eet-party-banter.tp2',
        g/'iwd_eet-party-banter'/'iwd_eet-party-banter.tp2'
    )
    tp=next((p for p in candidates if p.is_file()),None)
    log=next((p for p in (g/'WeiDU.log',g/'weidu.log') if p.is_file()),None)
    result={'schema':'bg-eet-ru-v58-local-source-branch-gate-v1',
            'status':'INSPECTED','tp2_present':tp is not None,
            'weidu_log_present':log is not None,'branch_status':'UNKNOWN',
            'game_files_written':False,'installation_allowed':False,
            'runtime_visibility_proven':False,
            'note':'Presence of BCS/ARE/DLG never proves activation of the banter mod or visibility.'}
    if tp and log:
        raw=tp.read_bytes()
        src=raw.decode('utf-8-sig','replace')
        lines=log.read_text('utf-8-sig','replace').splitlines()
        matches=[s.strip()[:350] for s in lines if re.search(r'IWD2_EET[^\r\n]*#\s*[01]\b',s,re.I)]
        installed0=any(re.search(r'#\s*0\b',s) for s in matches)
        installed1=any(re.search(r'#\s*1\b',s) for s in matches)
        needs1=bool(re.search(r'MOD_IS_INSTALLED\s*~IWD2_EET\.TP2~\s*~1~',src,re.I))
        scripts=sorted(set(re.findall(r'EXTEND_TOP\s+~([A-Z0-9_]+\.bcs)~',src,re.I)),key=str.upper)
        found=[]
        for name in scripts[:250]:
            p=g/'override'/name
            if not p.is_file():continue
            b=p.read_bytes()
            found.append({'name':name.upper(),'size':len(b),'sha256':digest(b)})
        result.update(tp2_relative_path=str(tp.relative_to(g)),
                      tp2_sha256=digest(raw),iwd2_component_0=installed0,
                      iwd2_component_1=installed1,source_requires_iwd2_component_1=needs1,
                      matching_weidu_log_lines=matches[:12],
                      source_extend_top_bcs_count=len(scripts),
                      override_bcs_found_count=len(found),override_bcs=found)
        result['branch_status']=(
            'SOURCE_BRANCH_CONDITION_NOT_MET' if needs1 and installed0 and not installed1
            else 'UNRESOLVED_OR_POSSIBLY_MET')
    else:
        result['status']='MISSING_LOCAL_SOURCE_OR_WEIDU_LOG'
        result['reason']='LOCAL_TP2_NOT_FOUND' if not tp else 'WEIDU_LOG_NOT_FOUND'
        result['searched_tp2_paths']=[str(p.relative_to(g)) for p in candidates]
        result['searched_weidu_logs']=['WeiDU.log','weidu.log']
        result['branch_status']='UNDETERMINED_'+result['reason']
    with zipfile.ZipFile(report_path,'a',compression=zipfile.ZIP_DEFLATED) as z:
        if '13_V58_LOCAL_TP2_BCS_GATE.json' in z.namelist():
            raise RuntimeError('duplicate v58 report')
        z.writestr('13_V58_LOCAL_TP2_BCS_GATE.json',
                   json.dumps(result,ensure_ascii=False,indent=2).encode('utf-8'))
    with zipfile.ZipFile(report_path) as z:
        if z.testzip() is not None:raise RuntimeError('v58 ZIP integrity error')
    return result



def v60_weidu_installed_components(game, report_path):
    """Read WeiDU.log independently of TP2 source availability."""
    g=Path(game)
    log=next((p for p in (g/'WeiDU.log',g/'weidu.log') if p.is_file()),None)
    report={'schema':'bg-eet-ru-v60-installed-component-audit-v1',
            'status':'WEIDU_LOG_NOT_FOUND','game_files_written':False,
            'installation_allowed':False,'runtime_visibility_proven':False,
            'groups':{},'matched_entries':[]}
    if log is not None:
        data=log.read_bytes()
        src=data.decode('utf-8-sig','replace')
        if src.count('\ufffd')>max(4,len(src)//2000):
            src=data.decode('cp1251','replace')
        entries=[]
        all_components=0
        raw_mod_references=[]
        sample_tp2_paths=[]
        terms=('iwd1_eet','iwd2_eet','iwd_eet-party-banter','how_eet','totlm',
               'iwd1-eet','iwd2-eet','iwd_eet_party_banter','iwd-eet-party-banter')
        for line_no,line in enumerate(src.splitlines(),1):
            line=line.strip().lstrip('\ufeff')
            if not line or line.startswith('//'):continue
            # Accept optional leading paths and whitespace, but preserve actual component IDs.
            m=re.search(r'~([^~\r\n]*?\.tp2)~\s*#\s*(\d+)\s*#\s*(\d+)(?!\d)',line,re.I)
            if m:
                all_components+=1
                modpath=m.group(1).replace('\\','/').lower()
                if len(sample_tp2_paths)<12:sample_tp2_paths.append(m.group(1)[-180:])
                if any(term in modpath for term in terms):
                    entries.append({'line':line_no,'tp2_path':m.group(1),
                                    'language':int(m.group(2)),'component':int(m.group(3)),
                                    'comment':line.split('//',1)[-1].strip()[:180] if '//' in line else ''})
            elif any(term in line.lower() for term in terms) and len(raw_mod_references)<15:
                raw_mod_references.append({'line':line_no,'text':line[:240]})
        report['diagnostics']={'log_bytes':len(data),'lines':len(src.splitlines()),
                               'all_parsed_tp2_component_lines':all_components,
                               'sample_other_mod_tp2_paths':sample_tp2_paths,
                               'unparsed_relevant_lines':raw_mod_references,
                               'utf16_bom':data.startswith((b'\xff\xfe',b'\xfe\xff')),
                               'nul_byte_count_first_1024':data[:1024].count(b'\x00')}
        if data.startswith((b'\xff\xfe',b'\xfe\xff')) or data[:1024].count(b'\x00')>64:
            report['diagnostics']['warning']='POSSIBLE_UTF16_LOG_PARSER_UNSUPPORTED'
        for mod,key in [('iwd1_eet','IWD1_EET'),('iwd2_eet','IWD2_EET'),
                        ('iwd_eet-party-banter','IWD_PARTY_BANTER'),
                        ('how_eet','HOW_EET'),('totlm','TOTLM')]:
            aliases={'iwd1_eet':('iwd1_eet','iwd1-eet'),
                     'iwd2_eet':('iwd2_eet','iwd2-eet'),
                     'iwd_eet-party-banter':('iwd_eet-party-banter','iwd_eet_party_banter','iwd-eet-party-banter')}
            accepted=aliases.get(mod,(mod,))
            values=sorted({e['component'] for e in entries if any(x in e['tp2_path'].lower() for x in accepted)})
            report['groups'][key]={'installed_components':values,'found':bool(values)}
        iwd2=report['groups']['IWD2_EET']['installed_components']
        banter=report['groups']['IWD_PARTY_BANTER']['installed_components']
        report.update(status='INSPECTED_WEIDU_LOG',log_sha256=digest(data),
                      parsed_relevant_entries=len(entries),matched_entries=entries,
                      observed_iwd2_component_0=0 in iwd2,
                      observed_iwd2_component_1=1 in iwd2,
                      observed_banter_component_0=0 in banter,
                      condition_inferred='IWD2_1_NOT_LISTED' if 1 not in iwd2 else 'IWD2_1_LISTED')
        report['note']='WeiDU.log only proves logged components; it cannot prove whether a TP2 branch executed, nor what appears on screen.'
    with zipfile.ZipFile(report_path,'a',compression=zipfile.ZIP_DEFLATED) as z:
        if '14_V60_WEIDU_COMPONENTS.json' in z.namelist():
            raise RuntimeError('duplicate v60 report')
        z.writestr('14_V60_WEIDU_COMPONENTS.json',
                   json.dumps(report,ensure_ascii=False,indent=2).encode('utf-8'))
    return report



