 import tempfile as _tmp
 assert len(V76_TARGETS)==2 and V76_TARGETS[0][0]==266659 and V76_TARGETS[1][0]==273940
 with _tmp.TemporaryDirectory(prefix='BG_EET_RU_V76_TEST_') as d:
