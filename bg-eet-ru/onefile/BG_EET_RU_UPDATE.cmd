    if src.testzip() is not None or len(src.namelist())!=len(set(src.namelist())):
      raise RuntimeError('V106_PRIOR_ZIP_BAD')
    previous=json.loads(src.read(V106_ENTRY)) if V106_ENTRY in src.namelist() else None
