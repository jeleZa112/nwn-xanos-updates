    raise RuntimeError('V108_MAIN_CHANGED_AFTER_FINGERPRINT')
 if installed:
    return {'target':target,'actual_sha256':digest(current),
        'expected_original_sha256':V108_BASIS_SHA['EEex_scripts/BG_EET_RU_WeaponObserver.lua']}
