def make_review_queue(v28report):
    """Editorial evidence inventory, not a proposed patch and never an approval gate."""
    verified = v28report.get('targets', []) if isinstance(v28report,dict) else []
    expected = {int(k) for k in REVIEW_SEEDS}
    actual = {int(row['strref']) for row in verified}
    if len(verified) != 18 or expected != actual:
        raise RuntimeError('STOP: expected 18 known targets; ambiguous or missing evidence')
    queue=[]
    for row in verified:
        ref=int(row['strref'])
        seed=REVIEW_SEEDS[str(ref)]
        is_movie = row.get('group')=='UI_MOVIE_VISIBILITY_HOLD'
        if ref==317979:
            reason='Русская реплика с актёрскими и фонетическими ремарками; не удалять русскую ремарку автоматически'
        elif ref==319734:
            reason='Русская реплика с фонетическими ремарками; показ конкретной ветви не подтверждён'
        elif ref==101807:
            reason='[else] в NPC_STATE; триггеры/видимость в игре не подтверждены'
        elif ref in (100436,100438,100440,100446):
            reason='[Faulty] имя ITM из BlackPits.bif; получение/показ игроку не доказаны'
        elif is_movie:
            reason='[Movie] метка ролика, UI.MENU не подтвердил вывод пользователю'
        else:
            raise RuntimeError('STOP: unknown candidate family')
        queue.append({
            'strref':ref,'excerpt':seed['excerpt_ru'],
            'triage_original':seed['triage'],
            'resource':row.get('expected_owner'),
            'resource_link_found':row.get('owner_link_in_current_resource') is True,
            'visibility':row.get('visibility','NOT_PROVEN'),
            'status':'HOLD_REQUIRES_DISPLAY_EVIDENCE',
            'reason':reason,
            'translation_approved':False,
            'user_requested_real_player_visible_only':True
        })
    return {
        'schema':'bg-eet-ru-v31-player-visible-only-review-v1',
        'status':'SOURCE_ONLY_EDITORIAL_HOLD',
        'candidates':queue,
        'new_translation_approvals':0,
        'scope':'From historical v26 queue and verified v28 report; static references cannot prove a real UI display.',
        'next_evidence':'Direct observed on-screen text with game context is required before a change can be proposed.',
        'game_files_written':False
    }




def write_bundle(path, status, v28report, v29report, fp, existing_log='', source_report=None, nondialogue_report=None, dlg_status=None, dlg_contents=None, dlg_cache=None, v36_preflight=None):
    safe_external(Path(status['game_root']), path)
    path.parent.mkdir(parents=True,exist_ok=True)
    tmp=path.with_suffix('.zip.tmp')
    text=(existing_log.strip()+'\n' if existing_log.strip() else '') + (
        f"{now()} v{SELF_VERSION} READ_ONLY; v28={status['sources_used'].get('v28')}; "
        f"v29={status['sources_used'].get('v29')}; patched=0\n")
    if len(text)>120_000: text=text[-120_000:]
    def b(obj):return (json.dumps(obj,ensure_ascii=False,indent=2)+'\n').encode('utf-8')
    try:
        with zipfile.ZipFile(tmp,'w',compression=zipfile.ZIP_DEFLATED) as z:
            z.writestr('00_STATUS.json',b(status))
            z.writestr('01_V28_DLG_CONTEXT.json',b(v28report))
            z.writestr('02_V29_BP_PLACEMENT.json',b(v29report))
            z.writestr('03_ALL_RUNS.log',text)
            z.writestr('04_FINGERPRINT.json',b(fp))
            z.writestr('06_VISIBLE_ONLY_REVIEW.json',b(make_review_queue(v28report)))
            z.writestr('07_TRANSLATION_SOURCE_BATCH.json',b(source_report or {'schema':'bg-eet-ru-v32-live-dialogue-source-batch-v1','status':'NOT_COLLECTED','game_files_written':False}))
            z.writestr('08_NON_DIALOGUE_SOURCE_BATCH.json',b(nondialogue_report or {'schema':'bg-eet-ru-v33-actual-nondialogue-sources-v1','status':'NOT_COLLECTED','game_files_written':False}))
            if dlg_status is not None:
                z.writestr('09_IWD_BANTER_DLG_STATUS.json',b(dlg_status))
                if dlg_contents is not None:
                    for dlgname,blob in sorted(dlg_contents.items()):
                        if not re.fullmatch(r'[A-Z0-9_]{1,8}',dlgname) or len(blob)>15_000_000 or blob[:4]!=b'DLG ':
                            raise RuntimeError('STOP: invalid captured DLG '+str(dlgname))
                        z.writestr('09_IWD_BANTER_DLG/'+dlgname+'.DLG',blob)
                elif dlg_cache is not None:
                    # Copy only the 61 specifically captured dialogue files, never arbitrary ZIP entries.
                    with zipfile.ZipFile(dlg_cache,'r') as old:
                        approved=dlg_status.get('stored_dialogues',[])
                        if len(approved)>100 or len(set(approved))!=len(approved):
                            raise RuntimeError('STOP: invalid dialogue cache index')
                        for dlgname in approved:
                            if not isinstance(dlgname,str) or not re.fullmatch(r'[A-Z0-9_]{1,8}',dlgname):
                                raise RuntimeError('STOP: invalid cached DLG name')
                            member='09_IWD_BANTER_DLG/'+dlgname+'.DLG'
                            info=old.getinfo(member)
                            if info.file_size>15_000_000:raise RuntimeError('STOP: cached DLG too large')
                            blob=old.read(member)
                            if blob[:4]!=b'DLG ' or digest(blob)!=dlg_status['file_hashes'][dlgname]['sha256']:
                                raise RuntimeError('STOP: cached DLG checksum invalid '+dlgname)
                            z.writestr(member,blob)
            if v36_preflight is not None:
                z.writestr('10_BANTER_COMPILER_PREFLIGHT.json',b(v36_preflight))
            z.writestr('05_README_RU.txt',
                'BG_EET_RU: ЕДИНЫЙ ОТЧЁТ. Только чтение данных игры.\n'
                'ПЕРЕДАТЬ В ЧАТ ОДИН ФАЙЛ: SEND_TO_CHATGPT_BG_EET_RU.zip\n'
                'Видимость текста игроку не доказана; не устанавливать патчи.\n')
        with zipfile.ZipFile(tmp) as z:
            assert z.testzip() is None and set(z.namelist())=={
                '00_STATUS.json','01_V28_DLG_CONTEXT.json','02_V29_BP_PLACEMENT.json',
                '03_ALL_RUNS.log','04_FINGERPRINT.json','05_README_RU.txt',
                '06_VISIBLE_ONLY_REVIEW.json','07_TRANSLATION_SOURCE_BATCH.json',
                '08_NON_DIALOGUE_SOURCE_BATCH.json'} | (
                {'09_IWD_BANTER_DLG_STATUS.json'} | {
                  '09_IWD_BANTER_DLG/'+name+'.DLG' for name in dlg_status.get('stored_dialogues',[])
                 } if dlg_status is not None else set()) | ({'10_BANTER_COMPILER_PREFLIGHT.json'} if v36_preflight is not None else set())
        os.replace(tmp,path)
    finally:
        if tmp.exists():tmp.unlink()




def get_log(path):
    if not path.is_file():return ''
    try:
        with zipfile.ZipFile(path) as z:
            inf=z.getinfo('03_ALL_RUNS.log')
            return z.read(inf).decode('utf-8') if inf.file_size<150_000 else ''
    except (OSError,KeyError,ValueError,zipfile.BadZipFile):return ''




def published_update(path, offline=False):
    """Fetch only the versioned source+SHA256 manifest from the pinned GitHub branch.

    Return (status, activated). Every write stays in WORKDIR, never in game.
    Fail closed (and retain the current updater) for all network and integrity errors.
    """
    if offline:return 'OFFLINE: обновление пропущено',False
    import subprocess
    pending=WORKDIR/'_BG_EET_RU_UPDATE_PENDING.cmd'
    try:
        request=urllib.request.Request(RELEASE_URL,headers={'User-Agent':'BG-EET-RU-onefile/46'})
        with urllib.request.urlopen(request,timeout=12) as response:
            if response.status!=200 or response.url!=RELEASE_URL:
                return 'STOP: некорректный адрес манифеста',False
            raw_manifest=response.read(8193)
        if len(raw_manifest)>8192:return 'STOP: большой манифест',False
        manifest=json.loads(raw_manifest.decode('utf-8'))
        if (manifest.get('schema')!='bg-eet-ru-onefile-release-v1' or
            manifest.get('project')!=UPDATER_ID or
            manifest.get('game_writes_allowed') is not False):
            return 'STOP: канал не гарантирует read-only режим',False
        version=manifest.get('version')
        if type(version) is not int or version<1 or version>9999:
            return 'STOP: неверная версия',False
        if version<=SELF_VERSION:
            return 'АКТУАЛЬНАЯ ВЕРСИЯ v'+str(SELF_VERSION),False
        wanted_sha=manifest.get('sha256')
        if not isinstance(wanted_sha,str) or not re.fullmatch('[0-9a-f]{64}',wanted_sha):
            return 'STOP: неверный SHA256 в манифесте',False
        request=urllib.request.Request(SRC_URL,headers={'User-Agent':'BG-EET-RU-onefile/46'})
        with urllib.request.urlopen(request,timeout=25) as response:
            if response.status!=200 or response.url!=SRC_URL:
                return 'STOP: некорректный адрес исходника',False
            new_source=response.read(750001)
        if not 10000<len(new_source)<=750000 or digest(new_source)!=wanted_sha:
            return 'STOP: скачанный источник не прошёл SHA256',False
        first,sep,body=new_source.partition(b'\n')
        if (not sep or not first.startswith(b'@echo off & py -3 -x ') or
            UPDATER_ID.encode('ascii') not in body or
            (b'SELF_VERSION = '+str(version).encode()) not in body):
            return 'STOP: неверный тип обновлятора',False
        compile(body.decode('utf-8-sig'),'<downloaded-BG-EET-RU>','exec')
        safe_external(Path(DEFAULT_GAME),Path(path))
        if Path(path).resolve()!= (WORKDIR/'BG_EET_RU_UPDATE.cmd').resolve():
            return 'STOP: непостоянный путь обновлятора',False
        # Check new script without opening the real game. Do not publish unusable code.
        pending.write_bytes(new_source)
        if sha_path(pending)!=wanted_sha:
            return 'STOP: промежуточный SHA256 не совпадает',False
        import subprocess
        check=subprocess.run([sys.executable,'-x',str(pending),'--selftest'],
                             cwd=WORKDIR,stdin=subprocess.DEVNULL,
                             capture_output=True,text=True,errors='replace',timeout=75)
        if check.returncode!=0 or 'SELFTEST: PASS' not in check.stdout:
            detail=(check.stderr or check.stdout or 'NO_OUTPUT').strip().replace('\\r',' ').replace('\\n',' | ')
            return 'STOP: самопроверка v'+str(version)+' не пройдена (код '+str(check.returncode)+'): '+detail[-900:],False
        # Back up current updater outside the game BEFORE atomic replacement.
        backup_dir=WORKDIR/'SAFE_BACKUPS'
        backup_dir.mkdir(parents=True,exist_ok=True)
        previous=Path(path)
        if not previous.is_file():return 'STOP: текущий обновлятор отсутствует',False
        previous_sha=sha_path(previous)
        backup=backup_dir/('BG_EET_RU_UPDATE_V'+str(SELF_VERSION)+'_'+previous_sha[:12]+'.cmd')
        if not backup.exists():
            shutil.copy2(previous,backup)
        if sha_path(backup)!=previous_sha:
            return 'STOP: резервная копия не прошла SHA256',False
        if sha_path(pending)!=wanted_sha:
            return 'STOP: источник изменился до замены',False
        os.replace(pending,previous)
        if sha_path(previous)!=wanted_sha:
            # Emergency restore of verified old updater, still outside the game.
            shutil.copy2(backup,previous)
            return 'STOP: контроль после обновления не пройден; прежняя версия возвращена',False
        return 'ОБНОВЛЕНО до v'+str(version)+'; новый код запускается сейчас',True
    except urllib.error.HTTPError as exc:
        return 'ОФЛАЙН: релиз не получен (HTTP '+str(exc.code)+')',False
    except (urllib.error.URLError,TimeoutError,OSError,ValueError,
            UnicodeError,json.JSONDecodeError,subprocess.TimeoutExpired) as exc:
        return 'ОФЛАЙН / ОШИБКА: '+type(exc).__name__+'; текущий файл сохранён',False
    finally:
        try:
            if pending.exists():pending.unlink()
        except OSError:pass



# v34: player dialogue text changes are opt-in only, requiring exact current TLK
# baseline, current DLG linkage, explicit terminal authorization and verified backup.
# The published data is only SHA256 hashes + byte-independent tiny indexed edits,
# not a copy of copyrighted full game text.
V34_PATCH_SOURCE_B64 = ''
V34_PATCH_SHA256 = '8320b331690820a54892dfdedb652a6ebba8a2c459ca34f8998e9f7eefca4dea'
V34_EDIT_DATA_B64 = ''
V34_EDIT_DATA_SHA256 = '86c82466865ef3fba1b93f389149f37628fca29775e9ea035efd8c1cb25f99ef'


def load_v34_patch():
    raw=zlib.decompress(base64.b64decode(V34_PATCH_SOURCE_B64))
    if digest(raw)!=V34_PATCH_SHA256:raise RuntimeError('STOP: v34 patch code checksum mismatch')
    module=types.ModuleType('bg_eet_ru_v34_optin_translation_patch')
    module.__file__=str(Path(__file__).resolve())
    exec(compile(raw.decode('utf8'),module.__file__,'exec'),module.__dict__)
    blob=zlib.decompress(base64.b64decode(V34_EDIT_DATA_B64))
    if digest(blob)!=V34_EDIT_DATA_SHA256:raise RuntimeError('STOP: v34 editorial data checksum mismatch')
    d=json.loads(blob)
    if d.get('schema')!='bg-eet-ru-v34-surgical-15-russian-edits' or len(d.get('entries',[]))!=15:
        raise RuntimeError('STOP: v34 invalid candidate manifest')
    return module,d['entries']






# v35: embedded READ-ONLY IWD EET party-banter DLG collector.
# No separate executable, no modifications under game root.
V35_DLG_COLLECTOR_SHA256 = '20b8d59ac769ed65049631de20557ca0cb7a0736ade10a0f8e362197072721ba'
V35_DLG_COLLECTOR_B64 = ''


def load_v35_collector():
    blob=zlib.decompress(base64.b64decode(V35_DLG_COLLECTOR_B64))
    if digest(blob)!=V35_DLG_COLLECTOR_SHA256:
        raise RuntimeError('STOP: v35 embedded DLG collector SHA mismatch')
    module=types.ModuleType('bg_eet_ru_v35_readonly_dlg_collector')
    module.__file__=str(Path(__file__).resolve())
    exec(compile(blob.decode('utf8'),module.__file__,'exec'),module.__dict__)
    return module




# v37: pinned upstream source fallback for isolated real-WeiDU compile. Never run on the real game.
V36_PREFLIGHT_Z = ''
V36_PREFLIGHT_SHA = '9acf63e0cead004a2431a861ffdf975222fe9ece6ffc86391ad0934560f9bafb'
V36_RU_TRA_Z = ''
V36_RU_TRA_SHA = 'e933c04f8946e23b597ae224b1c15eb5a9a4b97f35f2dbae107472672a6eed9d'


def load_v36_preflight():
    raw=zlib.decompress(base64.b64decode(V36_PREFLIGHT_Z))
    if digest(raw)!=V36_PREFLIGHT_SHA:raise RuntimeError('STOP: v36 module SHA')
    tra=zlib.decompress(base64.b64decode(V36_RU_TRA_Z))
    if digest(tra)!=V36_RU_TRA_SHA:raise RuntimeError('STOP: v36 RU translation SHA')
    m=types.ModuleType('bg_eet_ru_v36_preflight')
    m.__file__=str(Path(__file__).resolve())
    exec(compile(raw.decode('utf8'),m.__file__,'exec'),m.__dict__)
    return m,tra.decode('utf-8-sig')




def main(argv=None):
    p=argparse.ArgumentParser(description='BG_EET_RU one-file visible-only read-only auto-updater')
    p.add_argument('--game',default=DEFAULT_GAME)
    p.add_argument('--offline',action='store_true',help='no GitHub update check')
    p.add_argument('--force',action='store_true',help='ignore result cache, repeat audit')
    p.add_argument('--selftest',action='store_true')
    p.add_argument('--no-open',action='store_true',help='do not open output folder')
    p.add_argument('--no-install-prompt',action='store_true',help='compatibility: skip v34 prompt')
    p.add_argument('--offer-v34-edits',action='store_true',help='explicitly ask about old optional v34 edits')
    p.add_argument('--skip-iwd-dlg',action='store_true',help='skip v35 DLG read-only capture; keep earlier capture if valid')
    p.add_argument('--combat-only',action='store_true',help='v68: capture/cache combat evidence in the existing single ZIP only')
    p.add_argument('--combat-status',action='store_true',help='v71: read status of the single Lua pilot, no changes')
    p.add_argument('--combat-rollback',action='store_true',help='v71: guarded rollback of only the single short Lua pilot')
    args=p.parse_args(argv)
    if args.selftest: return selftest()
    game=Path(args.game).expanduser().resolve()
    safe_external(game,WORKDIR)
    if not game.is_dir() or not (game/'chitin.key').is_file():
        print('STOP: папка игры неверна или chitin.key не найден:',game)
        return 2
    # User requested one persistent location; copy this file there, never inside EET.
    WORKDIR.mkdir(parents=True,exist_ok=True)
    canonical=WORKDIR/'BG_EET_RU_UPDATE.cmd'
    original=Path(__file__).resolve()
    if original!=canonical:
        try:
            existing_version=0
            if canonical.exists():
                head=canonical.read_bytes()[:2500].decode('utf-8','replace')
                match=re.search(r'^SELF_VERSION = ([0-9]+)$',head,re.M)
                existing_version=int(match.group(1)) if match else 0
            if existing_version>SELF_VERSION:
                import subprocess
                print('Запускаю установленную новую версию v'+str(existing_version))
                return subprocess.call([sys.executable,'-x',str(canonical),*sys.argv[1:]])
            if canonical.exists() and existing_version==SELF_VERSION and sha_path(canonical)!=sha_path(original):
                print('STOP: одинаковая версия с разным содержимым. Канонический файл не затронут.')
                return 2
            if not canonical.exists() or existing_version<SELF_VERSION:
                if canonical.exists():
                    backup_dir=WORKDIR/'SAFE_BACKUPS';backup_dir.mkdir(parents=True,exist_ok=True)
                    prev_sha=sha_path(canonical)
                    backup=backup_dir/('BG_EET_RU_UPDATE_V'+str(existing_version)+'_'+prev_sha[:12]+'.cmd')
                    if not backup.exists():shutil.copy2(canonical,backup)
                    if sha_path(backup)!=prev_sha:raise ValueError('bootstrap backup SHA mismatch')
                temp=canonical.with_suffix('.tmp')
                shutil.copy2(original,temp)
                if sha_path(temp)!=sha_path(original):raise ValueError('staged updater checksum mismatch')
                os.replace(temp,canonical)
        except OSError as e:
            print('STOP: не удалось сохранить обновлятор в постоянной папке:',e)
            return 2
    if args.offer_v34_edits:
        print('STOP: BG_EET_RU v44 только для чтения. Установка выключена.')
        return 2
    reviewed_report=None  # v42 does not support live-game installation.
    update_note='НЕ ПРОВЕРЯЛОСЬ'
    if original != canonical and canonical.exists() and sha_path(canonical)!=sha_path(original):
        # The existing version may be newer; the higher-version case is handled above.
        # Different bytes with the same version is ambiguous: do not overwrite it.
        canonical_version=int(re.search(r'^SELF_VERSION = (\d+)$',canonical.read_text('utf-8')[:2500],re.M).group(1))
        if canonical_version==SELF_VERSION:
            print('STOP: одноимённая версия с разным SHA256. Не заменяю.')
            return 2
    update_note, activated = published_update(canonical, args.offline)
    print('Автообновление:',update_note)
    if activated:
        # Use the newly verified version in this same launch. Bounded: new version
        # cannot update itself unless the release manifest has an even newer version.
        import subprocess
        return subprocess.call([sys.executable,'-x',str(canonical),*sys.argv[1:]])
    # v68: if the v67 game snapshot still matches, resume ONLY the new safe stage.
    if args.combat_status or args.combat_rollback:
        if args.combat_rollback:
            return v74_pilot(game,WORKDIR/REPORT_NAME,mode='rollback')
        return v74_pilot(game,WORKDIR/REPORT_NAME,mode='status')
    if args.combat_only or (not args.force and v68_baseline_report_ready(game, WORKDIR/REPORT_NAME)):
        print('v68: предыдущие проверки v67 сохранены; продолжаю с боевого журнала (READ ONLY).')
        rc=v68_combat_evidence(game, WORKDIR/REPORT_NAME)
        if rc: return rc
        rc=v69_static_proof(WORKDIR/REPORT_NAME)
        if rc: return rc
        rc=v70_eeex_loader_diagnostic(game, WORKDIR/REPORT_NAME)
        return rc if rc else v74_pilot(game, WORKDIR/REPORT_NAME, mode='auto')
    print('BG_EET_RU v'+str(SELF_VERSION)+' — один отчёт; изменение игры только при отдельном подтверждении.')
    print('Папка:',WORKDIR)
    print('Проверяю существующие отчёты (без повторных запусков)...')
    v28,v29,targets=load_scanners()
    report_path=WORKDIR/REPORT_NAME
    old=read_archive(report_path)
    print('Сверка контрольных сумм файлов (только чтение)...')
    fp=fingerprints(game,v28)
    if fp.get('chitin.key') is None or fp.get('dialog.tlk') is None or fp.get('dialogf.tlk') is None:
        raise RuntimeError('STOP: не найдены ключевые файлы игры')
    oldfp=old.get('04_FINGERPRINT.json')
    v28report=old.get('01_V28_DLG_CONTEXT.json')
    v29report=old.get('02_V29_BP_PLACEMENT.json')
    used={};notes=[]
    # v27 was superseded by v28; do not need to rerun v27.
    # v29 was already run on 2026-11-16; import that evidence once where available.
    if not args.force and can_reuse(v28report,'bg-eet-ru-v28-dlg-incoming-corrected-readonly',game,fp,oldfp):
        used['v28']='CACHE'
    else:
        print('Проверка v28 (новый этап, только чтение)...')
        v28report=v28.analyze(game,targets)
        used['v28']='LIVE_READ_ONLY'
    legacy=legacy_report('BG_EET_RU_V29_BP_PLACEMENT.json',
                         'bg-eet-ru-v29-blackpits-static-placement-readonly',game)
    if not args.force and can_reuse(v29report,'bg-eet-ru-v29-blackpits-static-placement-readonly',game,fp,oldfp):
        previous=old.get('00_STATUS.json',{})
        used['v29']='CACHE_HISTORICAL' if previous.get('v29_historical') else 'CACHE'
    elif (not args.force and legacy and
          legacy.get('archives') and legacy['archives'][0].get('status')=='INDEXED_RESOURCES_SCANNED' and
          legacy.get('static_placement_count')==0 and
          fp.get('BlackPits.bif')):
        v29report=legacy
        used['v29']='IMPORTED_HISTORICAL'
        notes.append('v29 from prior report; its BlackPits.bif snapshot has no full BIF SHA; treated as historical only.')
    else:
        print('Проверка v29 (только если нет действующего отчёта)...')
        v29report=v29.analyze(game)
        used['v29']='LIVE_READ_ONLY'
    if v28report.get('approved_for_translation'):
        raise RuntimeError('STOP: parser unexpectedly approved translations')
    if v29report.get('translation_approved') is not False:
        raise RuntimeError('STOP: v29 violated visible-only gate')
    # Files can change while scanning; reject if game fingerprint changed.
    after=fingerprints(game,v28)
    if after!=fp:raise RuntimeError('STOP: игровые ресурсы изменились во время проверки; ZIP не обновлён')
    previous_source=old.get('07_TRANSLATION_SOURCE_BATCH.json')
    signature=v32_resource_signature(game)
    tlk_sha={side:fp[side]['sha256'] for side in ('dialog.tlk','dialogf.tlk')}
    if (not args.force and isinstance(previous_source,dict) and
        previous_source.get('schema')=='bg-eet-ru-v32-live-dialogue-source-batch-v1' and
        previous_source.get('source_signature')==signature and
        previous_source.get('game_tlk_sha256')==tlk_sha and
        previous_source.get('game_files_written') is False):
        source_report=previous_source
        used['v32']='CACHE'
    else:
        print('Собираю исходные тексты игровых DLG для быстрого перевода (только чтение)...')
        try:
            source_report=v32_extract(game,fp)
            if v32_resource_signature(game)!=signature:
                raise RuntimeError('DLG/BIF resource changes during scan')
            used['v32']='LIVE_READ_ONLY'
        except Exception as e:
            source_report={'schema':'bg-eet-ru-v32-live-dialogue-source-batch-v1',
                           'status':'READ_ONLY_SCAN_UNAVAILABLE',
                           'error_type':type(e).__name__, 'error':str(e)[:350],
                           'game_files_written':False,'translation_approved':False}
            notes.append('v32 optional scanner unavailable: '+type(e).__name__)
            used['v32']='UNAVAILABLE'
    old_nd=old.get('08_NON_DIALOGUE_SOURCE_BATCH.json')
    sig33=v33_resource_signature(game)
    tlk_sha33={side:fp[side]['sha256'] for side in ('dialog.tlk','dialogf.tlk')}
    if (not args.force and isinstance(old_nd,dict) and
        old_nd.get('schema')=='bg-eet-ru-v33-actual-nondialogue-sources-v1' and
        old_nd.get('source_signature')==sig33 and
        old_nd.get('game_tlk_sha256')==tlk_sha33 and
        old_nd.get('game_files_written') is False and
        old_nd.get('partial') is False):
        nondialogue_report=old_nd
        used['v33']='CACHE'
    else:
        print('Собираю английские названия/описания из ITM/SPL, боевых таблиц и UI (только чтение)...')
        try:
            nondialogue_report=v33_extract(game,fp)
            if v33_resource_signature(game)!=sig33:
                raise RuntimeError('ITM/SPL/UI data changed while collecting')
            used['v33']='LIVE_READ_ONLY'
        except Exception as e:
            nondialogue_report={'schema':'bg-eet-ru-v33-actual-nondialogue-sources-v1',
                'status':'READ_ONLY_SCAN_UNAVAILABLE','error_type':type(e).__name__,
                'error':str(e)[:350],'game_files_written':False,'translation_approved':False}
            used['v33']='UNAVAILABLE'
            notes.append('v33 optional scanner unavailable: '+type(e).__name__)
    # v35: get actual DLG bytes from this installed EET (KEY / override / BIFF),
    # not inferred StrRefs. Preserve the result in the same single ZIP.
    dlgmod=load_v35_collector()
    previous_dlg=old.get('09_IWD_BANTER_DLG_STATUS.json')
    dlg_status=None;dlg_contents=None;dlg_cache=None
    if not args.skip_iwd_dlg:
        print('Сбор необходимых DLG IWD Party Banter (только чтение; один ZIP)...')
        try:
            signature=dlgmod.capture_signature(game)
            reuse=(not args.force and isinstance(previous_dlg,dict) and
                previous_dlg.get('schema')=='bg-eet-ru-v35-iwd-banter-dlg-capture-v1' and
                previous_dlg.get('game_root')==str(game) and
                previous_dlg.get('source_signature')==signature and
                previous_dlg.get('chitin_key_sha256')==fp['chitin.key']['sha256'] and
                previous_dlg.get('game_files_written') is False and
                isinstance(previous_dlg.get('stored_dialogues'),list) and
                len(previous_dlg['stored_dialogues'])==len(dlgmod.WANTED) and
                set(previous_dlg['stored_dialogues'])==set(dlgmod.WANTED) and
                isinstance(previous_dlg.get('file_hashes'),dict))
            if reuse:
                dlg_status=previous_dlg
                dlg_cache=report_path
                used['v35']='CACHE'
            else:
                found,missing,errors=dlgmod.collect(game)
                if dlgmod.capture_signature(game)!=signature:
                    raise RuntimeError('DLG sources changed during capture')
                dlg_contents={name:binary for name,(binary,source) in found.items()}
                dlg_status={
                    'schema':'bg-eet-ru-v35-iwd-banter-dlg-capture-v1',
                    'status':'LIVE_DLG_READONLY', 'created_utc':now(),
                    'game_root':str(game), 'game_files_written':False,
                    'translation_approved':False,
                    'visibility_proven':False,
                    'requested':len(dlgmod.WANTED),'found':len(found),
                    'stored_dialogues':sorted(found),
                    'target_dialogues':sorted(dlgmod.TARGETS),
                    'missing':missing,'errors':errors,
                    'source_signature':signature,
                    'chitin_key_sha256':fp['chitin.key']['sha256'],
                    'file_hashes':{name:{'source':source,'sha256':digest(binary),'size':len(binary)}
                                   for name,(binary,source) in found.items()},
                    'note':'DLG existence alone does not prove a playable branch. No game modifications.',
                }
                used['v35']='LIVE_READ_ONLY'
        except Exception as exc:
            dlg_status={'schema':'bg-eet-ru-v35-iwd-banter-dlg-capture-v1',
                        'status':'READ_ONLY_SCAN_UNAVAILABLE','game_root':str(game),
                        'game_files_written':False,'translation_approved':False,
                        'error_type':type(exc).__name__,'error':str(exc)[:300],
                        'stored_dialogues':[]}
            dlg_contents={}
            used['v35']='UNAVAILABLE'
            notes.append('v35 DLG collector: '+type(exc).__name__)
    elif isinstance(previous_dlg,dict) and previous_dlg.get('stored_dialogues'):
        # Preserve an earlier v35 capture if the user explicitly skips the scan.
        dlg_status=previous_dlg
        dlg_cache=report_path
        used['v35']='PRESERVED_EXISTING'
    else:
        used['v35']='SKIPPED'
    # v46: compile-preflight in a disposable game copy, not the original EET.
    p36,tra36=load_v36_preflight()
    cached36=old.get('10_BANTER_COMPILER_PREFLIGHT.json')
    v36_preflight=None
    safe_cache=(not args.force and isinstance(cached36,dict) and
       cached36.get('schema')==p36.SCHEMA and
       cached36.get('status')=='ISOLATED_COMPILE_PASS_REVIEW_REQUIRED' and
       cached36.get('installation_allowed') is False and
       cached36.get('translation_sha256')==digest(tra36.encode('utf-8')) and
       cached36.get('game_tlk_sha256_before')=={
         n:fp[n]['sha256'] for n in ('dialog.tlk','dialogf.tlk')} and
       isinstance(previous_dlg,dict) and
       previous_dlg.get('source_signature')==dlg_status.get('source_signature'))
    if safe_cache:
        v36_preflight=dict(cached36)
        v36_preflight['status']='ISOLATED_COMPILE_PASS_REVIEW_REQUIRED'
        used['v36']='CACHE'
    else:
        print('Проверяю компиляцию 300 реплик на временной копии (WeiDU, только чтение игры)...')
        v36_preflight=p36.preflight(game,WORKDIR,report_path,tra36,
                                       snapshot_status=dlg_status,
                                       snapshot_blobs=dlg_contents,
                                       collector=dlgmod)
        used['v36']=v36_preflight.get('status','UNKNOWN')
    # No v36 installation mode or opt-in exists yet. It cannot change game files.
    # No game file should be modified by read-only collectors.
    if fingerprints(game,v28)!=fp:
        raise RuntimeError('STOP: game files changed during v35 audit')
    status=summary(v28report,v29report,used,fp,notes)
    if reviewed_report:
        status['v34_reviewed_patch']=reviewed_report
        if reviewed_report.get('status')=='INSTALLED_VERIFIED':
            status['game_files_written']=True
            status['patch_applied']=True
            status['approved_new_text_changes']=reviewed_report.get('installed_text_changes',0)
            status['translation_approved']=True


    status['v35_dlg_capture']=({'status':dlg_status.get('status'),'found':dlg_status.get('found',0),'missing_count':len(dlg_status.get('missing',[])),'errors_count':len(dlg_status.get('errors',[]))} if dlg_status else {'status':'SKIPPED'})
    status['v36_preflight']={'status':v36_preflight.get('status'), 'install_allowed':False, 'compiler_executed':v36_preflight.get('compiler_executed',False)}
    status['v32_sources_ready']=source_report.get('selected_count',0)
    status['v33_nondialogue_candidates']=nondialogue_report.get('all_candidate_count',0)
    status['v33_ui_literals']=len(nondialogue_report.get('ui_source_candidates',[]))
    status['v33_source_status']=used['v33']
    status['v32_source_status']=used['v32']
    status['v29_historical'] = used['v29'] in ('IMPORTED_HISTORICAL','CACHE_HISTORICAL')
    status['game_root']=str(game)
    status['updater_update_check']=update_note
    v56_before=v56_preserve_prior(report_path)
    write_bundle(report_path,status,v28report,v29report,fp,get_log(report_path),source_report,nondialogue_report,dlg_status,dlg_contents,dlg_cache,v36_preflight)
    if fingerprints(game,v28)!=fp:
        raise RuntimeError('STOP: resource fingerprints changed during v56')
    v56_status=v56_static_audit(game,v56_before,report_path)
    print('v56 CRE/ARE/KEY:',v56_status['status'],v56_status['summary'])
    v58_status=v58_local_tp2_bcs_gate(game,report_path)
    print('v58 local TP2/BCS branch:',v58_status['branch_status'],v58_status.get('reason',''))
