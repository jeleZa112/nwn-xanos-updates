 while True:
    if parent.is_symlink():raise ValueError('V111_SYMLINK_RESOURCE_HOLD')
    if parent.resolve()==root:break
    next_parent=parent.parent
    if next_parent==parent:raise ValueError('V111_UNREACHABLE_ROOT_HOLD')
    parent=next_parent
