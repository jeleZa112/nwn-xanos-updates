        continue
      f.seek(base+off)
      data=f.read(n)
      if len(data)!=n:raise ValueError('V111_SHORT_TLK_TEXT')
      try:text=data.decode('utf8','strict')
      except UnicodeDecodeError:
        results[str(ref)]={'status':'NON_UTF8_TLK_TEXT_HOLD',
