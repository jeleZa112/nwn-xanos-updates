@echo off
setlocal
set "XANOS_SELF=%~f0"
powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference='Stop'; [Net.ServicePointManager]::SecurityProtocol=[Net.SecurityProtocolType]::Tls12; $self=$env:XANOS_SELF; $base='https://raw.githubusercontent.com/jeleZa112/nwn-xanos-updates/main'; $stateFile=Join-Path $env:LOCALAPPDATA 'NWN_EPC_RU_PRC\userdir.txt'; $NwnHome=Join-Path $env:USERPROFILE 'Documents\Neverwinter Nights'; if(Test-Path -LiteralPath $stateFile){$s=(Get-Content -LiteralPath $stateFile -Raw).Trim(); if($s){$NwnHome=$s}}; $SupportDir=Join-Path $NwnHome 'EPC_RU_PRC'; $UpdDir=Join-Path $SupportDir 'updater'; $Cache=Join-Path $UpdDir 'cache'; $Backup=Join-Path $UpdDir 'backup'; New-Item -ItemType Directory -Force -Path $UpdDir,$Cache,$Backup|Out-Null; $log=Join-Path $UpdDir 'XANOS_UPDATER.log'; function Log($s){$line=('['+(Get-Date -Format 'yyyy-MM-dd HH:mm:ss')+'] '+$s); Add-Content -LiteralPath $log -Value $line -Encoding UTF8; Write-Host $s}; try { Log 'XANOS updater: checking latest version...'; $manifestUrl=$base+'/latest.json?ts='+[DateTimeOffset]::UtcNow.ToUnixTimeSeconds(); $m=(Invoke-WebRequest -UseBasicParsing -Uri $manifestUrl -Headers @{'Cache-Control'='no-cache'} -TimeoutSec 30).Content | ConvertFrom-Json; if(!$m.version -or !$m.payload_url -or !$m.sha256){throw 'Invalid latest.json manifest.'}; $ver=[string]$m.version; $payloadUrl=[string]$m.payload_url; $sha=([string]$m.sha256).ToLowerInvariant(); $safe=($ver -replace '[^0-9A-Za-z._-]','_'); $payload=Join-Path $Cache ('XANOS_PAYLOAD_'+$safe+'.cmd'); $part=$payload+'.part'; $need=$true; if(Test-Path -LiteralPath $payload){$h=(Get-FileHash -Algorithm SHA256 -LiteralPath $payload).Hash.ToLowerInvariant(); if($h -eq $sha){$need=$false}}; if($need){Log ('Downloading Xanos '+$ver+' ...'); if(Test-Path $part){Remove-Item $part -Force}; Invoke-WebRequest -UseBasicParsing -Uri ($payloadUrl+'?ts='+[DateTimeOffset]::UtcNow.ToUnixTimeSeconds()) -OutFile $part -Headers @{'Cache-Control'='no-cache'} -TimeoutSec 60; $h=(Get-FileHash -Algorithm SHA256 -LiteralPath $part).Hash.ToLowerInvariant(); if($h -ne $sha){Remove-Item $part -Force -ErrorAction SilentlyContinue; throw ('SHA256 mismatch. Expected '+$sha+', got '+$h)}; Move-Item -Force $part $payload}; $last=Join-Path $UpdDir 'last_successful_payload.cmd'; $lastver=Join-Path $UpdDir 'last_successful_version.txt'; Log ('Running '+$ver+' ...'); $p=Start-Process cmd.exe -ArgumentList @('/d','/c','call',('"'+$payload+'"')) -Wait -PassThru; if($p.ExitCode -ne 0){Log ('Update failed with code '+$p.ExitCode); if(Test-Path -LiteralPath $last){$lv='previous'; if(Test-Path $lastver){$lv=(Get-Content $lastver -Raw).Trim()}; Log ('Automatic rollback: '+$lv); $rp=Start-Process cmd.exe -ArgumentList @('/d','/c','call',('"'+$last+'"')) -Wait -PassThru; exit $rp.ExitCode}; Copy-Item -LiteralPath $payload -Destination $last -Force; Set-Content -LiteralPath $lastver -Value $ver -Encoding ASCII; Set-Content -LiteralPath (Join-Path $UpdDir 'current_version.txt') -Value $ver -Encoding ASCII; Log ('OK: '+$ver+' installed/launched.'); exit 0 } catch { Log ('ERROR: '+$_.Exception.Message); if(Test-Path -LiteralPath (Join-Path $UpdDir 'last_successful_payload.cmd')){Log 'Trying last successful build...'; $rp=Start-Process cmd.exe -ArgumentList @('/d','/c','call',('"'+(Join-Path $UpdDir 'last_successful_payload.cmd')+'"')) -Wait -PassThru; exit $rp.ExitCode}; exit 1 }"
set "RC=%ERRORLEVEL%"
if not "%RC%"=="0" (
  echo.
  echo XANOS updater failed. Log: %%USERPROFILE%%\Documents\Neverwinter Nights\EPC_RU_PRC\updater\XANOS_UPDATER.log
  pause
)
exit /b %RC%
