  $oldCombatReturn=@'
    XAI_ReadLiveCommand();
    if(GetLocalInt(OBJECT_SELF,"AI_TURNED_OFF")||!bCombatState) return;
'@
  $newCombatReturn=@'
    XAI_ReadLiveCommand();

    // 0.8.6.6: stale legacy stop flags must never disable a companion already in AUTO.
    if (GetLocalInt(OBJECT_SELF, "XAI_AUTONOMOUS_MODE") &&
        !GetLocalInt(OBJECT_SELF, "XAI_FOLLOW_LOCK") &&
        !GetLocalInt(OBJECT_SELF, "XAI_WEAPON_ONLY_V0799"))
        DeleteLocalInt(OBJECT_SELF, "AI_TURNED_OFF");
    if(GetLocalInt(OBJECT_SELF,"AI_TURNED_OFF")) return;

    // 0.8.6.6: universal companion target bootstrap.
    // This repairs the regression introduced when XAI stopped being Xanos-only:
    // a henchman can be in AUTO with a visible hostile but the legacy selector may
    // leave oTarget/bCombatState empty. Seed one real engine attack so subsequent
    // ticks and xai_combat inherit a valid GetAttackTarget().
    if ((!GetIsObjectValid(oTarget) || GetCurrentHitPoints(oTarget) <= 0) &&
        !GetLocalInt(OBJECT_SELF, "XAI_FOLLOW_LOCK"))
    {
        object oAcquire = XAI_AcquireVisibleEnemy0864();
        if (GetIsObjectValid(oAcquire))
        {
            oTarget = oAcquire;
            bCombatState = TRUE;

            string sAcquireState = GetLocalString(OBJECT_SELF, XAI_LAST_ACTION_VAR);
            int bAcquirePrebuff = sAcquireState == "PREBUFF" || sAcquireState == "PREBUFF_FULL";

            // 0.8.6.10: acquisition means combat owns the queue NOW. Do not wait for
            // ACTION_INVALID: utility/follow/prebuff can otherwise keep Dorna idle while
            // the rest of the party is already fighting.
            ClearAllActions();
            XAI_LockAction(0);
            DeleteLocalInt(OBJECT_SELF, "XAI_PREBUFF_FULL");
            DeleteLocalInt(OBJECT_SELF, "XAI_PREBUFF_RESUME_GUARD_0865");
            SetLocalInt(OBJECT_SELF, "XAI_AUTONOMOUS_MODE", TRUE);
            DeleteLocalInt(OBJECT_SELF, "XAI_FOLLOW_LOCK");
            DeleteLocalInt(OBJECT_SELF, "XAI_WEAPON_ONLY_V0799");
            ActionAttack(oAcquire);
            XAI_SetLastAction("AUTO_ACQUIRE_TARGET");
            return;
        }
    }

    if(!bCombatState)
    {
        if (XAI_TryAutoHeal083(FALSE, nTick)) return;
        ExecuteScript("xai_utility", OBJECT_SELF);
        return;
    }

    SetLocalInt(OBJECT_SELF, "XAI_UTILITY_AFTER_COMBAT_082", TRUE);
    DeleteLocalInt(OBJECT_SELF, "XAI_UTILITY_IDLE_082");

    // Utility work is strictly out-of-combat. If a fight begins while a trap/lock
    // action is queued, combat cancels it before any other tactical decision.
    string sBeforeCombat = GetLocalString(OBJECT_SELF, "XAI_LAST_ACTION");
    if (sBeforeCombat == "DISARM_TRAP" || sBeforeCombat == "OPEN_LOCK")
    {
        ClearAllActions();
        XAI_LockAction(0);
        DeleteLocalInt(OBJECT_SELF, "XAI_UTILITY_COOLDOWN_082");
        XAI_SetLastAction("COMBAT_REPLAN");
        sBeforeCombat = "COMBAT_REPLAN";
    }

    // A prebuff queue is strictly out-of-combat. If a hostile appears, combat owns
    // the action queue immediately instead of waiting for every queued buff to finish.
    if (GetIsObjectValid(oTarget) &&
        (sBeforeCombat == "PREBUFF" || sBeforeCombat == "PREBUFF_FULL"))
    {
        ClearAllActions();
        XAI_LockAction(0);
        DeleteLocalInt(OBJECT_SELF, "XAI_PREBUFF_FULL");
        XAI_SetLastAction("COMBAT_REPLAN");
    }

    // Hard priority: healing/survival before Turn Undead, parry or attacks.
    if (XAI_TryAutoHeal083(TRUE, nTick)) return;
    if (XAI_TryTurnUndead082(oTarget, nTick)) return;
    if (XAI_TryParry082(oTarget, nEnemies)) return;

    // Hard recovery: a valid combat target plus an empty engine action queue must
    // never leave the companion standing still. Re-enter the proven combat planner now.
    if (GetIsObjectValid(oTarget) && GetCurrentAction(OBJECT_SELF) == ACTION_INVALID)
    {
        ExecuteScript("xai_combat", OBJECT_SELF);
        return;
    }
'@
  $tickText=Replace-Required $tickText $oldCombatReturn $newCombatReturn 'out-of-combat utility and cleric/rogue priorities'

  $oldReplan=@'
    int nTargetAction=GetCurrentAction(oTarget);
    int bCasterCasting=XAI_IsCaster(oTarget) &&
        (nTargetAction==ACTION_CASTSPELL || nTargetAction==ACTION_ITEMCASTSPELL);
    int bEmergency=(XAI_HPPercent(OBJECT_SELF)<=25);

    // V0.7: do not tear up the action queue every 2 seconds.
    // Force a re-plan only on target changes, emergencies, or an enemy caster
    // actively starting a spell. Normal combat rounds keep flowing untouched.
    if(bTargetChanged || bEmergency || (bCasterCasting && (nTick%3)==0))
'@
  $newReplan=@'
    int nTargetAction=GetCurrentAction(oTarget);
    int bCasterCasting=XAI_IsCaster(oTarget) &&
        (nTargetAction==ACTION_CASTSPELL || nTargetAction==ACTION_ITEMCASTSPELL);
    int bEmergency=(XAI_HPPercent(OBJECT_SELF)<=25);

    // 0.8.6 watchdog: equipment switches and engine AI can occasionally eat the
    // queued ActionAttack. The old target remains valid and the panel keeps the
    // last planned action, so without this guard the companion can stand idle forever.
    // Action locks are checked above, so ACTION_INVALID here means it is safe to retry.
    int bCombatIdle=(GetCurrentAction(OBJECT_SELF)==ACTION_INVALID);

    // Keep normal combat rounds untouched, but re-plan a genuinely idle combatant.
    if(bTargetChanged || bEmergency || (bCasterCasting && (nTick%3)==0) ||
       (bCombatIdle && (nTick%2)==0))
'@
  $tickText=Replace-Required $tickText $oldReplan $newReplan 'combat idle watchdog'


  [IO.File]::WriteAllBytes($tickPath,$cp1251.GetBytes($tickText))
 }

 $prebuffPath=Join-Path $Src 'xai_prebuff.nss'
 if(Test-Path -LiteralPath $prebuffPath){
  $prebuffText=$cp1251.GetString([IO.File]::ReadAllBytes($prebuffPath))
  $prebuffText=$prebuffText.Replace('КСАНОС ИИ: обкаст отменён — рядом враг или уже идёт бой.','СПУТНИК ИИ: обкаст отменён — рядом враг или уже идёт бой.')
  $prebuffText=$prebuffText.Replace('КСАНОС ИИ: подходящих известных заклинаний для обкаста сейчас нет.','СПУТНИК ИИ: среди реально подготовленных/доступных заклинаний подходящих бафов сейчас нет.')
  $prebuffText=$prebuffText.Replace('КСАНОС ИИ: поставлено в очередь действий: ','СПУТНИК ИИ: поставлено в очередь бафов: ')
  $prebuffText=$prebuffText.Replace(' (полная подготовка).',' (полный обкаст).')
