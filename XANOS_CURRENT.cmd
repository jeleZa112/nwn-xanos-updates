 $oldIsXanos=@'
int XAI_IsXanos(object oCreature)
{
    if (!GetIsObjectValid(oCreature) || GetObjectType(oCreature) != OBJECT_TYPE_CREATURE)
        return FALSE;

    if (XAI_IsNamedXanos(oCreature))
        return TRUE;

    // Safe fallback for the stock SoU Xanos build when he is already an associate.
    if (GetLevelByClass(CLASS_TYPE_SORCERER, oCreature) > 0 &&
        GetLevelByClass(CLASS_TYPE_BARBARIAN, oCreature) > 0)
        return TRUE;

    return FALSE;
}
'@
 $newIsXanos=@'
int XAI_IsXanos(object oCreature)
{
    if (!GetIsObjectValid(oCreature) || GetObjectType(oCreature) != OBJECT_TYPE_CREATURE)
        return FALSE;

    object oMaster = GetMaster(oCreature);
    if (!GetIsObjectValid(oMaster) || !GetIsPC(oMaster)) return FALSE;

    // Never attach companion AI to engine associates.
    int i;
    for (i = 1; i <= 10; i++)
    {
        object oA = GetAssociate(ASSOCIATE_TYPE_FAMILIAR, oMaster, i);
        if (GetIsObjectValid(oA) && oA == oCreature) return FALSE;
        oA = GetAssociate(ASSOCIATE_TYPE_ANIMALCOMPANION, oMaster, i);
        if (GetIsObjectValid(oA) && oA == oCreature) return FALSE;
        oA = GetAssociate(ASSOCIATE_TYPE_SUMMONED, oMaster, i);
        if (GetIsObjectValid(oA) && oA == oCreature) return FALSE;
        oA = GetAssociate(ASSOCIATE_TYPE_DOMINATED, oMaster, i);
        if (GetIsObjectValid(oA) && oA == oCreature) return FALSE;
    }

    // PRC PnP familiar is internally added as a henchman in custom familiar slot 3.
    string sFamSlot = IntToString(ASSOCIATE_TYPE_FAMILIAR) + "oHench3";
    object oPrcFam = GetLocalObject(oMaster, sFamSlot);
    if (GetIsObjectValid(oPrcFam) && oPrcFam == oCreature) return FALSE;

    for (i = 1; i <= 10; i++)
    {
        object oH = GetAssociate(ASSOCIATE_TYPE_HENCHMAN, oMaster, i);
        if (GetIsObjectValid(oH) && oH == oCreature) return TRUE;
    }
    return FALSE;
}
'@
 $coreText=Replace-Required $coreText $oldIsXanos $newIsXanos 'universal henchman identity'

 $oldFind=@'
object XAI_FindXanosForPC(object oPC)
{
    if (!GetIsObjectValid(oPC)) return OBJECT_INVALID;
    int i;
    for (i=1; i<=10; i++)
    {
        object oH = GetAssociate(ASSOCIATE_TYPE_HENCHMAN, oPC, i);
        if (!GetIsObjectValid(oH)) break;
        if (XAI_IsXanos(oH)) return oH;
    }
    object oArea = GetArea(oPC);
    if (GetIsObjectValid(oArea))
    {
        object o = GetFirstObjectInArea(oArea);
        while (GetIsObjectValid(o))
        {
            if (XAI_IsNamedXanos(o)) return o;
            o = GetNextObjectInArea(oArea);
        }
    }
    return OBJECT_INVALID;
}

void XAI_InitAll()
{
    object oPC = GetFirstPC();
    while (GetIsObjectValid(oPC))
    {
        object oXanos = XAI_FindXanosForPC(oPC);
        if (GetIsObjectValid(oXanos)) XAI_Attach(oXanos, oPC);
        oPC = GetNextPC();
    }
}
'@
 $newFind=@'
object XAI_FindXanosForPC(object oPC)
{
    if (!GetIsObjectValid(oPC) || !GetIsPC(oPC)) return OBJECT_INVALID;

    object oSel = GetLocalObject(oPC, "XAI_SELECTED_COMPANION");
    if (XAI_IsXanos(oSel) && GetMaster(oSel) == oPC) return oSel;

    int i;
    for (i = 1; i <= 10; i++)
    {
        object oH = GetAssociate(ASSOCIATE_TYPE_HENCHMAN, oPC, i);
        if (GetIsObjectValid(oH))
        {
            SetLocalObject(oPC, "XAI_SELECTED_COMPANION", oH);
            return oH;
        }
    }
    return OBJECT_INVALID;
}

void XAI_InitAll()
{
    object oPC = GetFirstPC();
    while (GetIsObjectValid(oPC))
    {
        object oSelected = GetLocalObject(oPC, "XAI_SELECTED_COMPANION");
        int bHaveSelected = XAI_IsXanos(oSelected);

        int i;
        for (i = 1; i <= 10; i++)
        {
            object oH = GetAssociate(ASSOCIATE_TYPE_HENCHMAN, oPC, i);
            if (!GetIsObjectValid(oH) || !XAI_IsXanos(oH)) continue;

            if (!bHaveSelected)
            {
                SetLocalObject(oPC, "XAI_SELECTED_COMPANION", oH);
                bHaveSelected = TRUE;
            }

            XAI_Attach(oH, oPC);

            if (!GetLocalInt(oH, "XAI_AUTONOMOUS_MODE") &&
                !GetLocalInt(oH, "XAI_FOLLOW_LOCK") &&
                !GetLocalInt(oH, "XAI_WEAPON_ONLY_V0799"))
                SetLocalInt(oH, "XAI_AUTONOMOUS_MODE", TRUE);
        }
        oPC = GetNextPC();
    }
}
