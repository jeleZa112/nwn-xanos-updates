int XAI_TryAutoHeal083(int bCombat, int nTick)
{
    object oMaster = GetLocalObject(OBJECT_SELF, "XAI_MASTER");
    if (!GetIsObjectValid(oMaster)) oMaster = GetMaster(OBJECT_SELF);

    int nSelfHP = XAI_HPPercent(OBJECT_SELF);
    int nMasterHP = 100;
    if (GetIsObjectValid(oMaster) && GetIsPC(oMaster))
        nMasterHP = XAI_HPPercent(oMaster);

    object oHeal = OBJECT_INVALID;

    if (bCombat)
    {
        // 0.8.6.28: threat-aware healing. Keep the proven baseline thresholds,
        // but react earlier when the companion or master is under real local pressure.
        int nSelfThreats = XAI_EnemyCountNear(GetLocation(OBJECT_SELF), 5.0);
        int nMasterThreats = 0;
        if (GetIsObjectValid(oMaster) && GetArea(oMaster) == GetArea(OBJECT_SELF))
            nMasterThreats = XAI_EnemyCountNear(GetLocation(oMaster), 5.0);

        int nSelfTrigger = 60;
        if (nSelfThreats >= 2) nSelfTrigger = 66;
        if (nSelfThreats >= 3) nSelfTrigger = 72;

        int nMasterTrigger = 45;
        if (nMasterThreats >= 2) nMasterTrigger = 52;
        if (nMasterThreats >= 3) nMasterTrigger = 58;

        if (nSelfHP <= nSelfTrigger)
            oHeal = OBJECT_SELF;
        else if (GetIsObjectValid(oMaster) && nMasterHP <= nMasterTrigger &&
                 GetDistanceBetween(OBJECT_SELF, oMaster) <= 15.0)
            oHeal = oMaster;
    }
    else
    {
        // After combat: patch meaningful wounds before traps/locks/stealth work.
        if (nSelfHP <= 75)
            oHeal = OBJECT_SELF;

        if (GetIsObjectValid(oMaster) && nMasterHP <= 75 &&
            GetDistanceBetween(OBJECT_SELF, oMaster) <= 15.0 &&
            (!GetIsObjectValid(oHeal) || nMasterHP < nSelfHP))
            oHeal = oMaster;
    }

    if (!GetIsObjectValid(oHeal)) return FALSE;

    // Do not tear up an already committed heal/cast/use-item action.
    int a = GetCurrentAction(OBJECT_SELF);
    if (a == ACTION_CASTSPELL || a == ACTION_ITEMCASTSPELL ||
        a == ACTION_HEAL || a == ACTION_USEOBJECT)
        return TRUE;

    int nLast = GetLocalInt(OBJECT_SELF, "XAI_HEAL_LAST_TICK_083");
    if (nLast > 0 && nTick - nLast < 4) return FALSE;

    // Native NWN talent layer knows cleric cures (including spontaneous cleric healing)
    // and other available healing magic.
    if (TalentHeal(TRUE, oHeal))
    {
        SetLocalInt(OBJECT_SELF, "XAI_HEAL_LAST_TICK_083", nTick);
        XAI_LockAction(3);
        if (oHeal == OBJECT_SELF) XAI_SetLastAction("AUTO_HEAL_SELF");
        else XAI_SetLastAction("AUTO_HEAL_MASTER");
        return TRUE;
    }

    // Fallback: use a healer's kit if one is actually in inventory.
    object oItem = GetFirstItemInInventory(OBJECT_SELF);
    while (GetIsObjectValid(oItem))
    {
        if (GetStringLeft(GetResRef(oItem), 12) == "nw_it_medkit")
        {
            ClearAllActions();
            ActionUseItemOnObject(oItem, GetFirstItemProperty(oItem), oHeal);
            SetLocalInt(OBJECT_SELF, "XAI_HEAL_LAST_TICK_083", nTick);
            XAI_LockAction(3);
            if (oHeal == OBJECT_SELF) XAI_SetLastAction("AUTO_HEAL_SELF");
            else XAI_SetLastAction("AUTO_HEAL_MASTER");
            return TRUE;
        }
        oItem = GetNextItemInInventory(OBJECT_SELF);
    }

    // No resource available: do not rescan every second forever.
    SetLocalInt(OBJECT_SELF, "XAI_HEAL_LAST_TICK_083", nTick + 6);
    return FALSE;
}

int XAI_AcquireTargetValid08610(object o)
{
    if (!GetIsObjectValid(o) || GetObjectType(o) != OBJECT_TYPE_CREATURE) return FALSE;
    if (GetCurrentHitPoints(o) <= 0 || GetIsDead(o)) return FALSE;
    if (GetArea(o) != GetArea(OBJECT_SELF)) return FALSE;
    if (!GetIsEnemy(o, OBJECT_SELF)) return FALSE;
    if (GetDistanceBetween(OBJECT_SELF, o) > 40.0) return FALSE;
    return TRUE;
}

object XAI_AcquireVisibleEnemy0864()
{
    // First use Dorna's own engine combat state, including the creature that just hit her.
    object o = GetAttackTarget(OBJECT_SELF);
    if (XAI_AcquireTargetValid08610(o)) return o;

    o = GetLastAttacker(OBJECT_SELF);
    if (XAI_AcquireTargetValid08610(o)) return o;

    object oMaster = GetLocalObject(OBJECT_SELF, "XAI_MASTER");
    if (!GetIsObjectValid(oMaster)) oMaster = GetMaster(OBJECT_SELF);

    if (GetIsObjectValid(oMaster))
    {
        o = GetAttackTarget(oMaster);
        if (XAI_AcquireTargetValid08610(o)) return o;

        o = GetLastAttacker(oMaster);
        if (XAI_AcquireTargetValid08610(o)) return o;

        // Universal companions must join PARTY combat. 0.8.6.9 could stand idle while
        // Plada/Bain Kai fought because neither Dorna nor the master had a momentary
        // GetAttackTarget(). Adopt a nearby faction member's target/attacker.
        object oParty = GetFirstFactionMember(oMaster, FALSE);
        while (GetIsObjectValid(oParty))
        {
            if (oParty != OBJECT_SELF)
            {
                o = GetAttackTarget(oParty);
                if (XAI_AcquireTargetValid08610(o)) return o;

                o = GetLastAttacker(oParty);
                if (XAI_AcquireTargetValid08610(o)) return o;
            }
            oParty = GetNextFactionMember(oMaster, FALSE);
        }
    }

    // Last fallback remains direct perception.
    o = GetNearestCreature(CREATURE_TYPE_REPUTATION, REPUTATION_TYPE_ENEMY,
                           OBJECT_SELF, 1,
                           CREATURE_TYPE_PERCEPTION, PERCEPTION_SEEN,
                           CREATURE_TYPE_IS_ALIVE, TRUE);
    if (XAI_AcquireTargetValid08610(o)) return o;

    return OBJECT_INVALID;
}

int XAI_TargetValid08628(object o, object oMaster)
{
    if (!GetIsObjectValid(o) || GetObjectType(o) != OBJECT_TYPE_CREATURE) return FALSE;
    if (GetCurrentHitPoints(o) <= 0 || GetIsDead(o)) return FALSE;
    if (GetArea(o) != GetArea(OBJECT_SELF)) return FALSE;
    if (!GetIsEnemy(o, OBJECT_SELF)) return FALSE;
    if (GetDistanceBetween(OBJECT_SELF, o) > 40.0) return FALSE;

    if (GetIsObjectValid(oMaster) && GetArea(oMaster) == GetArea(OBJECT_SELF) &&
        GetDistanceBetween(oMaster, o) > 45.0)
        return FALSE;

    return TRUE;
}

int XAI_TargetActivelyCasting08628(object o)
{
    if (!GetIsObjectValid(o) || !XAI_IsCaster(o)) return FALSE;
    int a = GetCurrentAction(o);
    return a == ACTION_CASTSPELL || a == ACTION_ITEMCASTSPELL;
}

int XAI_TargetHighThreat08628(object o)
{
    if (!GetIsObjectValid(o)) return FALSE;
    if (XAI_IsCaster(o)) return TRUE;

    float fSelfCR = GetChallengeRating(OBJECT_SELF);
    float fTargetCR = GetChallengeRating(o);
    if (fSelfCR > 0.0 && fTargetCR >= fSelfCR * 1.20) return TRUE;
    if (GetHitDice(o) >= GetHitDice(OBJECT_SELF) + 2) return TRUE;
    if (GetMaxHitPoints(o) * 2 >= GetMaxHitPoints(OBJECT_SELF) * 3) return TRUE;
    return FALSE;
}

void XAI_SetStickyTarget08628(object o, int nTick)
{
    if (!GetIsObjectValid(o)) return;
    SetLocalObject(OBJECT_SELF, "XAI_STICKY_TARGET_08628", o);
    SetLocalInt(OBJECT_SELF, "XAI_STICKY_SINCE_08628", nTick);
}

void XAI_ClearStickyTarget08628()
{
    DeleteLocalObject(OBJECT_SELF, "XAI_STICKY_TARGET_08628");
    DeleteLocalInt(OBJECT_SELF, "XAI_STICKY_SINCE_08628");
}

object XAI_CoordinatedTarget08628(object oCurrent, object oMaster, int nTick)
{
    object oSticky = GetLocalObject(OBJECT_SELF, "XAI_STICKY_TARGET_08628");
    if (!XAI_TargetValid08628(oSticky, oMaster))
    {
        XAI_ClearStickyTarget08628();
        oSticky = OBJECT_INVALID;
    }

    object oSelfAttacker = GetLastAttacker(OBJECT_SELF);
    object oMasterTarget = OBJECT_INVALID;
    object oMasterAttacker = OBJECT_INVALID;
    if (GetIsObjectValid(oMaster) && GetArea(oMaster) == GetArea(OBJECT_SELF))
    {
        oMasterTarget = GetAttackTarget(oMaster);
        oMasterAttacker = GetLastAttacker(oMaster);
    }

    // Immediate self-defense can break target lock.
    if (XAI_TargetValid08628(oSelfAttacker, oMaster) &&
        GetDistanceBetween(OBJECT_SELF, oSelfAttacker) <= 5.0 &&
        oSelfAttacker != oSticky)
    {
        XAI_SetStickyTarget08628(oSelfAttacker, nTick);
        return oSelfAttacker;
    }

    // An enemy actively casting is a legitimate interrupt target.
    object oCaster = OBJECT_INVALID;
    if (XAI_TargetValid08628(oCurrent, oMaster) && XAI_TargetActivelyCasting08628(oCurrent))
        oCaster = oCurrent;
    if (XAI_TargetValid08628(oMasterTarget, oMaster) && XAI_TargetActivelyCasting08628(oMasterTarget))
        oCaster = oMasterTarget;
    if (XAI_TargetValid08628(oMasterAttacker, oMaster) && XAI_TargetActivelyCasting08628(oMasterAttacker))
        oCaster = oMasterAttacker;
    if (GetIsObjectValid(oCaster) && oCaster != oSticky)
    {
        XAI_SetStickyTarget08628(oCaster, nTick);
        return oCaster;
    }

    // A clearly dangerous creature actively pressuring the master can also break
    // a low-priority lock, but not when the current target is already almost dead.
    if (XAI_TargetValid08628(oMasterAttacker, oMaster) &&
        GetDistanceBetween(oMaster, oMasterAttacker) <= 7.0 &&
        XAI_TargetHighThreat08628(oMasterAttacker) &&
        (!GetIsObjectValid(oSticky) || XAI_HPPercent(oSticky) > 20) &&
        (!GetIsObjectValid(oSticky) || !XAI_TargetHighThreat08628(oSticky)))
    {
        XAI_SetStickyTarget08628(oMasterAttacker, nTick);
        return oMasterAttacker;
    }

    if (GetIsObjectValid(oSticky))
    {
        // Finish a nearly dead target instead of target-flapping.
        if (XAI_HPPercent(oSticky) <= 20) return oSticky;

        // Usually hold a target for several seconds. After that, follow Bain Kai's
        // current target, with a faster handoff to a clearly more dangerous threat.
        if (XAI_TargetValid08628(oMasterTarget, oMaster) && oMasterTarget != oSticky)
        {
            int nSince = GetLocalInt(OBJECT_SELF, "XAI_STICKY_SINCE_08628");
            int nAge = nTick - nSince;
            if ((nAge >= 3 && XAI_TargetHighThreat08628(oMasterTarget) &&
                 !XAI_TargetHighThreat08628(oSticky)) ||
                nAge >= 8)
            {
                XAI_SetStickyTarget08628(oMasterTarget, nTick);
                return oMasterTarget;
            }
        }
        return oSticky;
    }

    object oPick = OBJECT_INVALID;
    if (XAI_TargetValid08628(oMasterTarget, oMaster))
        oPick = oMasterTarget;
    else if (XAI_TargetValid08628(oCurrent, oMaster))
        oPick = oCurrent;
    else if (XAI_TargetValid08628(oMasterAttacker, oMaster))
        oPick = oMasterAttacker;
    else if (XAI_TargetValid08628(oSelfAttacker, oMaster))
        oPick = oSelfAttacker;

    if (GetIsObjectValid(oPick)) XAI_SetStickyTarget08628(oPick, nTick);
    return oPick;
}

int XAI_ShouldRegroupCombat08628(object oTarget, object oMaster)
{
    if (!GetIsObjectValid(oMaster) || !GetIsPC(oMaster)) return FALSE;
    if (!GetIsObjectValid(oTarget)) return FALSE;
    if (GetArea(oMaster) != GetArea(OBJECT_SELF) || GetArea(oTarget) != GetArea(OBJECT_SELF))
        return FALSE;

    float fSelfFromMaster = GetDistanceBetween(OBJECT_SELF, oMaster);
    if (fSelfFromMaster <= 12.0) return FALSE;

    float fTargetFromMaster = GetDistanceBetween(oMaster, oTarget);
    object oMasterTarget = GetAttackTarget(oMaster);
    float fLimit = (oMasterTarget == oTarget) ? 40.0 : 28.0;
    return fTargetFromMaster > fLimit;
}

int XAI_PostCombatHousekeeping08628(object oMaster, int nTick)
{
    XAI_ClearStickyTarget08628();
    DeleteLocalInt(OBJECT_SELF, "XAI_COMBAT_IDLE_STREAK_08628");

    // Remove only a shield that AUTO itself marked as a crowd-survival shield.
    if (GetLocalInt(OBJECT_SELF, "XAI_CROWD_SHIELD_ACTIVE"))
    {
        object oLeft = GetItemInSlot(INVENTORY_SLOT_LEFTHAND, OBJECT_SELF);
        DeleteLocalInt(OBJECT_SELF, "XAI_CROWD_SHIELD_ACTIVE");
        if (XAI_IsShieldItem(oLeft))
        {
            ClearAllActions();
            XAI_LockAction(2);
            ActionUnequipItem(oLeft);
            XAI_SetLastAction("AUTO_SHIELD_OFF");
            return TRUE;
        }
    }

    // Explicitly regroup after battle instead of leaving a companion at the last kill.
    if (GetIsObjectValid(oMaster) && GetIsPC(oMaster) &&
        GetArea(oMaster) == GetArea(OBJECT_SELF) &&
        GetDistanceBetween(OBJECT_SELF, oMaster) > 12.0)
    {
        int a = GetCurrentAction(OBJECT_SELF);
        if (a == ACTION_CASTSPELL || a == ACTION_ITEMCASTSPELL ||
            a == ACTION_HEAL || a == ACTION_USEOBJECT)
            return TRUE;

        int nRetry = GetLocalInt(OBJECT_SELF, "XAI_REGROUP_RETRY_08628");
        if (nTick >= nRetry)
        {
            ClearAllActions();
            ActionMoveToObject(oMaster, TRUE, 4.0);
            SetLocalInt(OBJECT_SELF, "XAI_REGROUP_RETRY_08628", nTick + 3);
            XAI_SetLastAction("AUTO_RETREAT_REGROUP");
        }
        return TRUE;
    }

    DeleteLocalInt(OBJECT_SELF, "XAI_REGROUP_RETRY_08628");
    return FALSE;
}

int XAI_TickUndeadCount(float fRadius)
{
    int n = 0;
    object o = GetFirstObjectInShape(SHAPE_SPHERE, fRadius, GetLocation(OBJECT_SELF), TRUE, OBJECT_TYPE_CREATURE);
    while (GetIsObjectValid(o))
    {
        if (o != OBJECT_SELF && GetCurrentHitPoints(o) > 0 &&
            GetIsEnemy(o, OBJECT_SELF) && GetRacialType(o) == RACIAL_TYPE_UNDEAD)
            n++;
        o = GetNextObjectInShape(SHAPE_SPHERE, fRadius, GetLocation(OBJECT_SELF), TRUE, OBJECT_TYPE_CREATURE);
    }
    return n;
}

int XAI_TryTurnUndead082(object oTarget, int nTick)
{
    if (!GetHasFeat(FEAT_TURN_UNDEAD, OBJECT_SELF, TRUE)) return FALSE;
    if (GetFeatRemainingUses(FEAT_TURN_UNDEAD, OBJECT_SELF) <= 0) return FALSE;
    int nLast = GetLocalInt(OBJECT_SELF, "XAI_TURN_LAST_TICK_082");
    if (nLast > 0 && nTick - nLast < 8) return FALSE;

    int nUndead = XAI_TickUndeadCount(12.0);
    int bHardSingle = GetIsObjectValid(oTarget) &&
                      GetRacialType(oTarget) == RACIAL_TYPE_UNDEAD &&
                      (GetHitDice(oTarget) >= GetHitDice(OBJECT_SELF) - 1 ||
                       XAI_HPPercent(OBJECT_SELF) <= 50);
    if (nUndead < 2 && !bHardSingle) return FALSE;

    ClearAllActions();
    ActionUseFeat(FEAT_TURN_UNDEAD, OBJECT_SELF);
    SetLocalInt(OBJECT_SELF, "XAI_TURN_LAST_TICK_082", nTick);
    XAI_LockAction(2);
    XAI_SetLastAction("TURN_UNDEAD");
    return TRUE;
}

int XAI_TryParry082(object oTarget, int nEnemies)
{
    if (GetLocalInt(OBJECT_SELF, "XAI_PARRY_DISABLED_082")) return FALSE;
    if (GetSkillRank(SKILL_PARRY, OBJECT_SELF) <= 0) return FALSE;
    if (!GetIsObjectValid(oTarget)) return FALSE;

    int bNeed = XAI_HPPercent(OBJECT_SELF) <= 35 ||
                XAI_EnemyCountNear(GetLocation(OBJECT_SELF), 5.0) >= 3;
    if (!bNeed)
    {
        if (GetActionMode(OBJECT_SELF, ACTION_MODE_PARRY))
            SetActionMode(OBJECT_SELF, ACTION_MODE_PARRY, FALSE);
        return FALSE;
    }

    SetActionMode(OBJECT_SELF, ACTION_MODE_PARRY, TRUE);
    if (GetCurrentAction(OBJECT_SELF) != ACTION_ATTACKOBJECT)
        ActionAttack(oTarget);
    XAI_SetLastAction("AUTO_PARRY");
    return TRUE;
}

void main()
'@
  $tickText=Replace-Required $tickText $tickHead $tickHeadNew 'tick universal tactical helpers'

  $tickMainOpen=@'
void main()
{
'@
  $tickMainWatch=@'
void main()
{
    // 0.8.6.11 watchdog heartbeat. The universal attach scanner uses this only to
    // detect a dead independent self-tick; it does not change target/combat decisions.
    SetLocalInt(OBJECT_SELF, "XAI_TICK_SEEN_08611", TRUE);
'@
  $tickText=Replace-Required $tickText $tickMainOpen $tickMainWatch 'universal self-tick heartbeat'

  $oldCombatReturn=@'
    XAI_ReadLiveCommand();
    if(GetLocalInt(OBJECT_SELF,"AI_TURNED_OFF")||!bCombatState) return;
'@
  $newCombatReturn=@'
    XAI_ReadLiveCommand();

    // 0.8.6.6: stale legacy stop flags must never disable a companion already in AUTO.
    if (GetLocalInt(OBJECT_SELF, "XAI_AUTONOMOUS_MODE") &&
        !GetLocalInt(OBJECT_SELF, "XAI_FOLLOW_LOCK") &&
        !GetLocalInt(OBJECT_SELF, "XAI_WEAPON_ONLY_V0799"))
        DeleteLocalInt(OBJECT_SELF, "AI_TURNED_OFF");
    if(GetLocalInt(OBJECT_SELF,"AI_TURNED_OFF")) return;

    object oMaster08628 = GetLocalObject(OBJECT_SELF, "XAI_MASTER");
    if (!GetIsObjectValid(oMaster08628)) oMaster08628 = GetMaster(OBJECT_SELF);

    // 0.8.6.28: coordinated target commitment is AUTO-only. Manual WEAPON/FOLLOW
    // semantics stay untouched.
    if (GetLocalInt(OBJECT_SELF, "XAI_AUTONOMOUS_MODE") &&
        !GetLocalInt(OBJECT_SELF, "XAI_FOLLOW_LOCK") &&
        !GetLocalInt(OBJECT_SELF, "XAI_WEAPON_ONLY_V0799"))
    {
        object oCoordinated08628 = XAI_CoordinatedTarget08628(oTarget, oMaster08628, nTick);
        if (GetIsObjectValid(oCoordinated08628))
        {
            object oOldAttack08628 = GetAttackTarget(OBJECT_SELF);
            oTarget = oCoordinated08628;
            bCombatState = TRUE;

            // If the engine is already doing a plain attack against a different
            // target, hand that attack over immediately. Never interrupt casting,
            // healing or item use for this coordination rule.
            if (GetCurrentAction(OBJECT_SELF) == ACTION_ATTACKOBJECT &&
                GetIsObjectValid(oOldAttack08628) &&
                oOldAttack08628 != oCoordinated08628)
            {
                ClearAllActions();
                ActionAttack(oCoordinated08628);
                XAI_LockAction(1);
                XAI_SetLastAction("AUTO_ACQUIRE_TARGET");
                return;
            }
        }
    }

    // 0.8.6.6: universal companion target bootstrap.
    // This repairs the regression introduced when XAI stopped being Xanos-only:
    // a henchman can be in AUTO with a visible hostile but the legacy selector may
    // leave oTarget/bCombatState empty. Seed one real engine attack so subsequent
    // ticks and xai_combat inherit a valid GetAttackTarget().
    if ((!GetIsObjectValid(oTarget) || GetCurrentHitPoints(oTarget) <= 0) &&
        !GetLocalInt(OBJECT_SELF, "XAI_FOLLOW_LOCK"))
    {
        object oAcquire = XAI_AcquireVisibleEnemy0864();
        if (GetIsObjectValid(oAcquire))
        {
            oTarget = oAcquire;
            bCombatState = TRUE;
            XAI_SetStickyTarget08628(oAcquire, nTick);

            string sAcquireState = GetLocalString(OBJECT_SELF, XAI_LAST_ACTION_VAR);
            int bAcquirePrebuff = sAcquireState == "PREBUFF" || sAcquireState == "PREBUFF_FULL";

            // 0.8.6.10: acquisition means combat owns the queue NOW. Do not wait for
            // ACTION_INVALID: utility/follow/prebuff can otherwise keep Dorna idle while
            // the rest of the party is already fighting.
            ClearAllActions();
            XAI_LockAction(0);
            DeleteLocalInt(OBJECT_SELF, "XAI_PREBUFF_FULL");
            DeleteLocalInt(OBJECT_SELF, "XAI_PREBUFF_RESUME_GUARD_0865");
            SetLocalInt(OBJECT_SELF, "XAI_AUTONOMOUS_MODE", TRUE);
            DeleteLocalInt(OBJECT_SELF, "XAI_FOLLOW_LOCK");
            DeleteLocalInt(OBJECT_SELF, "XAI_WEAPON_ONLY_V0799");
            ActionAttack(oAcquire);
            XAI_SetLastAction("AUTO_ACQUIRE_TARGET");
            return;
        }
    }

    if(!bCombatState)
    {
        if (XAI_TryAutoHeal083(FALSE, nTick)) return;
        if (XAI_PostCombatHousekeeping08628(oMaster08628, nTick)) return;
        ExecuteScript("xai_utility", OBJECT_SELF);
        return;
    }

    SetLocalInt(OBJECT_SELF, "XAI_UTILITY_AFTER_COMBAT_082", TRUE);
    DeleteLocalInt(OBJECT_SELF, "XAI_UTILITY_IDLE_082");

    // Utility work is strictly out-of-combat. If a fight begins while a trap/lock
    // action is queued, combat cancels it before any other tactical decision.
    string sBeforeCombat = GetLocalString(OBJECT_SELF, "XAI_LAST_ACTION");
    if (sBeforeCombat == "DISARM_TRAP" || sBeforeCombat == "OPEN_LOCK")
    {
        ClearAllActions();
        XAI_LockAction(0);
        DeleteLocalInt(OBJECT_SELF, "XAI_UTILITY_COOLDOWN_082");
        XAI_SetLastAction("COMBAT_REPLAN");
        sBeforeCombat = "COMBAT_REPLAN";
    }

    // A prebuff queue is strictly out-of-combat. If a hostile appears, combat owns
    // the action queue immediately instead of waiting for every queued buff to finish.
    if (GetIsObjectValid(oTarget) &&
        (sBeforeCombat == "PREBUFF" || sBeforeCombat == "PREBUFF_FULL"))
    {
        ClearAllActions();
        XAI_LockAction(0);
        DeleteLocalInt(OBJECT_SELF, "XAI_PREBUFF_FULL");
        XAI_SetLastAction("COMBAT_REPLAN");
    }

    // Hard priority: healing/survival before Turn Undead, parry or attacks.
    if (XAI_TryAutoHeal083(TRUE, nTick)) return;

    // Do not chase a stale side target through the map. Supporting the master's own
    // current target gets a larger leash; other targets are abandoned sooner.
    if (XAI_ShouldRegroupCombat08628(oTarget, oMaster08628))
    {
        ClearAllActions();
        XAI_ClearStickyTarget08628();
        ActionMoveToObject(oMaster08628, TRUE, 4.0);
        XAI_LockAction(3);
        XAI_SetLastAction("AUTO_RETREAT_REGROUP");
        return;
    }

    if (XAI_TryTurnUndead082(oTarget, nTick)) return;
    if (XAI_TryParry082(oTarget, nEnemies)) return;

    // Hard recovery: a valid combat target plus an empty engine action queue must
    // never leave the companion standing still. Re-enter the proven planner first.
    // If the planner leaves the queue empty repeatedly, force one plain engine attack
    // as a last-resort recovery instead of looping in place forever.
    if (GetIsObjectValid(oTarget) && GetCurrentAction(OBJECT_SELF) == ACTION_INVALID)
    {
        int nIdle08628 = GetLocalInt(OBJECT_SELF, "XAI_COMBAT_IDLE_STREAK_08628") + 1;
        SetLocalInt(OBJECT_SELF, "XAI_COMBAT_IDLE_STREAK_08628", nIdle08628);

        if (nIdle08628 >= 3)
        {
            DeleteLocalInt(OBJECT_SELF, "XAI_COMBAT_IDLE_STREAK_08628");
            ClearAllActions();
            ActionAttack(oTarget);
            XAI_LockAction(1);
            XAI_SetLastAction("AUTO_ACQUIRE_TARGET");
            return;
        }

        ExecuteScript("xai_combat", OBJECT_SELF);
        return;
    }
    DeleteLocalInt(OBJECT_SELF, "XAI_COMBAT_IDLE_STREAK_08628");
'@
  $tickText=Replace-Required $tickText $oldCombatReturn $newCombatReturn 'out-of-combat utility and cleric/rogue priorities'

  $oldReplan=@'
    int nTargetAction=GetCurrentAction(oTarget);
    int bCasterCasting=XAI_IsCaster(oTarget) &&
        (nTargetAction==ACTION_CASTSPELL || nTargetAction==ACTION_ITEMCASTSPELL);
    int bEmergency=(XAI_HPPercent(OBJECT_SELF)<=25);

    // V0.7: do not tear up the action queue every 2 seconds.
    // Force a re-plan only on target changes, emergencies, or an enemy caster
    // actively starting a spell. Normal combat rounds keep flowing untouched.
    if(bTargetChanged || bEmergency || (bCasterCasting && (nTick%3)==0))
'@
  $newReplan=@'
    int nTargetAction=GetCurrentAction(oTarget);
    int bCasterCasting=XAI_IsCaster(oTarget) &&
        (nTargetAction==ACTION_CASTSPELL || nTargetAction==ACTION_ITEMCASTSPELL);
    int bEmergency=(XAI_HPPercent(OBJECT_SELF)<=25);

    // 0.8.6 watchdog: equipment switches and engine AI can occasionally eat the
    // queued ActionAttack. The old target remains valid and the panel keeps the
    // last planned action, so without this guard the companion can stand idle forever.
    // Action locks are checked above, so ACTION_INVALID here means it is safe to retry.
    int bCombatIdle=(GetCurrentAction(OBJECT_SELF)==ACTION_INVALID);

    // Keep normal combat rounds untouched, but re-plan a genuinely idle combatant.
    if(bTargetChanged || bEmergency || (bCasterCasting && (nTick%3)==0) ||
       (bCombatIdle && (nTick%2)==0))
'@
  $tickText=Replace-Required $tickText $oldReplan $newReplan 'combat idle watchdog'


  [IO.File]::WriteAllBytes($tickPath,$cp1251.GetBytes($tickText))
 }

 $prebuffPath=Join-Path $Src 'xai_prebuff.nss'
 if(Test-Path -LiteralPath $prebuffPath){
  $prebuffText=$cp1251.GetString([IO.File]::ReadAllBytes($prebuffPath))
  $prebuffText=$prebuffText.Replace('КСАНОС ИИ: обкаст отменён — рядом враг или уже идёт бой.','СПУТНИК ИИ: обкаст отменён — рядом враг или уже идёт бой.')
  $prebuffText=$prebuffText.Replace('КСАНОС ИИ: подходящих известных заклинаний для обкаста сейчас нет.','СПУТНИК ИИ: среди реально подготовленных/доступных заклинаний подходящих бафов сейчас нет.')
  $prebuffText=$prebuffText.Replace('КСАНОС ИИ: поставлено в очередь действий: ','СПУТНИК ИИ: поставлено в очередь бафов: ')
  $prebuffText=$prebuffText.Replace(' (полная подготовка).',' (полный обкаст).')
  $prebuffText=$prebuffText.Replace(' (обычный обкаст).',' (обычный обкаст).')
  [IO.File]::WriteAllBytes($prebuffPath,$cp1251.GetBytes($prebuffText))
 }


 $combatPath=Join-Path $Src 'xai_combat.nss'
 $combatText=$cp1251.GetString([IO.File]::ReadAllBytes($combatPath))
 $anchor=@'
    // Local crowd override: do not stand with a bow in melee.
'@
 $barrier=@'
    // V0.7.10.7: AUTO defaults on after load unless a real manual mode is active.
    if (!GetLocalInt(OBJECT_SELF, "XAI_AUTONOMOUS_MODE") &&
        !GetLocalInt(OBJECT_SELF, "XAI_FOLLOW_LOCK") &&
        !GetLocalInt(OBJECT_SELF, "XAI_WEAPON_ONLY_V0799"))
        SetLocalInt(OBJECT_SELF, "XAI_AUTONOMOUS_MODE", TRUE);

    // Remove only a shield that AUTO itself equipped for crowd survival once melee pressure drops.
    if (GetLocalInt(OBJECT_SELF, "XAI_CROWD_SHIELD_ACTIVE") && nCloseEnemies < 2)
    {
        object oCrowdShield = GetItemInSlot(INVENTORY_SLOT_LEFTHAND, OBJECT_SELF);
        DeleteLocalInt(OBJECT_SELF, "XAI_CROWD_SHIELD_ACTIVE");
        if (XAI_IsShieldItem(oCrowdShield) && XAI_TotalSpellUses() > 0)
        {
            ClearAllActions();
            XAI_LockAction(2);
            ActionUnequipItem(oCrowdShield);
            XAI_SetLastAction("AUTO_SHIELD_OFF");
            SetLocalInt(OBJECT_SELF, "X2_SPECIAL_COMBAT_AI_SCRIPT_OK", TRUE);
            return;
        }
    }

    // 0.8.6.33 strict trash gate: economy mode is intentionally conservative.
    // One low stat is not enough. Target must be >=2 HD behind AND <=50% of our max HP;
    // when CR is usable it must also be <=60% of our CR. Casters are never trash.
    // Qwen may suggest CONTROL, but it may not spend offensive spells/items/special ammo here.
    int bAutoWeakTarget =
        GetLocalInt(OBJECT_SELF, "XAI_AUTONOMOUS_MODE") &&
        GetIsObjectValid(oTarget) &&
        !XAI_IsCaster(oTarget) &&
        (GetHitDice(oTarget) <= GetHitDice(OBJECT_SELF) - 2 &&
         GetMaxHitPoints(oTarget) * 2 <= GetMaxHitPoints(OBJECT_SELF) &&
         ((GetChallengeRating(oTarget) <= 0.0 ||
           GetChallengeRating(OBJECT_SELF) <= 0.0) ||
          GetChallengeRating(oTarget) <= GetChallengeRating(OBJECT_SELF) * 0.60));

    if (bAutoWeakTarget)
    {
        // Self-defense is allowed. Offensive magic is not.
        if ((nCloseEnemies >= 3 || nXHP <= 35) && XAI_DefendSelf(nEnemies))
        {
            XAI_SetLastAction("AUTO_WEAK_DEFENSE");
            return;
        }

        object oTrash = oTarget;
        if (GetIsObjectValid(oCloseThreat) &&
            !XAI_IsCaster(oCloseThreat) &&
            (GetHitDice(oCloseThreat) <= GetHitDice(OBJECT_SELF) - 2 &&
             GetMaxHitPoints(oCloseThreat) * 2 <= GetMaxHitPoints(OBJECT_SELF) &&
             ((GetChallengeRating(oCloseThreat) <= 0.0 ||
               GetChallengeRating(OBJECT_SELF) <= 0.0) ||
              GetChallengeRating(oCloseThreat) <= GetChallengeRating(OBJECT_SELF) * 0.60)))
            oTrash = oCloseThreat;

        if (GetIsObjectValid(oCloseThreat) &&
            GetDistanceBetween(OBJECT_SELF, oCloseThreat) <= 4.5)
        {
            ClearAllActions();
            XAI_TacticalMeleeAttack(oCloseThreat);
            XAI_SetLastAction("AUTO_WEAK_MELEE");
            SetLocalInt(OBJECT_SELF, "X2_SPECIAL_COMBAT_AI_SCRIPT_OK", TRUE);
            return;
        }

        if (GetDistanceBetween(OBJECT_SELF, oTrash) > 5.5)
        {
            ClearAllActions();
            if (XAI_EquipBestRangedLoadout(oTrash))
            {
                XAI_LockAction(3);
                ActionAttack(oTrash);
                XAI_SetLastAction("AUTO_WEAK_RANGED");
                SetLocalInt(OBJECT_SELF, "X2_SPECIAL_COMBAT_AI_SCRIPT_OK", TRUE);
                return;
            }
        }

        XAI_TacticalMeleeAttack(oTrash);
        XAI_SetLastAction("AUTO_WEAK_MELEE");
        SetLocalInt(OBJECT_SELF, "X2_SPECIAL_COMBAT_AI_SCRIPT_OK", TRUE);
        return;
    }

    // Local crowd override: do not stand with a bow in melee.
'@
 $combatText=Replace-Required $combatText $anchor $barrier 'AUTO trash weapon barrier'

 $oldManual=@'
    if (GetLocalInt(OBJECT_SELF, XAI_WEAPON_ONLY_VAR))
    {
        object oForced = GetLocalObject(OBJECT_SELF, XAI_WEAPON_ONLY_TARGET_VAR);
        if (!GetIsObjectValid(oForced) || GetCurrentHitPoints(oForced) <= 0)
        {
            XAI_ClearWeaponOnly();
        }
        else
        {
            oTarget = oForced;
'@
 $newManual=@'
    if (GetLocalInt(OBJECT_SELF, XAI_WEAPON_ONLY_VAR))
    {
        object oForced = GetLocalObject(OBJECT_SELF, XAI_WEAPON_ONLY_TARGET_VAR);
        if (!GetIsObjectValid(oForced) || GetCurrentHitPoints(oForced) <= 0)
        {
            oForced = oTarget;
            if (GetIsObjectValid(oForced))
                SetLocalObject(OBJECT_SELF, XAI_WEAPON_ONLY_TARGET_VAR, oForced);
        }
        if (GetIsObjectValid(oForced))
        {
            oTarget = oForced;
'@
 $combatText=Replace-Required $combatText $oldManual $newManual 'persistent manual weapon mode'
 [IO.File]::WriteAllBytes($combatPath,$cp1251.GetBytes($combatText))
