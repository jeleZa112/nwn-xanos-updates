int XAI_TryAutoHeal083(int bCombat, int nTick)
{
    object oMaster = GetLocalObject(OBJECT_SELF, "XAI_MASTER");
    if (!GetIsObjectValid(oMaster)) oMaster = GetMaster(OBJECT_SELF);

    int nSelfHP = XAI_HPPercent(OBJECT_SELF);
    int nMasterHP = 100;
    if (GetIsObjectValid(oMaster) && GetIsPC(oMaster))
        nMasterHP = XAI_HPPercent(oMaster);

    object oHeal = OBJECT_INVALID;

    if (bCombat)
    {
        // In combat: survival first, but do not burn every slot on small scratches.
        if (nSelfHP <= 60)
            oHeal = OBJECT_SELF;
        else if (GetIsObjectValid(oMaster) && nMasterHP <= 45 &&
                 GetDistanceBetween(OBJECT_SELF, oMaster) <= 15.0)
            oHeal = oMaster;
    }
    else
    {
        // After combat: patch meaningful wounds before traps/locks/stealth work.
        if (nSelfHP <= 75)
            oHeal = OBJECT_SELF;

        if (GetIsObjectValid(oMaster) && nMasterHP <= 75 &&
            GetDistanceBetween(OBJECT_SELF, oMaster) <= 15.0 &&
            (!GetIsObjectValid(oHeal) || nMasterHP < nSelfHP))
            oHeal = oMaster;
    }

    if (!GetIsObjectValid(oHeal)) return FALSE;

    // Do not tear up an already committed heal/cast/use-item action.
    int a = GetCurrentAction(OBJECT_SELF);
    if (a == ACTION_CASTSPELL || a == ACTION_ITEMCASTSPELL ||
        a == ACTION_HEAL || a == ACTION_USEOBJECT)
        return TRUE;

    int nLast = GetLocalInt(OBJECT_SELF, "XAI_HEAL_LAST_TICK_083");
    if (nLast > 0 && nTick - nLast < 4) return FALSE;

    // Native NWN talent layer knows cleric cures (including spontaneous cleric healing)
    // and other available healing magic.
    if (TalentHeal(TRUE, oHeal))
    {
        SetLocalInt(OBJECT_SELF, "XAI_HEAL_LAST_TICK_083", nTick);
        XAI_LockAction(3);
        if (oHeal == OBJECT_SELF) XAI_SetLastAction("AUTO_HEAL_SELF");
        else XAI_SetLastAction("AUTO_HEAL_MASTER");
        return TRUE;
    }

    // Fallback: use a healer's kit if one is actually in inventory.
    object oItem = GetFirstItemInInventory(OBJECT_SELF);
    while (GetIsObjectValid(oItem))
    {
        if (GetStringLeft(GetResRef(oItem), 12) == "nw_it_medkit")
        {
            ClearAllActions();
            ActionUseItemOnObject(oItem, GetFirstItemProperty(oItem), oHeal);
            SetLocalInt(OBJECT_SELF, "XAI_HEAL_LAST_TICK_083", nTick);
            XAI_LockAction(3);
            if (oHeal == OBJECT_SELF) XAI_SetLastAction("AUTO_HEAL_SELF");
            else XAI_SetLastAction("AUTO_HEAL_MASTER");
            return TRUE;
        }
        oItem = GetNextItemInInventory(OBJECT_SELF);
    }

    // No resource available: do not rescan every second forever.
    SetLocalInt(OBJECT_SELF, "XAI_HEAL_LAST_TICK_083", nTick + 6);
    return FALSE;
}

int XAI_AcquireTargetValid08610(object o)
{
    if (!GetIsObjectValid(o) || GetObjectType(o) != OBJECT_TYPE_CREATURE) return FALSE;
    if (GetCurrentHitPoints(o) <= 0 || GetIsDead(o)) return FALSE;
    if (GetArea(o) != GetArea(OBJECT_SELF)) return FALSE;
    if (!GetIsEnemy(o, OBJECT_SELF)) return FALSE;
    if (GetDistanceBetween(OBJECT_SELF, o) > 40.0) return FALSE;
    return TRUE;
}

object XAI_AcquireVisibleEnemy0864()
{
    // First use Dorna's own engine combat state, including the creature that just hit her.
    object o = GetAttackTarget(OBJECT_SELF);
    if (XAI_AcquireTargetValid08610(o)) return o;

    o = GetLastAttacker(OBJECT_SELF);
    if (XAI_AcquireTargetValid08610(o)) return o;

    object oMaster = GetLocalObject(OBJECT_SELF, "XAI_MASTER");
    if (!GetIsObjectValid(oMaster)) oMaster = GetMaster(OBJECT_SELF);

    if (GetIsObjectValid(oMaster))
    {
        o = GetAttackTarget(oMaster);
        if (XAI_AcquireTargetValid08610(o)) return o;

        o = GetLastAttacker(oMaster);
        if (XAI_AcquireTargetValid08610(o)) return o;

        // Universal companions must join PARTY combat. 0.8.6.9 could stand idle while
        // Plada/Bain Kai fought because neither Dorna nor the master had a momentary
        // GetAttackTarget(). Adopt a nearby faction member's target/attacker.
        object oParty = GetFirstFactionMember(oMaster, FALSE);
        while (GetIsObjectValid(oParty))
        {
            if (oParty != OBJECT_SELF)
            {
                o = GetAttackTarget(oParty);
                if (XAI_AcquireTargetValid08610(o)) return o;

                o = GetLastAttacker(oParty);
                if (XAI_AcquireTargetValid08610(o)) return o;
            }
            oParty = GetNextFactionMember(oMaster, FALSE);
        }
    }

    // Last fallback remains direct perception.
    o = GetNearestCreature(CREATURE_TYPE_REPUTATION, REPUTATION_TYPE_ENEMY,
                           OBJECT_SELF, 1,
                           CREATURE_TYPE_PERCEPTION, PERCEPTION_SEEN,
                           CREATURE_TYPE_IS_ALIVE, TRUE);
    if (XAI_AcquireTargetValid08610(o)) return o;

    return OBJECT_INVALID;
}

int XAI_TickUndeadCount(float fRadius)
{
    int n = 0;
    object o = GetFirstObjectInShape(SHAPE_SPHERE, fRadius, GetLocation(OBJECT_SELF), TRUE, OBJECT_TYPE_CREATURE);
    while (GetIsObjectValid(o))
    {
        if (o != OBJECT_SELF && GetCurrentHitPoints(o) > 0 &&
            GetIsEnemy(o, OBJECT_SELF) && GetRacialType(o) == RACIAL_TYPE_UNDEAD)
            n++;
        o = GetNextObjectInShape(SHAPE_SPHERE, fRadius, GetLocation(OBJECT_SELF), TRUE, OBJECT_TYPE_CREATURE);
    }
    return n;
}

int XAI_TryTurnUndead082(object oTarget, int nTick)
{
    if (!GetHasFeat(FEAT_TURN_UNDEAD, OBJECT_SELF, TRUE)) return FALSE;
    if (GetFeatRemainingUses(FEAT_TURN_UNDEAD, OBJECT_SELF) <= 0) return FALSE;
    int nLast = GetLocalInt(OBJECT_SELF, "XAI_TURN_LAST_TICK_082");
    if (nLast > 0 && nTick - nLast < 8) return FALSE;

    int nUndead = XAI_TickUndeadCount(12.0);
    int bHardSingle = GetIsObjectValid(oTarget) &&
                      GetRacialType(oTarget) == RACIAL_TYPE_UNDEAD &&
                      (GetHitDice(oTarget) >= GetHitDice(OBJECT_SELF) - 1 ||
                       XAI_HPPercent(OBJECT_SELF) <= 50);
    if (nUndead < 2 && !bHardSingle) return FALSE;

    ClearAllActions();
    ActionUseFeat(FEAT_TURN_UNDEAD, OBJECT_SELF);
    SetLocalInt(OBJECT_SELF, "XAI_TURN_LAST_TICK_082", nTick);
    XAI_LockAction(2);
    XAI_SetLastAction("TURN_UNDEAD");
    return TRUE;
}

int XAI_TryParry082(object oTarget, int nEnemies)
{
    if (GetLocalInt(OBJECT_SELF, "XAI_PARRY_DISABLED_082")) return FALSE;
    if (GetSkillRank(SKILL_PARRY, OBJECT_SELF) <= 0) return FALSE;
    if (!GetIsObjectValid(oTarget)) return FALSE;

    int bNeed = XAI_HPPercent(OBJECT_SELF) <= 35 ||
                XAI_EnemyCountNear(GetLocation(OBJECT_SELF), 5.0) >= 3;
    if (!bNeed)
    {
        if (GetActionMode(OBJECT_SELF, ACTION_MODE_PARRY))
            SetActionMode(OBJECT_SELF, ACTION_MODE_PARRY, FALSE);
        return FALSE;
    }

    SetActionMode(OBJECT_SELF, ACTION_MODE_PARRY, TRUE);
    if (GetCurrentAction(OBJECT_SELF) != ACTION_ATTACKOBJECT)
        ActionAttack(oTarget);
    XAI_SetLastAction("AUTO_PARRY");
    return TRUE;
}

