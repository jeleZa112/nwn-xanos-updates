@echo off
setlocal
set "XANOS_SELF=%~f0"
powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "$c=[IO.File]::ReadAllText($env:XANOS_SELF);$m='###POWERSHELL_PAYLOAD###';$i=$c.LastIndexOf($m);if($i -lt 0){exit 99};Invoke-Expression $c.Substring($i+$m.Length)"
set "RC=%ERRORLEVEL%"
if not "%RC%"=="0" (echo. & echo FAILED - error %RC%)
exit /b %RC%
###POWERSHELL_PAYLOAD###
$ErrorActionPreference='Stop'
[Console]::OutputEncoding=[Text.Encoding]::UTF8
$OutputEncoding=[Text.Encoding]::UTF8
Write-Host 'XANOS ALL-IN-ONE V0.7.11.15.16 EQUIPMENT LIVE SCAN + PRC FAMILIAR FIX1' -ForegroundColor Cyan
Write-Host 'Combat core: V0.7.10.7 / NUI: canonical PRC/NWN panel / fresh window ID / live-runtime open' -ForegroundColor DarkCyan

if(Get-Process -Name nwmain -ErrorAction SilentlyContinue){throw 'NWN is running. Close the game once, then run this ONE file again.'}
$stateFile=Join-Path $env:LOCALAPPDATA 'NWN_EPC_RU_PRC\userdir.txt'
$NwnHome=Join-Path $env:USERPROFILE 'Documents\Neverwinter Nights'
if(Test-Path -LiteralPath $stateFile){$s=(Get-Content -LiteralPath $stateFile -Raw).Trim();if($s){$NwnHome=$s}}
$SupportDir=Join-Path $NwnHome 'EPC_RU_PRC'
$DevDir=Join-Path $NwnHome 'development'
$Compiler=Join-Path $SupportDir 'tools\nwnsc.exe'
if(!(Test-Path -LiteralPath $Compiler)){throw 'Existing Xanos support/compiler was not found in Documents\Neverwinter Nights\EPC_RU_PRC.'}
New-Item -ItemType Directory -Force -Path $DevDir|Out-Null

function Find-NwnInstall{
 foreach($p in @('C:\Program Files (x86)\Steam\steamapps\common\Neverwinter Nights','C:\Program Files\Steam\steamapps\common\Neverwinter Nights')){if(Test-Path (Join-Path $p 'bin')){return $p}}
 foreach($rk in @('HKLM:\SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall\Steam App 704450','HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\Steam App 704450')){try{$p=(Get-ItemProperty -LiteralPath $rk -ErrorAction Stop).InstallLocation;if($p -and (Test-Path (Join-Path $p 'bin'))){return $p}}catch{}}
 throw 'Steam Neverwinter Nights install folder was not found.'
}
$NwnInstall=Find-NwnInstall
$Src=Join-Path $SupportDir 'oneclick_v071114_src'
$Build=Join-Path $SupportDir 'build_xai_v071114'
$Backup=Join-Path $SupportDir ('backup_xai_v071114_'+(Get-Date -Format 'yyyyMMdd_HHmmss'))
$Log=Join-Path $SupportDir 'XANOS_AI_V071114_COMPILE.log'
New-Item -ItemType Directory -Force -Path $Src,$Build,$Backup|Out-Null
Get-ChildItem $Build -File -ErrorAction SilentlyContinue|Remove-Item -Force
# PRC familiar compatibility repair sources (separate from Xanos AI).
[IO.File]::WriteAllBytes((Join-Path $Src 'prc_ai_fam_percp.nss'),[Convert]::FromBase64String(''))
[IO.File]::WriteAllBytes((Join-Path $Src 'prc_pnp_fam_hide.nss'),[Convert]::FromBase64String(''))
[IO.File]::WriteAllBytes((Join-Path $Src 'nw_inc_nui.nss'),[Convert]::FromBase64String(''))
[IO.File]::WriteAllBytes((Join-Path $Src 'xai_nui_common.nss'),[Convert]::FromBase64String(''))
[IO.File]::WriteAllBytes((Join-Path $Src 'xai_nui_boot.nss'),[Convert]::FromBase64String(''))
[IO.File]::WriteAllBytes((Join-Path $Src 'xai_nui_event.nss'),[Convert]::FromBase64String(''))
[IO.File]::WriteAllBytes((Join-Path $Src 'xai_nui_tick.nss'),[Convert]::FromBase64String(''))
[IO.File]::WriteAllBytes((Join-Path $Src 'xai_playercmd.nss'),[Convert]::FromBase64String(''))
[IO.File]::WriteAllBytes((Join-Path $Src 'xai_init.nss'),[Convert]::FromBase64String(''))
[IO.File]::WriteAllBytes((Join-Path $Src 'evn_modgui.nss'),[Convert]::FromBase64String(''))

# NWN/nwnsc in the user's RU setup expects legacy CP1251 source bytes.
# Embedded sources above are UTF-8; convert only Cyrillic-bearing NSS files before compile.
$cp1251=[Text.Encoding]::GetEncoding(1251)
foreach($n in @('xai_nui_common.nss','xai_nui_boot.nss','xai_nui_event.nss','xai_nui_tick.nss','xai_playercmd.nss')){
 $p=Join-Path $Src $n
 if(Test-Path -LiteralPath $p){
  $txt=[Text.Encoding]::UTF8.GetString([IO.File]::ReadAllBytes($p))
  [IO.File]::WriteAllBytes($p,$cp1251.GetBytes($txt))
 }
}

# Combat V0.7.10.3 compile-safe hotfix is derived locally from the already-installed, known-good V0.7.10.2 sources.
# Deliberately tiny delta: AUTO trash weapon barrier + mundane-ammo preference only.
$baseXai=$null
foreach($d in @((Join-Path $SupportDir 'source_xai_v07102_cp1251'),(Join-Path $SupportDir 'source_xai_v07110_cp1251'))){
 if((Test-Path -LiteralPath (Join-Path $d 'xai_core.nss')) -and
    (Test-Path -LiteralPath (Join-Path $d 'xai_combat.nss'))){$baseXai=$d;break}
}
$core=$null
if($baseXai){
 Copy-Item -LiteralPath (Join-Path $baseXai 'xai_core.nss') -Destination (Join-Path $Src 'xai_core.nss') -Force
 Copy-Item -LiteralPath (Join-Path $baseXai 'xai_combat.nss') -Destination (Join-Path $Src 'xai_combat.nss') -Force
 $core=Join-Path $Src 'xai_core.nss'

 function Replace-Required([string]$Text,[string]$Old,[string]$New,[string]$Label){
  if(-not $Text.Contains($Old)){throw ('Combat patch anchor not found: '+$Label)}
  return $Text.Replace($Old,$New)
 }

 $coreText=$cp1251.GetString([IO.File]::ReadAllBytes($core))
 $oldAmmo=@'
    nScore += XAI_ItemPropertyMaxValue(oAmmo, ITEM_PROPERTY_ENHANCEMENT_BONUS) * 36;
    nScore += XAI_ItemPropertyMaxValue(oAmmo, ITEM_PROPERTY_ATTACK_BONUS) * 30;
    nScore += XAI_DamageBonusRank(oAmmo) * 18;
'@
 $newAmmo=@'
    nScore += XAI_ItemPropertyMaxValue(oAmmo, ITEM_PROPERTY_ENHANCEMENT_BONUS) * 36;
    nScore += XAI_ItemPropertyMaxValue(oAmmo, ITEM_PROPERTY_ATTACK_BONUS) * 30;
    nScore += XAI_DamageBonusRank(oAmmo) * 18;

    // AUTO conservation: obvious low-HD non-casters use mundane compatible ammo first.
    if (GetLocalInt(OBJECT_SELF, "XAI_AUTONOMOUS_MODE") &&
        GetIsObjectValid(oTarget) &&
        !XAI_IsCaster(oTarget) &&
        ((GetChallengeRating(oTarget) > 0.0 &&
          GetChallengeRating(OBJECT_SELF) > 0.0 &&
          GetChallengeRating(oTarget) <= GetChallengeRating(OBJECT_SELF) * 0.75) ||
         GetHitDice(oTarget) <= GetHitDice(OBJECT_SELF) - 1 ||
         GetMaxHitPoints(oTarget) * 2 <= GetMaxHitPoints(OBJECT_SELF)) &&
        XAI_DamageBonusRank(oAmmo) > 0)
        nScore -= 500;
'@
 $coreText=Replace-Required $coreText $oldAmmo $newAmmo 'AUTO mundane ammo preference'

 $oldShieldGuard=@'
    // Arcane spell failure from shields is not worth it while useful spell slots remain.
    if (XAI_TotalSpellUses() > 0) return FALSE;
'@
 $newShieldGuard=@'
    // Normally avoid arcane spell failure while useful spell slots remain.
    // Exception: 3+ enemies already in melee means survival wins after defensive self-buffs.
    int nCloseShieldThreats = XAI_EnemyCountNear(GetLocation(OBJECT_SELF), 5.0);
    if (XAI_TotalSpellUses() > 0 && nCloseShieldThreats < 3) return FALSE;
'@
 $coreText=Replace-Required $coreText $oldShieldGuard $newShieldGuard 'crowd shield spell-slot exception'

 $oldShieldEquip=@'
        ActionEquipItem(oBest, INVENTORY_SLOT_LEFTHAND);
        object oMaster = GetLocalObject(OBJECT_SELF, "XAI_MASTER");
'@
 $newShieldEquip=@'
        ActionEquipItem(oBest, INVENTORY_SLOT_LEFTHAND);
        if (nCloseShieldThreats >= 3)
            SetLocalInt(OBJECT_SELF, "XAI_CROWD_SHIELD_ACTIVE", TRUE);
        object oMaster = GetLocalObject(OBJECT_SELF, "XAI_MASTER");
'@
 $coreText=Replace-Required $coreText $oldShieldEquip $newShieldEquip 'crowd shield tracking'
 [IO.File]::WriteAllBytes($core,$cp1251.GetBytes($coreText))

 $combatPath=Join-Path $Src 'xai_combat.nss'
 $combatText=$cp1251.GetString([IO.File]::ReadAllBytes($combatPath))
 $anchor=@'
    // Local crowd override: do not stand with a bow in melee.
'@
 $barrier=@'
    // V0.7.10.7: AUTO defaults on after load unless a real manual mode is active.
    if (!GetLocalInt(OBJECT_SELF, "XAI_AUTONOMOUS_MODE") &&
        !GetLocalInt(OBJECT_SELF, "XAI_FOLLOW_LOCK") &&
        !GetLocalInt(OBJECT_SELF, "XAI_WEAPON_ONLY_V0799"))
        SetLocalInt(OBJECT_SELF, "XAI_AUTONOMOUS_MODE", TRUE);

    // Remove only a shield that AUTO itself equipped for crowd survival once melee pressure drops.
    if (GetLocalInt(OBJECT_SELF, "XAI_CROWD_SHIELD_ACTIVE") && nCloseEnemies < 2)
    {
        object oCrowdShield = GetItemInSlot(INVENTORY_SLOT_LEFTHAND, OBJECT_SELF);
        DeleteLocalInt(OBJECT_SELF, "XAI_CROWD_SHIELD_ACTIVE");
        if (XAI_IsShieldItem(oCrowdShield) && XAI_TotalSpellUses() > 0)
        {
            ClearAllActions();
            XAI_LockAction(2);
            ActionUnequipItem(oCrowdShield);
            XAI_SetLastAction("AUTO_SHIELD_OFF");
            SetLocalInt(OBJECT_SELF, "X2_SPECIAL_COMBAT_AI_SCRIPT_OK", TRUE);
            return;
        }
    }

    // Hard economy gate for genuinely Easy/weak non-casters.
    // Qwen may suggest CONTROL, but it may not spend offensive spells/items/special ammo here.
    int bAutoWeakTarget =
        GetLocalInt(OBJECT_SELF, "XAI_AUTONOMOUS_MODE") &&
        GetIsObjectValid(oTarget) &&
        !XAI_IsCaster(oTarget) &&
        ((GetChallengeRating(oTarget) > 0.0 &&
          GetChallengeRating(OBJECT_SELF) > 0.0 &&
          GetChallengeRating(oTarget) <= GetChallengeRating(OBJECT_SELF) * 0.75) ||
         GetHitDice(oTarget) <= GetHitDice(OBJECT_SELF) - 1 ||
         GetMaxHitPoints(oTarget) * 2 <= GetMaxHitPoints(OBJECT_SELF));

    if (bAutoWeakTarget)
    {
        // Self-defense is allowed. Offensive magic is not.
        if ((nCloseEnemies >= 3 || nXHP <= 35) && XAI_DefendSelf(nEnemies))
        {
            XAI_SetLastAction("AUTO_WEAK_DEFENSE");
            return;
        }

        object oTrash = oTarget;
        if (GetIsObjectValid(oCloseThreat) &&
            !XAI_IsCaster(oCloseThreat) &&
            ((GetChallengeRating(oCloseThreat) > 0.0 &&
              GetChallengeRating(OBJECT_SELF) > 0.0 &&
              GetChallengeRating(oCloseThreat) <= GetChallengeRating(OBJECT_SELF) * 0.75) ||
             GetHitDice(oCloseThreat) <= GetHitDice(OBJECT_SELF) - 1 ||
             GetMaxHitPoints(oCloseThreat) * 2 <= GetMaxHitPoints(OBJECT_SELF)))
            oTrash = oCloseThreat;

        if (GetIsObjectValid(oCloseThreat) &&
            GetDistanceBetween(OBJECT_SELF, oCloseThreat) <= 4.5)
        {
            ClearAllActions();
            XAI_TacticalMeleeAttack(oCloseThreat);
            XAI_SetLastAction("AUTO_WEAK_MELEE");
            SetLocalInt(OBJECT_SELF, "X2_SPECIAL_COMBAT_AI_SCRIPT_OK", TRUE);
            return;
        }

        if (GetDistanceBetween(OBJECT_SELF, oTrash) > 5.5)
        {
            ClearAllActions();
            if (XAI_EquipBestRangedLoadout(oTrash))
            {
                XAI_LockAction(3);
                ActionAttack(oTrash);
                XAI_SetLastAction("AUTO_WEAK_RANGED");
                SetLocalInt(OBJECT_SELF, "X2_SPECIAL_COMBAT_AI_SCRIPT_OK", TRUE);
                return;
            }
        }

        XAI_TacticalMeleeAttack(oTrash);
        XAI_SetLastAction("AUTO_WEAK_MELEE");
        SetLocalInt(OBJECT_SELF, "X2_SPECIAL_COMBAT_AI_SCRIPT_OK", TRUE);
        return;
    }

    // Local crowd override: do not stand with a bow in melee.
'@
 $combatText=Replace-Required $combatText $anchor $barrier 'AUTO trash weapon barrier'

 $oldManual=@'
    if (GetLocalInt(OBJECT_SELF, XAI_WEAPON_ONLY_VAR))
    {
        object oForced = GetLocalObject(OBJECT_SELF, XAI_WEAPON_ONLY_TARGET_VAR);
        if (!GetIsObjectValid(oForced) || GetCurrentHitPoints(oForced) <= 0)
        {
            XAI_ClearWeaponOnly();
        }
        else
        {
            oTarget = oForced;
'@
 $newManual=@'
    if (GetLocalInt(OBJECT_SELF, XAI_WEAPON_ONLY_VAR))
    {
        object oForced = GetLocalObject(OBJECT_SELF, XAI_WEAPON_ONLY_TARGET_VAR);
        if (!GetIsObjectValid(oForced) || GetCurrentHitPoints(oForced) <= 0)
        {
            oForced = oTarget;
            if (GetIsObjectValid(oForced))
                SetLocalObject(OBJECT_SELF, XAI_WEAPON_ONLY_TARGET_VAR, oForced);
        }
        if (GetIsObjectValid(oForced))
        {
            oTarget = oForced;
'@
 $combatText=Replace-Required $combatText $oldManual $newManual 'persistent manual weapon mode'
 [IO.File]::WriteAllBytes($combatPath,$cp1251.GetBytes($combatText))
}else{
 Write-Host '[warn] V0.7.10.2 source set not found; combat hotfix will not be installed.' -ForegroundColor Yellow
}

Set-Content -LiteralPath $Log -Value ('XANOS ALL-IN-ONE V0.7.11.15.16 EQUIPMENT LIVE SCAN + PRC FAMILIAR FIX1 '+(Get-Date)) -Encoding UTF8
function Compile([string]$name){
 Write-Host ('[compile] '+$name) -ForegroundColor DarkCyan
 $source=Join-Path $Src $name
 $out=& $Compiler @('-n',$NwnInstall,'-h',$NwnHome,'-i',$Src,'-b',$Build,'-o','-w',$source) 2>&1
 if($out){$out|ForEach-Object{Add-Content -LiteralPath $Log -Value ([string]$_)}}
 if($LASTEXITCODE -ne 0){throw ('Compile failed: '+$name+' . Log: '+$Log)}
 $ncs=Join-Path $Build (([IO.Path]::GetFileNameWithoutExtension($name))+'.ncs')
 if(!(Test-Path $ncs)){throw ('Compiler did not create '+$ncs)}
 return $ncs
}
$built=@{}
$built['xai_nui_boot.ncs']=Compile 'xai_nui_boot.nss'
$built['xai_nui_event.ncs']=Compile 'xai_nui_event.nss'
$built['xai_nui_tick.ncs']=Compile 'xai_nui_tick.nss'
$built['evn_modgui.ncs']=Compile 'evn_modgui.nss'
# PRC familiar repair: compile completely before anything is copied.
$built['prc_ai_fam_percp.ncs']=Compile 'prc_ai_fam_percp.nss'
$built['prc_pnp_fam_hide.ncs']=Compile 'prc_pnp_fam_hide.nss'
if($core){
 $built['xai_combat.ncs']=Compile 'xai_combat.nss'
}else{Write-Host '[warn] xai_core source not found; keeping the already-installed combat scripts.' -ForegroundColor Yellow}

# Atomic-ish install: only copy after every requested compile succeeded.
foreach($n in $built.Keys){$dst=Join-Path $DevDir $n;if(Test-Path $dst){Copy-Item $dst (Join-Path $Backup ($n+'.bak')) -Force};Copy-Item $built[$n] $dst -Force}
Set-Content -LiteralPath (Join-Path $SupportDir 'XANOS_VERSION.txt') -Value 'V0.7.11.15.16 EQUIPMENT LIVE SCAN ALL-IN-ONE + NUI OPEN BIND FIX + V0.7.10.7 COMBAT CORE RU' -Encoding UTF8
Write-Host '[OK] NUI V0.7.11.15.16 installed; combat V0.7.10.7 unchanged; PRC familiar repair FIX1 installed.' -ForegroundColor Green

# Restart only our local AI/panel processes, never the game.
try{Get-CimInstance Win32_Process|Where-Object{$_.Name -match '^(powershell|pwsh)(\.exe)?$' -and $_.CommandLine -and ($_.CommandLine.Contains('START_XANOS_LOCAL_AI.ps1') -or $_.CommandLine.Contains('XANOS_CONTROL_PANEL.ps1'))}|ForEach-Object{try{Stop-Process -Id $_.ProcessId -Force -ErrorAction Stop}catch{}}}catch{}
Start-Sleep -Milliseconds 500
$ai=Join-Path $SupportDir 'START_XANOS_LOCAL_AI.ps1'
if(!(Test-Path $ai)){throw 'START_XANOS_LOCAL_AI.ps1 is missing from the installed Xanos support folder.'}
Start-Process powershell.exe -ArgumentList @('-NoProfile','-ExecutionPolicy','Bypass','-File',('"'+$ai+'"'))|Out-Null
Write-Host '[OK] LOCAL Qwen AI + external control panel started.' -ForegroundColor Green

# Start the EPC/PRC-safe game watcher. Generate it from this one-click file so the user never has to find another launcher.
$watcher=Join-Path $SupportDir 'XANOS_ONECLICK_GAME_WATCHER.ps1'
[IO.File]::WriteAllBytes($watcher,[Convert]::FromBase64String(''))
$env:XANOS_NWN_HOME=$NwnHome
Start-Process powershell.exe -ArgumentList @('-NoProfile','-ExecutionPolicy','Bypass','-File',('"'+$watcher+'"'))|Out-Null
Write-Host '[OK] EPC/PRC watcher started and Steam NWN launch requested.' -ForegroundColor Green
Write-Host ''
Write-Host 'V0.7.11.15.15 INSTALLED. maneuver capability scan + unchanged 0.7.10.7 combat. mode + compact Russian panel.' -ForegroundColor Cyan
Start-Sleep -Seconds 3
