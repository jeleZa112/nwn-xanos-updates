@echo off
setlocal
set "XANOS_SELF=%~f0"
powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "$c=[IO.File]::ReadAllText($env:XANOS_SELF);$m='###POWERSHELL_PAYLOAD###';$i=$c.LastIndexOf($m);if($i -lt 0){exit 99};Invoke-Expression $c.Substring($i+$m.Length)"
set "RC=%ERRORLEVEL%"
if not "%RC%"=="0" (echo. & echo FAILED - error %RC%)
exit /b %RC%
###POWERSHELL_PAYLOAD###
$ErrorActionPreference='Stop'
[Console]::OutputEncoding=[Text.Encoding]::UTF8
$OutputEncoding=[Text.Encoding]::UTF8
Write-Host 'XANOS ALL-IN-ONE V0.7.11.14 SIDE PANEL' -ForegroundColor Cyan
Write-Host 'Combat core: V0.7.10.2 / NUI: canonical PRC/NWN panel / fresh window ID / live-runtime open' -ForegroundColor DarkCyan

if(Get-Process -Name nwmain -ErrorAction SilentlyContinue){throw 'NWN is running. Close the game once, then run this ONE file again.'}
$stateFile=Join-Path $env:LOCALAPPDATA 'NWN_EPC_RU_PRC\userdir.txt'
$NwnHome=Join-Path $env:USERPROFILE 'Documents\Neverwinter Nights'
if(Test-Path -LiteralPath $stateFile){$s=(Get-Content -LiteralPath $stateFile -Raw).Trim();if($s){$NwnHome=$s}}
$SupportDir=Join-Path $NwnHome 'EPC_RU_PRC'
$DevDir=Join-Path $NwnHome 'development'
$Compiler=Join-Path $SupportDir 'tools\nwnsc.exe'
if(!(Test-Path -LiteralPath $Compiler)){throw 'Existing Xanos support/compiler was not found in Documents\Neverwinter Nights\EPC_RU_PRC.'}
New-Item -ItemType Directory -Force -Path $DevDir|Out-Null

function Find-NwnInstall{
 foreach($p in @('C:\Program Files (x86)\Steam\steamapps\common\Neverwinter Nights','C:\Program Files\Steam\steamapps\common\Neverwinter Nights')){if(Test-Path (Join-Path $p 'bin')){return $p}}
 foreach($rk in @('HKLM:\SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall\Steam App 704450','HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\Steam App 704450')){try{$p=(Get-ItemProperty -LiteralPath $rk -ErrorAction Stop).InstallLocation;if($p -and (Test-Path (Join-Path $p 'bin'))){return $p}}catch{}}
 throw 'Steam Neverwinter Nights install folder was not found.'
}
$NwnInstall=Find-NwnInstall
$Src=Join-Path $SupportDir 'oneclick_v071114_src'
$Build=Join-Path $SupportDir 'build_xai_v071114'
$Backup=Join-Path $SupportDir ('backup_xai_v071114_'+(Get-Date -Format 'yyyyMMdd_HHmmss'))
$Log=Join-Path $SupportDir 'XANOS_AI_V071114_COMPILE.log'
New-Item -ItemType Directory -Force -Path $Src,$Build,$Backup|Out-Null
Get-ChildItem $Build -File -ErrorAction SilentlyContinue|Remove-Item -Force
[IO.File]::WriteAllBytes((Join-Path $Src 'nw_inc_nui.nss'),[Convert]::FromBase64String(''))
[IO.File]::WriteAllBytes((Join-Path $Src 'xai_nui_boot.nss'),[Convert]::FromBase64String(''))
[IO.File]::WriteAllBytes((Join-Path $Src 'xai_nui_event.nss'),[Convert]::FromBase64String(''))
[IO.File]::WriteAllBytes((Join-Path $Src 'xai_init.nss'),[Convert]::FromBase64String(''))
[IO.File]::WriteAllBytes((Join-Path $Src 'evn_modgui.nss'),[Convert]::FromBase64String(''))

# Reuse the already-installed, protected V0.7.10.2 xai_core source only for compiling the boot-enabled xai_init wrapper.
$core=$null
foreach($p in @((Join-Path $SupportDir 'source_xai_v07102_cp1251\xai_core.nss'),(Join-Path $SupportDir 'source_xai_v07110_cp1251\xai_core.nss'))){if(Test-Path -LiteralPath $p){$core=$p;break}}
if($core){Copy-Item -LiteralPath $core -Destination (Join-Path $Src 'xai_core.nss') -Force}

Set-Content -LiteralPath $Log -Value ('XANOS ALL-IN-ONE V0.7.11.14 SIDE PANEL '+(Get-Date)) -Encoding UTF8
function Compile([string]$name){
 Write-Host ('[compile] '+$name) -ForegroundColor DarkCyan
 $source=Join-Path $Src $name
 $out=& $Compiler @('-n',$NwnInstall,'-h',$NwnHome,'-i',$Src,'-b',$Build,'-o','-w',$source) 2>&1
 if($out){$out|ForEach-Object{Add-Content -LiteralPath $Log -Value ([string]$_)}}
 if($LASTEXITCODE -ne 0){throw ('Compile failed: '+$name+' . Log: '+$Log)}
 $ncs=Join-Path $Build (([IO.Path]::GetFileNameWithoutExtension($name))+'.ncs')
 if(!(Test-Path $ncs)){throw ('Compiler did not create '+$ncs)}
 return $ncs
}
$built=@{}
$built['xai_nui_boot.ncs']=Compile 'xai_nui_boot.nss'
$built['xai_nui_event.ncs']=Compile 'xai_nui_event.nss'
$built['evn_modgui.ncs']=Compile 'evn_modgui.nss'
if($core){$built['xai_init.ncs']=Compile 'xai_init.nss'}else{Write-Host '[warn] xai_core source not found; keeping the already-installed boot-enabled xai_init.ncs.' -ForegroundColor Yellow}

# Atomic-ish install: only copy after every requested compile succeeded.
foreach($n in $built.Keys){$dst=Join-Path $DevDir $n;if(Test-Path $dst){Copy-Item $dst (Join-Path $Backup ($n+'.bak')) -Force};Copy-Item $built[$n] $dst -Force}
Set-Content -LiteralPath (Join-Path $SupportDir 'XANOS_VERSION.txt') -Value 'V0.7.11.14 SIDE PANEL ALL-IN-ONE + NUI OPEN BIND FIX + V0.7.10.2 COMBAT CORE RU' -Encoding UTF8
Write-Host '[OK] NUI V0.7.11.14 SIDE PANEL installed. V0.7.10.2 combat scripts were not replaced.' -ForegroundColor Green

# Restart only our local AI/panel processes, never the game.
try{Get-CimInstance Win32_Process|Where-Object{$_.Name -match '^(powershell|pwsh)(\.exe)?$' -and $_.CommandLine -and ($_.CommandLine.Contains('START_XANOS_LOCAL_AI.ps1') -or $_.CommandLine.Contains('XANOS_CONTROL_PANEL.ps1'))}|ForEach-Object{try{Stop-Process -Id $_.ProcessId -Force -ErrorAction Stop}catch{}}}catch{}
Start-Sleep -Milliseconds 500
$ai=Join-Path $SupportDir 'START_XANOS_LOCAL_AI.ps1'
if(!(Test-Path $ai)){throw 'START_XANOS_LOCAL_AI.ps1 is missing from the installed Xanos support folder.'}
Start-Process powershell.exe -ArgumentList @('-NoProfile','-ExecutionPolicy','Bypass','-File',('"'+$ai+'"'))|Out-Null
Write-Host '[OK] LOCAL Qwen AI + external control panel started.' -ForegroundColor Green

# Start the EPC/PRC-safe game watcher. Generate it from this one-click file so the user never has to find another launcher.
$watcher=Join-Path $SupportDir 'XANOS_ONECLICK_GAME_WATCHER.ps1'
[IO.File]::WriteAllBytes($watcher,[Convert]::FromBase64String(''))
$env:XANOS_NWN_HOME=$NwnHome
Start-Process powershell.exe -ArgumentList @('-NoProfile','-ExecutionPolicy','Bypass','-File',('"'+$watcher+'"'))|Out-Null
Write-Host '[OK] EPC/PRC watcher started and Steam NWN launch requested.' -ForegroundColor Green
Write-Host ''
Write-Host 'CANONICAL PANEL INSTALLED. Load the save. Wait 5 seconds or select Xanos. Look for XANOS side panel.' -ForegroundColor Cyan
Start-Sleep -Seconds 3
