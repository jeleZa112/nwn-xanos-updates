 $oldPrebuff=@'
int XAI_PreBuffSelf(int bFull)
{
    // This is deliberately an out-of-combat command. Rage and active combat are left alone.
    object oAtk = GetAttackTarget(OBJECT_SELF);
    if (GetIsObjectValid(oAtk)) return -1;

    int nEnemies = XAI_EnemyCountNear(GetLocation(OBJECT_SELF), 18.0);
    if (nEnemies > 0) return -1;

    ClearAllActions();
    if (GetActionMode(OBJECT_SELF, ACTION_MODE_STEALTH))
        SetActionMode(OBJECT_SELF, ACTION_MODE_STEALTH, FALSE);

    int n = 0;

    // Long/medium duration core buffs first.
    if (XAI_QueueSelfBuff(SPELL_MAGE_ARMOR)) n++;
    if (XAI_QueueSelfBuff(SPELL_BULLS_STRENGTH)) n++;
    if (XAI_QueueSelfBuff(SPELL_CATS_GRACE)) n++;
    if (XAI_QueueSelfBuff(SPELL_EAGLE_SPLEDOR)) n++;
    if (XAI_QueueSelfBuff(SPELL_SHIELD)) n++;

    if (bFull)
    {
        if (XAI_QueueSelfBuff(SPELL_ENDURANCE)) n++;
        if (XAI_QueueSelfBuff(SPELL_GHOSTLY_VISAGE)) n++;
        if (XAI_QueueSelfBuff(SPELL_STONESKIN)) n++;
        if (XAI_QueueSelfBuff(SPELL_IMPROVED_INVISIBILITY)) n++;
    }

    // Shorter combat buffs go last so less duration is wasted before contact.
    if (XAI_QueueSelfBuff(SPELL_HASTE)) n++;
    if (bFull && XAI_QueueSelfBuff(SPELL_DISPLACEMENT)) n++;

    // Full boss prep also brings persistent allies if available. These actions are appended
    // after buffs so they do not erase the casting queue.
    if (bFull && !GetIsObjectValid(GetAssociate(ASSOCIATE_TYPE_FAMILIAR, OBJECT_SELF, 1)))
        if (XAI_TryFamiliar()) n++;
    if (bFull && !GetIsObjectValid(GetAssociate(ASSOCIATE_TYPE_SUMMONED, OBJECT_SELF, 1)))
        if (XAI_TrySummonBest(OBJECT_INVALID)) n++;

    SetLocalString(OBJECT_SELF, XAI_LAST_ACTION_VAR, bFull ? "PREBUFF_FULL" : "PREBUFF");
    return n;
}
