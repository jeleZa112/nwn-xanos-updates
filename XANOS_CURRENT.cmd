int XAI_IsOffhandWeaponCandidate(object oItem, object oTarget)
{
    if (!GetIsObjectValid(oItem)) return FALSE;
    if (oItem == GetItemInSlot(INVENTORY_SLOT_RIGHTHAND, OBJECT_SELF)) return FALSE;
    if (XAI_IsShieldItem(oItem)) return FALSE;
    if (XAI_IsRangedWeaponItem(oItem)) return FALSE;
    int nBase = GetBaseItemType(oItem);
    if (XAI_IsTwoHandedBase(nBase)) return FALSE;
    return XAI_WeaponScore(oItem, oTarget) > -90000;
}

object XAI_BestOffhandWeapon(object oTarget)
{
    object oBest = OBJECT_INVALID;
    int nBest = -100000;

    object oLeft = GetItemInSlot(INVENTORY_SLOT_LEFTHAND, OBJECT_SELF);
    if (XAI_IsOffhandWeaponCandidate(oLeft, oTarget))
    {
        oBest = oLeft;
        nBest = XAI_WeaponScore(oLeft, oTarget);
    }

    object o = GetFirstItemInInventory(OBJECT_SELF);
    while (GetIsObjectValid(o))
    {
        if (XAI_IsOffhandWeaponCandidate(o, oTarget))
        {
            int n = XAI_WeaponScore(o, oTarget);
            if (n > nBest)
            {
                nBest = n;
                oBest = o;
            }
        }
        o = GetNextItemInInventory(OBJECT_SELF);
    }
    return oBest;
}

int XAI_EquipOffhandIfUseful(object oTarget)
{
    if (!GetHasFeat(FEAT_TWO_WEAPON_FIGHTING, OBJECT_SELF) &&
        !GetHasFeat(FEAT_AMBIDEXTERITY, OBJECT_SELF))
    {
        SetLocalString(OBJECT_SELF, "XAI_OFFHAND_REASON_08612", "НЕТ ТАЛАНТА");
        return FALSE;
    }

    object oRight = GetItemInSlot(INVENTORY_SLOT_RIGHTHAND, OBJECT_SELF);
    if (!GetIsObjectValid(oRight))
    {
        SetLocalString(OBJECT_SELF, "XAI_OFFHAND_REASON_08612", "НЕТ ОРУЖИЯ В ПРАВОЙ РУКЕ");
        return FALSE;
    }
    if (XAI_IsRangedWeaponItem(oRight))
    {
        SetLocalString(OBJECT_SELF, "XAI_OFFHAND_REASON_08612", "ОСНОВНОЕ ОРУЖИЕ ДАЛЬНЕЕ");
        return FALSE;
    }
    if (XAI_IsTwoHandedBase(GetBaseItemType(oRight)))
    {
        SetLocalString(OBJECT_SELF, "XAI_OFFHAND_REASON_08612", "ОСНОВНОЕ ОРУЖИЕ ДВУРУЧНОЕ");
        return FALSE;
    }

    int nClose = XAI_EnemyCountNear(GetLocation(OBJECT_SELF), 5.0);
    if (nClose >= 3)
    {
        SetLocalString(OBJECT_SELF, "XAI_OFFHAND_REASON_08612", "ОПАСНО: ВРАГОВ РЯДОМ " + IntToString(nClose));
        return FALSE;
    }
    if (XAI_HPPercent(OBJECT_SELF) <= 40)
    {
        SetLocalString(OBJECT_SELF, "XAI_OFFHAND_REASON_08612", "ОПАСНО: HP <= 40%");
        return FALSE;
    }

    object oBest = XAI_BestOffhandWeapon(oTarget);
    if (!GetIsObjectValid(oBest))
    {
        SetLocalString(OBJECT_SELF, "XAI_OFFHAND_REASON_08612", "НЕТ ПОДХОДЯЩЕГО ВТОРОГО ОРУЖИЯ");
        return FALSE;
    }

    object oLeft = GetItemInSlot(INVENTORY_SLOT_LEFTHAND, OBJECT_SELF);
    if (oLeft == oBest)
    {
        SetLocalString(OBJECT_SELF, "XAI_OFFHAND_REASON_08612", "УЖЕ НАДЕТО: " + GetName(oBest));
        return FALSE;
    }

    int nTick = GetLocalInt(OBJECT_SELF, XAI_SMART_TICK_VAR);
    int nLast = GetLocalInt(OBJECT_SELF, "XAI_OFFHAND_ATTEMPT_TICK_085");
    if (nTick - nLast < 6)
    {
        SetLocalString(OBJECT_SELF, "XAI_OFFHAND_REASON_08612", "ЖДЁТ ПОВТОРА: " + IntToString(6 - (nTick - nLast)));
        return FALSE;
    }

    SetLocalString(OBJECT_SELF, "XAI_OFFHAND_REASON_08612", "НАДЕВАЕТ: " + GetName(oBest));
    SetLocalInt(OBJECT_SELF, "XAI_OFFHAND_ATTEMPT_TICK_085", nTick);
    XAI_LockAction(3);
    if (GetIsObjectValid(oLeft)) ActionUnequipItem(oLeft);
    ActionEquipItem(oBest, INVENTORY_SLOT_LEFTHAND);
    SetLocalInt(OBJECT_SELF, "XAI_AUTO_OFFHAND_085", TRUE);
    XAI_SetLastAction("AUTO_DUAL_WIELD");
    return TRUE;
}

