{
    int nClass = XAI_GetSpellcastingClass();
    if (nClass == CLASS_TYPE_INVALID) return 0;
    int nCount = GetKnownSpellCount(OBJECT_SELF, nClass, nLevel);
    if (nCount <= 0) return 0;
    int nFirst = GetKnownSpellId(OBJECT_SELF, nClass, nLevel, 0);
