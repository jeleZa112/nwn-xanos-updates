 $newSpellUses=@'
int XAI_SpellLevelUsesLeft(int nLevel)
{
    int nClass = XAI_GetSpellcastingClass();
    if (nClass == CLASS_TYPE_INVALID) return 0;

    if (nClass == CLASS_TYPE_WIZARD || nClass == CLASS_TYPE_CLERIC ||
        nClass == CLASS_TYPE_DRUID || nClass == CLASS_TYPE_PALADIN ||
        nClass == CLASS_TYPE_RANGER)
    {
        int nSlots = GetMemorizedSpellCountByLevel(OBJECT_SELF, nClass, nLevel);
        int nReady = 0;
        int i;
        for (i = 0; i < nSlots; i++)
            if (GetMemorizedSpellId(OBJECT_SELF, nClass, nLevel, i) >= 0 &&
                GetMemorizedSpellReady(OBJECT_SELF, nClass, nLevel, i) == TRUE)
                nReady++;
        return nReady;
    }

    int nCount = GetKnownSpellCount(OBJECT_SELF, nClass, nLevel);
    if (nCount <= 0) return 0;
    int nFirst = GetKnownSpellId(OBJECT_SELF, nClass, nLevel, 0);
    if (nFirst < 0) return 0;
    return GetSpellUsesLeft(OBJECT_SELF, nClass, nFirst);
}
